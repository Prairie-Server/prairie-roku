namespace tests
    @suite("Prairie.Credentials")
    class CredentialsSuite extends rooibos.BaseTestSuite

        @describe("storage")
        @it("keeps the refresh token and username per server")
        sub _()
            store = Prairie.Store.createMemoryStore()
            m.assertInvalid(Prairie.Credentials.forServer(store, "https://a.example"))
            m.assertTrue(Prairie.Credentials.remember(store, "https://a.example/", " rt1 ", "jo"))
            m.assertTrue(Prairie.Credentials.remember(store, "https://b.example", "rt2", "al"))
            saved = Prairie.Credentials.forServer(store, "https://a.example")
            m.assertEqual(saved.refreshToken, "rt1")
            m.assertEqual(saved.username, "jo")
            m.assertEqual(Prairie.Credentials.forServer(store, "https://b.example").refreshToken, "rt2")
            raw = store.getItem(Prairie.Credentials.storageKey()) as string
            m.assertEqual(raw.instr("password"), -1)
        end sub

        @it("forgets one server and leaves the others")
        sub _()
            store = Prairie.Store.createMemoryStore()
            Prairie.Credentials.remember(store, "https://a.example", "rt1", "jo")
            Prairie.Credentials.remember(store, "https://b.example", "rt2", "al")
            m.assertTrue(Prairie.Credentials.forget(store, "https://a.example"))
            m.assertInvalid(Prairie.Credentials.forServer(store, "https://a.example"))
            m.assertNotInvalid(Prairie.Credentials.forServer(store, "https://b.example"))
            m.assertTrue(Prairie.Credentials.forget(store, "https://missing.example"))
            m.assertTrue(Prairie.Credentials.forget(store, ""))
        end sub

        @it("clears instead of saving a blank token")
        sub _()
            store = Prairie.Store.createMemoryStore()
            Prairie.Credentials.remember(store, "https://a.example", "rt1", "jo")
            m.assertTrue(Prairie.Credentials.remember(store, "https://a.example", invalid, "jo"))
            m.assertInvalid(Prairie.Credentials.forServer(store, "https://a.example"))
            Prairie.Credentials.remember(store, "https://a.example", "rt1", "jo")
            m.assertTrue(Prairie.Credentials.remember(store, "https://a.example", "  ", "jo"))
            m.assertInvalid(Prairie.Credentials.forServer(store, "https://a.example"))
            m.assertFalse(Prairie.Credentials.remember(store, "", "rt", "jo"))
            m.assertInvalid(Prairie.Credentials.forServer(store, ""))
        end sub

        @it("reports a failed write")
        sub _()
            store = Prairie.Store.createMemoryStore()
            store.failWrites = true
            m.assertFalse(Prairie.Credentials.remember(store, "https://a.example", "rt1", "jo"))
        end sub

        @it("ignores corrupt or partial data")
        sub _()
            store = Prairie.Store.createMemoryStore()
            store.setItem(Prairie.Credentials.storageKey(), "not json")
            m.assertInvalid(Prairie.Credentials.forServer(store, "https://a.example"))
            store.setItem(Prairie.Credentials.storageKey(), "[]")
            m.assertEqual(Prairie.Credentials.loadAll(store).count(), 0)
            store.setItem(Prairie.Credentials.storageKey(), " ")
            m.assertEqual(Prairie.Credentials.loadAll(store).count(), 0)
            id = Prairie.ServerRegistry.entryIdFromUrl("https://a.example")
            servers = {}
            servers[id] = { refreshToken: "   " }
            Prairie.Credentials.saveAll(servers, store)
            m.assertInvalid(Prairie.Credentials.forServer(store, "https://a.example"))
            servers[id] = { username: "jo" }
            Prairie.Credentials.saveAll(servers, store)
            m.assertInvalid(Prairie.Credentials.forServer(store, "https://a.example"))
            servers[id] = { refreshToken: "rt" }
            Prairie.Credentials.saveAll(servers, store)
            m.assertEqual(Prairie.Credentials.forServer(store, "https://a.example").username, "")
        end sub

        @describe("refresh")
        @it("builds the request body and parses the rotated tokens")
        sub _()
            m.assertEqual(Prairie.Credentials.refreshPath(), "/api/v1/auth/refresh")
            body = ParseJson(Prairie.Credentials.buildRefreshBody("rt1"))
            m.assertEqual(body.refresh_token, "rt1")
            parsed = Prairie.Credentials.parseRefresh({ access_token: "at", refresh_token: "rt2", expires_in: 900 })
            m.assertTrue(parsed.ok)
            m.assertEqual(parsed.accessToken, "at")
            m.assertEqual(parsed.refreshToken, "rt2")
            m.assertEqual(Prairie.Credentials.parseRefresh({ access_token: "at" }).refreshToken, "")
            m.assertFalse(Prairie.Credentials.parseRefresh({ access_token: " " }).ok)
            m.assertFalse(Prairie.Credentials.parseRefresh({}).ok)
            m.assertFalse(Prairie.Credentials.parseRefresh(invalid).ok)
            m.assertFalse(Prairie.Credentials.parseRefresh("x").ok)
        end sub

        @it("treats auth rejections as signed out and the rest as retryable")
        sub _()
            m.assertTrue(Prairie.Credentials.isSessionRejected(401))
            m.assertTrue(Prairie.Credentials.isSessionRejected(400))
            m.assertTrue(Prairie.Credentials.isSessionRejected(403))
            m.assertFalse(Prairie.Credentials.isSessionRejected(0))
            m.assertFalse(Prairie.Credentials.isSessionRejected(503))
            m.assertEqual(Prairie.Credentials.resumeFailedMessage("Den", true), "You were signed out of Den. Sign in again.")
            m.assertEqual(Prairie.Credentials.resumeFailedMessage(" ", false), "Can't reach this server. Check this TV's connection.")
        end sub

    end class
end namespace
