namespace Prairie.Theme

    ' Prairie Dusk palette — keep in sync with prairie-smarttv styles.
    function colors() as object
        return {
            bg: "0x141820FF",
            bgElevated: "0x1C2430FF",
            bgSoft: "0x222B38FF",
            amber: "0xE0A84AFF",
            amberDeep: "0xC48C2EFF",
            ink: "0xF3EFE6FF",
            muted: "0x9AA3B2FF",
            danger: "0xE07070FF",
            ring: "0xF0C574FF"
        }
    end function

    function brandName() as string
        return "Prairie"
    end function

    ' Value for X-Prairie-Device-Platform.
    '
    ' Server deviceclass.tvPlatforms currently maps smarttv|tizen|webos|androidtv|tvos
    ' → TV artwork (w200 posters). "roku" is not in that set yet — coordinate a
    ' server-side addition so catalog-minted URLs are TV-sized without client rewrite.
    ' Until then Artwork.preferred auto-rewrites Prairie-signed /poster/ and /logo/
    ' URLs to w200 (revision-scoped signatures still validate).
    function devicePlatformHeader() as string
        return "roku"
    end function

    function deviceNameHeader() as string
        return "Prairie Roku"
    end function

end namespace
