namespace tests
    @suite("Prairie.PlaybackSettings")
    class PlaybackSettingsSuite extends rooibos.BaseTestSuite

        private store as object

        protected override sub beforeEach()
            m.store = Prairie.Store.createMemoryStore()
        end sub

        @describe("normalize")
        @it("applies defaults and clears conflicting force flags")
        sub _()
            defaults = Prairie.PlaybackSettings.normalize(invalid)
            m.assertFalse(defaults.forceDirectPlay)
            m.assertFalse(defaults.forceTranscode)
            m.assertEqual(defaults.preferredSubtitleLanguage, "")
            m.assertEqual(defaults.preferredQuality, "auto")
            settings = Prairie.PlaybackSettings.normalize({
                forceDirectPlay: true,
                forceTranscode: true,
                preferredSubtitleLanguage: " ENG ",
                preferredQuality: "1080p-high"
            })
            m.assertTrue(settings.forceDirectPlay)
            m.assertFalse(settings.forceTranscode)
            m.assertEqual(settings.preferredSubtitleLanguage, "eng")
            m.assertEqual(settings.preferredQuality, "1080p-high")
        end sub

        @it("resolves forced play method")
        sub _()
            m.assertEqual(Prairie.PlaybackSettings.resolveForcedPlayMethod({
                forceDirectPlay: true,
                forceTranscode: false
            }), "direct")
            m.assertEqual(Prairie.PlaybackSettings.resolveForcedPlayMethod({
                forceDirectPlay: false,
                forceTranscode: true
            }), "transcode")
            m.assertInvalid(Prairie.PlaybackSettings.resolveForcedPlayMethod({
                forceDirectPlay: false,
                forceTranscode: false
            }))
        end sub

        @describe("persistence")
        @it("round-trips settings through the store")
        sub _()
            saved = Prairie.PlaybackSettings.save({
                forceTranscode: true,
                preferredSubtitleLanguage: "spa",
                preferredQuality: "720p"
            }, m.store)
            m.assertTrue(saved.forceTranscode)
            loaded = Prairie.PlaybackSettings.load(m.store)
            m.assertTrue(loaded.forceTranscode)
            m.assertEqual(loaded.preferredSubtitleLanguage, "spa")
            m.assertEqual(loaded.preferredQuality, "720p")
        end sub

        @it("returns defaults when unset")
        sub _()
            loaded = Prairie.PlaybackSettings.load(m.store)
            m.assertFalse(loaded.forceDirectPlay)
            m.assertFalse(loaded.forceTranscode)
            m.assertEqual(loaded.preferredSubtitleLanguage, "")
            m.assertEqual(loaded.preferredQuality, "auto")
        end sub

    end class
end namespace
