namespace tests
    @suite("Prairie.Auth")
    class AuthSuite extends rooibos.BaseTestSuite

        @describe("paths and bodies")
        @it("builds login and verify-pin payloads")
        sub _()
            m.assertEqual(Prairie.Auth.loginPath(), "/api/v1/auth/login")
            m.assertEqual(Prairie.Auth.setupStatusPath(), "/api/v1/auth/setup")
            validNeeds = Prairie.Auth.parseSetupStatus({ needs_setup: true })
            m.assertTrue(validNeeds.ok)
            m.assertTrue(validNeeds.needsSetup)
            validReady = Prairie.Auth.parseSetupStatus({ needs_setup: false })
            m.assertTrue(validReady.ok)
            m.assertFalse(validReady.needsSetup)
            m.assertFalse(Prairie.Auth.parseSetupStatus(invalid).ok)
            m.assertFalse(Prairie.Auth.parseSetupStatus({}).ok)
            m.assertFalse(Prairie.Auth.parseSetupStatus({ needs_setup: "yes" }).ok)
            m.assertTrue(Prairie.Auth.needsSetupFromResponse({ needs_setup: true }))
            m.assertFalse(Prairie.Auth.needsSetupFromResponse({ needs_setup: false }))
            m.assertFalse(Prairie.Auth.needsSetupFromResponse(invalid))
            body = ParseJson(Prairie.Auth.buildLoginBody("ada", "secret"))
            m.assertEqual(body.username, "ada")
            m.assertEqual(body.password, "secret")
            pinBody = ParseJson(Prairie.Auth.buildVerifyPinBody("1234"))
            m.assertEqual(pinBody.pin, "1234")
            m.assertTrue(Prairie.Auth.verifyPinPath("p 1").instr("p%201") >= 0)
            m.assertEqual(Prairie.Auth.profilesPath(), "/api/v1/profiles")
            m.assertEqual(Prairie.Auth.deviceStartPath(), "/api/v1/auth/device/start")
            m.assertEqual(Prairie.Auth.devicePollPath(), "/api/v1/auth/device/poll")
            startBody = ParseJson(Prairie.Auth.buildDeviceStartBody("Prairie Roku", "roku"))
            m.assertEqual(startBody.device_name, "Prairie Roku")
            m.assertEqual(startBody.device_platform, "roku")
            pollBody = ParseJson(Prairie.Auth.buildDevicePollBody("secret-code"))
            m.assertEqual(pollBody.device_code, "secret-code")
            badStart = Prairie.Auth.parseDeviceStart({})
            m.assertFalse(badStart.ok)
            m.assertFalse(Prairie.Auth.parseDeviceStart(invalid).ok)
            m.assertFalse(Prairie.Auth.parseDeviceStart({ device_code: "", user_code: "ABCD-EFGH" }).ok)
            m.assertFalse(Prairie.Auth.parseDeviceStart({ device_code: "dev", user_code: "  " }).ok)
            goodStart = Prairie.Auth.parseDeviceStart({
                device_code: "dev",
                user_code: "ABCD-EFGH",
                match_code: "amber harbor",
                interval: 4
            })
            m.assertTrue(goodStart.ok)
            m.assertEqual(goodStart.userCode, "ABCD-EFGH")
            m.assertEqual(goodStart.matchCode, "amber harbor")
            m.assertEqual(goodStart.interval, 4)
            clampedStart = Prairie.Auth.parseDeviceStart({
                device_code: "dev",
                user_code: "ABCD-EFGH",
                interval: 0
            })
            m.assertTrue(clampedStart.ok)
            m.assertEqual(clampedStart.interval, 3)
            m.assertEqual(clampedStart.matchCode, "")
            pendingPoll = Prairie.Auth.parseDevicePoll({ status: "pending", poll_after: 2 })
            m.assertTrue(pendingPoll.ok)
            m.assertEqual(pendingPoll.status, "pending")
            m.assertEqual(pendingPoll.pollAfter, 2)
            m.assertFalse(Prairie.Auth.parseDevicePoll(invalid).ok)
            m.assertFalse(Prairie.Auth.parseDevicePoll({}).ok)
            clampedPoll = Prairie.Auth.parseDevicePoll({ status: "Approved", poll_after: 0, access_token: "tok", user: { username: "ada" } })
            m.assertTrue(clampedPoll.ok)
            m.assertEqual(clampedPoll.status, "approved")
            m.assertEqual(clampedPoll.pollAfter, 3)
            m.assertEqual(clampedPoll.accessToken, "tok")
        end sub

        @describe("profiles")
        @it("picks primary profile then falls back to first")
        sub _()
            m.assertInvalid(Prairie.Auth.pickDefaultProfile([]))
            primary = Prairie.Auth.pickDefaultProfile([
                { id: "a", is_primary: false },
                { id: "b", is_primary: true }
            ])
            m.assertEqual(primary.id, "b")
            first = Prairie.Auth.pickDefaultProfile([
                { id: "a", is_primary: false }
            ])
            m.assertEqual(first.id, "a")
        end sub

        @it("reads profiles array from response objects")
        sub _()
            list = Prairie.Auth.profilesFromResponse({
                profiles: [{ id: "1" }]
            })
            m.assertEqual(list.count(), 1)
            m.assertEqual(Prairie.Auth.profilesFromResponse(invalid).count(), 0)
            m.assertEqual(Prairie.Auth.profilesFromResponse([]).count(), 0)
            m.assertEqual(Prairie.Auth.profilesFromResponse({ profiles: "nope" }).count(), 0)
        end sub

    end class
end namespace

