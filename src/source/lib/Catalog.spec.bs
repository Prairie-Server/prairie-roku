namespace tests
    @suite("Prairie.Catalog")
    class CatalogSuite extends rooibos.BaseTestSuite

        @describe("buildCatalogPath")
        @it("returns bare path without query")
        sub _()
            m.assertEqual(Prairie.Catalog.buildCatalogPath({}), "/api/v2/catalog/query")
        end sub

        @it("encodes query parameters")
        sub _()
            path = Prairie.Catalog.buildCatalogPath({
                libraryId: 3,
                q: "star wars",
                offset: 10,
                limit: 25,
                sort: "title",
                order: "asc"
            })
            m.assertTrue(path.instr("/api/v2/catalog/query?") = 0)
            m.assertTrue(path.instr("library_id=3") >= 0)
            m.assertTrue(path.instr("q=star%20wars") >= 0)
            m.assertTrue(path.instr("seek=10") >= 0)
            m.assertTrue(path.instr("limit=25") >= 0)
        end sub

        @describe("detail paths")
        @it("encodes seasons and episodes path segments")
        sub _()
            seasons = Prairie.Catalog.seasonsPath("show/1")
            m.assertTrue(seasons.instr("/api/v1/catalog/series/") = 0)
            m.assertTrue(seasons.instr("show%2F1") >= 0)
            m.assertTrue(seasons.right(8) = "/seasons")
            episodes = Prairie.Catalog.episodesPath("show/1", 2)
            m.assertTrue(episodes.instr("show%2F1") >= 0)
            m.assertTrue(episodes.instr("/seasons/2/episodes") >= 0)
            m.assertTrue(Prairie.Catalog.itemDetailPath("id/1").instr("id%2F1") >= 0)
        end sub

        @describe("response helpers")
        @it("normalizes items/seasons/episodes shapes")
        sub _()
            m.assertEqual(Prairie.Catalog.itemsFromResponse({ items: [1, 2] }).count(), 2)
            m.assertEqual(Prairie.Catalog.seasonsFromResponse({ seasons: [1] }).count(), 1)
            m.assertEqual(Prairie.Catalog.seasonsFromResponse([1, 2]).count(), 2)
            m.assertEqual(Prairie.Catalog.episodesFromResponse({ episodes: [1] }).count(), 1)
            m.assertEqual(Prairie.Catalog.itemsFromResponse("nope").count(), 0)
        end sub

        @it("builds a catalog page with pagination metadata")
        sub _()
            page = Prairie.Catalog.pageFromResponse({
                items: [{ content_id: "1" }],
                has_more: true,
                snapshot: "snap",
                total: 12
            })
            m.assertEqual(page.items.count(), 1)
            m.assertTrue(page.has_more)
            m.assertEqual(page.snapshot, "snap")
            m.assertEqual(page.total, 12)
            empty = Prairie.Catalog.pageFromResponse(invalid)
            m.assertEqual(empty.items.count(), 0)
            m.assertFalse(empty.has_more)
        end sub
        @it("builds a POST body for search and cursor pagination")
        sub _()
            request = Prairie.Catalog.buildCatalogRequest({
                q: "star wars",
                source: "query",
                offset: 48,
                limit: 48,
                snapshot: "cursor-1"
            }, {
                serverUrl: "https://prairie.example"
            })
            m.assertEqual(request.method, "POST")
            m.assertEqual(request.url, "https://prairie.example/api/v2/catalog/query")
            body = ParseJson(request.body)
            m.assertEqual(body.q, "star wars")
            m.assertEqual(body.source, "query")
            m.assertEqual(body.seek, 48)
            m.assertEqual(body.limit, 48)
            m.assertEqual(body.cursor, "cursor-1")
        end sub

        @it("normalizes v2 page metadata")
        sub _()
            page = Prairie.Catalog.pageFromResponse({
                items: [{ content_id: "1" }],
                window_cursor: "cursor-2",
                page: { has_more: true },
                total: 100
            })
            m.assertTrue(page.has_more)
            m.assertEqual(page.snapshot, "cursor-2")
            m.assertEqual(page.total, 100)
        end sub

        @describe("formatCommunityRating")
        @it("formats average to one decimal with count")
        sub _()
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: 4.2, count: 7 }), "4.2/5 · 7 ratings")
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: 4, count: 1 }), "4.0/5 · 1 rating")
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: 3.96, count: 12 }), "4.0/5 · 12 ratings")
        end sub

        @it("returns empty for absent or invalid ratings")
        sub _()
            m.assertEqual(Prairie.Catalog.formatCommunityRating(invalid), "")
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: "4.2", count: 7 }), "")
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: 4.2 }), "")
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: 0, count: 7 }), "")
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: 4.2, count: 0 }), "")
            m.assertEqual(Prairie.Catalog.formatCommunityRating({ average: 4.2, count: 1.9 }), "")
        end sub
        @describe("user rating helpers")
        @it("normalizes and formats user_rating")
        sub _()
            m.assertEqual(Prairie.Catalog.normalizeUserRating(4), 4)
            m.assertEqual(Prairie.Catalog.normalizeUserRating(invalid), 0)
            m.assertEqual(Prairie.Catalog.normalizeUserRating(6), 0)
            m.assertEqual(Prairie.Catalog.normalizeUserRating(2.5), 0)
            m.assertEqual(Prairie.Catalog.normalizeUserRating("3"), 0)
            m.assertEqual(Prairie.Catalog.formatUserRating(4), "★ Rated 4/5")
            m.assertEqual(Prairie.Catalog.formatUserRating(0), "☆ Rate")
        end sub

        @it("maps dialog indexes to ratings")
        sub _()
            m.assertEqual(Prairie.Catalog.ratingDialogButtons().count(), 6)
            m.assertEqual(Prairie.Catalog.ratingFromDialogIndex(0), 5)
            m.assertEqual(Prairie.Catalog.ratingFromDialogIndex(4), 1)
            m.assertEqual(Prairie.Catalog.ratingFromDialogIndex(5), 0)
            m.assertEqual(Prairie.Catalog.ratingFromDialogIndex(6), -1)
        end sub

        @it("builds PUT and DELETE rating requests")
        sub _()
            options = { serverUrl: "http://srv", accessToken: "t" }
            put = Prairie.Catalog.buildRatingRequest(options, "movie:heat 1995", 4)
            m.assertEqual(put.method, "PUT")
            m.assertEqual(put.path, "/api/v2/ratings/movie%3Aheat%201995")
            m.assertEqual(ParseJson(put.body).rating, 4)
            del = Prairie.Catalog.buildRatingRequest(options, "movie:heat 1995", 0)
            m.assertEqual(del.method, "DELETE")
            m.assertEqual(del.path, "/api/v2/ratings/movie%3Aheat%201995")
            m.assertInvalid(del.body)
        end sub
    end class
end namespace


