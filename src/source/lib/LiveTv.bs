import "pkg:/source/lib/UrlUtils.bs"

namespace Prairie.LiveTv

    function channelsPath() as string
        return "/api/v2/livetv/channels"
    end function

    ' v2 repeats channel_id once per channel (server cap: 500).
    function guidePath(channelIds as object) as string
        params = []
        for each channelId in channelIds
            if params.count() >= 500
                exit for
            end if
            params.push("channel_id=" + (channelId as string).encodeUriComponent())
        end for
        path = "/api/v2/livetv/guide?" + params.join("&")
        nowSec = nowSeconds()
        startIso = secondsToIso(nowSec)
        endIso = secondsToIso(nowSec + 6 * 3600)
        if startIso.len() > 0 and endIso.len() > 0
            path = path + "&start=" + startIso.encodeUriComponent() + "&end=" + endIso.encodeUriComponent()
        end if
        return path
    end function

    function channelSessionPath(channelId as string) as string
        return "/api/v2/livetv/channels/" + channelId.encodeUriComponent() + "/sessions"
    end function

    function liveSessionPath(sessionId as string) as string
        return "/api/v2/livetv/sessions/" + sessionId.encodeUriComponent()
    end function

    function liveHeartbeatPath(sessionId as string) as string
        return liveSessionPath(sessionId) + "/heartbeat"
    end function

    function recordingsPath() as string
        return "/api/v2/livetv/recordings"
    end function

    function recordingPath(recordingId as string) as string
        return "/api/v2/livetv/recordings/" + recordingId.encodeUriComponent()
    end function

    ' Session start body: v2 nests capabilities under client_capabilities.
    function buildSessionStartBody(caps as dynamic) as string
        if caps = invalid
            return "{}"
        end if
        clientCaps = {}
        if type(caps.codecs_video) = "roArray"
            clientCaps.codecs_video = caps.codecs_video
        end if
        if type(caps.codecs_audio) = "roArray"
            clientCaps.codecs_audio = caps.codecs_audio
        end if
        if caps.max_resolution <> invalid
            clientCaps.max_resolution = caps.max_resolution
        end if
        return FormatJson({ client_capabilities: clientCaps })
    end function

    ' Returns JSON with only program_id, or invalid when the id is missing.
    ' Server fills channel/window/title — clients must not over-post those fields.
    function buildScheduleRecordingBody(program as object) as dynamic
        if program = invalid
            return invalid
        end if
        programId = ""
        if program.id <> invalid
            programId = (program.id as string).trim()
        else if program.program_id <> invalid
            programId = (program.program_id as string).trim()
        end if
        if programId.len() = 0
            return invalid
        end if
        return FormatJson({
            program_id: programId
        })
    end function

    ' True when programId exists in the loaded guide for the given channel.
    function programBelongsToChannel(programs as object, programId as string, channelId as string) as boolean
        if programId.len() = 0 or channelId.len() = 0 or programs = invalid
            return false
        end if
        for each program in programs
            if type(program) = "roAssociativeArray" and program.id <> invalid and program.channel_id <> invalid
                if (program.id as string) = programId and (program.channel_id as string) = channelId
                    return true
                end if
            end if
        end for
        return false
    end function

    function channelsFromResponse(data as dynamic) as object
        channels = []
        if data = invalid or type(data) <> "roAssociativeArray"
            return channels
        end if
        if type(data.items) <> "roArray"
            return channels
        end if
        for each channel in data.items
            if type(channel) = "roAssociativeArray" and channel.enabled <> false
                channels.push(channel)
            end if
        end for
        return channels
    end function

    function programsFromResponse(data as dynamic) as object
        if data = invalid or type(data) <> "roAssociativeArray"
            return []
        end if
        if type(data.items) = "roArray"
            return data.items
        end if
        return []
    end function

    function recordingsFromResponse(data as dynamic) as object
        recordings = []
        if data = invalid or type(data) <> "roAssociativeArray"
            return recordings
        end if
        if type(data.items) <> "roArray"
            return recordings
        end if
        for each recording in data.items
            if type(recording) = "roAssociativeArray"
                recordings.push(recording)
            end if
        end for
        return recordings
    end function

    function channelDisplayLabel(channel as object) as string
        if channel.name <> invalid and (channel.name as string).trim().len() > 0
            return (channel.name as string).trim()
        end if
        if channel.callsign <> invalid and (channel.callsign as string).trim().len() > 0
            return (channel.callsign as string).trim()
        end if
        number = ""
        if channel.number_override <> invalid and (channel.number_override as string).len() > 0
            number = channel.number_override as string
        else if channel.number <> invalid
            number = channel.number as string
        end if
        return "Channel " + number
    end function

    ' v2 returns one opaque stream_url for hls and mpegts alike.
    function playableLiveUrl(start as object) as dynamic
        if start = invalid or start.stream_url = invalid
            return invalid
        end if
        url = (start.stream_url as string).trim()
        if url.len() = 0
            return invalid
        end if
        return url
    end function

    function isHlsSession(start as object) as boolean
        if start = invalid
            return false
        end if
        if start.transport <> invalid
            return LCase((start.transport as string).trim()) = "hls"
        end if
        url = playableLiveUrl(start)
        if url = invalid
            return false
        end if
        path = LCase((url as string).trim())
        if path.instr(".m3u8") >= 0
            return true
        end if
        if path.instr("/live-hls/") >= 0
            return true
        end if
        return false
    end function

    function liveStreamFormat(start as object) as string
        if isHlsSession(start)
            return "hls"
        end if
        return "mpegts"
    end function

    function resolveLivePlaybackUrl(serverUrl as string, streamPath as string, token as dynamic, profileId as dynamic) as object
        trimmed = streamPath.trim()
        if trimmed.len() = 0
            return {
                ok: false,
                message: "Playback failed to start"
            }
        end if
        isAbsolute = trimmed.left(7) = "http://" or trimmed.left(8) = "https://"
        if isAbsolute and not Prairie.Url.isSameServerOrigin(serverUrl, trimmed)
            return {
                ok: false,
                message: "Live TV requires a server-proxied stream"
            }
        end if
        return {
            ok: true,
            url: Prairie.Url.buildStreamUrl(serverUrl, trimmed, token, profileId)
        }
    end function

    function isoToSeconds(iso as string) as integer
        if iso.len() = 0
            return -1
        end if
        dt = CreateObject("roDateTime")
        dt.FromISO8601String(iso)
        return dt.AsSeconds()
    end function

    function secondsToIso(seconds as integer) as string
        if seconds < 0
            return ""
        end if
        dt = CreateObject("roDateTime")
        dt.FromSeconds(seconds)
        return dt.ToISOString()
    end function

    function nowSeconds() as integer
        dt = CreateObject("roDateTime")
        dt.Mark()
        return dt.AsSeconds()
    end function

    function programsForChannel(programs as object, channelId as string) as object
        matched = []
        if programs = invalid
            return matched
        end if
        for each program in programs
            if type(program) = "roAssociativeArray" and program.channel_id <> invalid
                if (program.channel_id as string) = channelId
                    matched.push(program)
                end if
            end if
        end for
        return matched
    end function

    ' Active + upcoming only — omit programmes that have already ended.
    function activeOrUpcomingProgramsForChannel(programs as object, channelId as string, nowSec = -1 as integer) as object
        if nowSec < 0
            nowSec = nowSeconds()
        end if
        matched = []
        for each program in programsForChannel(programs, channelId)
            stopSec = isoToSeconds(program.stop)
            if stopSec > nowSec
                matched.push(program)
            end if
        end for
        return matched
    end function

    function currentProgramForChannel(programs as object, channelId as string, nowSec = -1 as integer) as dynamic
        if nowSec < 0
            nowSec = nowSeconds()
        end if
        for each program in programsForChannel(programs, channelId)
            startSec = isoToSeconds(program.start)
            stopSec = isoToSeconds(program.stop)
            if startSec >= 0 and stopSec >= 0 and startSec <= nowSec and nowSec < stopSec
                return program
            end if
        end for
        return invalid
    end function

    function nextProgramForChannel(programs as object, channelId as string, nowSec = -1 as integer) as dynamic
        if nowSec < 0
            nowSec = nowSeconds()
        end if
        soonest = invalid
        soonestStart = 2147483647
        for each program in programsForChannel(programs, channelId)
            startSec = isoToSeconds(program.start)
            if startSec > nowSec and startSec < soonestStart
                soonest = program
                soonestStart = startSec
            end if
        end for
        return soonest
    end function

end namespace
