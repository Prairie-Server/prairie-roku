namespace Prairie.Catalog

    function buildCatalogPath(query as object) as string
        ' Kept for callers that only need a URL. Catalog reads themselves use
        ' buildCatalogRequest below because v2 is a POST contract.
        params = []
        if query.libraryId <> invalid
            params.push("library_id=" + (query.libraryId as integer).toStr())
        end if
        if query.type <> invalid and (query.type as string).len() > 0
            params.push("type=" + (query.type as string).encodeUriComponent())
        end if
        if query.q <> invalid and (query.q as string).len() > 0
            params.push("q=" + (query.q as string).encodeUriComponent())
        end if
        if query.source <> invalid and (query.source as string).len() > 0
            params.push("source=" + (query.source as string).encodeUriComponent())
        end if
        if query.collectionId <> invalid and (query.collectionId as string).len() > 0
            params.push("collection_id=" + (query.collectionId as string).encodeUriComponent())
        end if
        if query.offset <> invalid
            params.push("seek=" + (query.offset as integer).toStr())
        end if
        if query.limit <> invalid
            params.push("limit=" + (query.limit as integer).toStr())
        end if
        if query.snapshot <> invalid and (query.snapshot as string).len() > 0
            params.push("cursor=" + (query.snapshot as string).encodeUriComponent())
        end if
        if query.sort <> invalid and (query.sort as string).len() > 0
            params.push("sort=" + (query.sort as string).encodeUriComponent())
        end if
        if query.order <> invalid and (query.order as string).len() > 0
            params.push("order=" + (query.order as string).encodeUriComponent())
        end if
        if params.count() = 0
            return "/api/v2/catalog/query"
        end if
        return "/api/v2/catalog/query?" + params.join("&")
    end function

    function buildCatalogRequest(query as object, options as object) as object
        body = {}
        if query.libraryId <> invalid
            body.library_id = (query.libraryId as integer).toStr()
        end if
        if query.type <> invalid and (query.type as string).len() > 0
            body.type = query.type as string
        end if
        if query.q <> invalid and (query.q as string).len() > 0
            body.q = query.q as string
        end if
        if query.source <> invalid and (query.source as string).len() > 0
            body.source = query.source as string
        end if
        if query.collectionId <> invalid and (query.collectionId as string).len() > 0
            body.collection_id = query.collectionId as string
        end if
        if query.scope <> invalid and (query.scope as string).len() > 0
            body.scope = query.scope as string
        end if
        if query.sectionId <> invalid and (query.sectionId as string).len() > 0
            body.section_id = query.sectionId as string
        end if
        if query.offset <> invalid
            body.seek = query.offset as integer
        end if
        if query.limit <> invalid
            body.limit = query.limit as integer
        end if
        if query.snapshot <> invalid and (query.snapshot as string).len() > 0
            body.cursor = query.snapshot as string
        end if
        if query.sort <> invalid and (query.sort as string).len() > 0
            body.sort = query.sort as string
        end if
        if query.order <> invalid and (query.order as string).len() > 0
            body.order = query.order as string
        end if
        return Prairie.Api.buildRequest(options, "/api/v2/catalog/query", "POST", FormatJson(body))
    end function
    function itemDetailPath(contentId as string) as string
        return "/api/v1/catalog/items/" + contentId.encodeUriComponent()
    end function

    function seasonsPath(seriesId as string) as string
        return "/api/v1/catalog/series/" + seriesId.encodeUriComponent() + "/seasons"
    end function

    function episodesPath(seriesId as string, seasonNumber as integer) as string
        return "/api/v1/catalog/series/" + seriesId.encodeUriComponent() + "/seasons/" + seasonNumber.toStr() + "/episodes"
    end function

    ' GET /api/v2/recommendations/similar/{item_id} (the More Like This rail).
    function similarPath(contentId as string) as string
        return "/api/v2/recommendations/similar/" + contentId.encodeUriComponent() + "?limit=20"
    end function

    function twoDigits(value as integer) as string
        if value < 10 and value >= 0
            return "0" + value.toStr()
        end if
        return value.toStr()
    end function

    ' "S01E02" for an episode, "E02" without a season, "" without an episode number.
    function episodeCode(seasonNumber as dynamic, episodeNumber as dynamic) as string
        if not isNumber(episodeNumber)
            return ""
        end if
        code = "E" + twoDigits(Int(episodeNumber))
        if isNumber(seasonNumber)
            code = "S" + twoDigits(Int(seasonNumber)) + code
        end if
        return code
    end function

    ' Episode card heading: "S01E02 · Title". fallbackSeason covers season
    ' lists whose episodes omit season_number.
    function episodeCardTitle(episode as object, fallbackSeason = invalid as dynamic) as string
        title = ""
        if episode.title <> invalid
            title = episode.title as string
        end if
        season = episode.season_number
        if not isNumber(season)
            season = fallbackSeason
        end if
        code = episodeCode(season, episode.episode_number)
        if code.len() = 0
            if title.len() = 0
                return "Episode"
            end if
            return title
        end if
        if title.len() = 0
            return code
        end if
        return code + " · " + title
    end function

    ' "2024-03-05" (or an RFC 3339 timestamp) → "Mar 5, 2024"; "" when unparseable.
    function formatAirDate(value as dynamic) as string
        if value = invalid
            return ""
        end if
        text = value as string
        if text.len() < 10 or text.mid(4, 1) <> "-" or text.mid(7, 1) <> "-"
            return ""
        end if
        year = text.left(4).toInt()
        month = text.mid(5, 2).toInt()
        day = text.mid(8, 2).toInt()
        if year < 1 or month < 1 or month > 12 or day < 1 or day > 31
            return ""
        end if
        months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
        return months[month - 1] + " " + day.toStr() + ", " + year.toStr()
    end function

    ' Runtime minutes → "45m" or "1h 5m"; "" when absent.
    function formatRuntime(minutes as dynamic) as string
        if not isNumber(minutes)
            return ""
        end if
        total = Int(minutes)
        if total < 1
            return ""
        end if
        if total < 60
            return total.toStr() + "m"
        end if
        hours = total \ 60
        rest = total mod 60
        if rest = 0
            return hours.toStr() + "h"
        end if
        return hours.toStr() + "h " + rest.toStr() + "m"
    end function

    ' Episode card second line: air date and runtime.
    function episodeCardMeta(episode as object) as string
        parts = []
        airDate = formatAirDate(episode.air_date)
        if airDate.len() > 0
            parts.push(airDate)
        end if
        runtime = formatRuntime(episode.runtime)
        if runtime.len() > 0
            parts.push(runtime)
        end if
        return parts.join(" · ")
    end function

    function arrayFromResponse(data as dynamic, key as string) as object
        if data = invalid
            return []
        end if
        if GetInterface(data, "ifArray") <> invalid
            return data
        end if
        if type(data) <> "roAssociativeArray"
            return []
        end if
        value = data[key]
        if type(value) = "roArray"
            return value
        end if
        return []
    end function

    function itemsFromResponse(data as dynamic) as object
        return arrayFromResponse(data, "items")
    end function

    function seasonsFromResponse(data as dynamic) as object
        return arrayFromResponse(data, "seasons")
    end function

    function episodesFromResponse(data as dynamic) as object
        return arrayFromResponse(data, "episodes")
    end function

    ' Normalize a catalog page for browse / search / collection grids.
    function pageFromResponse(data as dynamic) as object
        page = {
            items: [],
            has_more: false,
            snapshot: "",
            total: 0
        }
        if data = invalid
            return page
        end if
        page.items = itemsFromResponse(data)
        if type(data) <> "roAssociativeArray"
            return page
        end if
        pageMeta = invalid
        if data.page <> invalid and type(data.page) = "roAssociativeArray"
            pageMeta = data.page
        end if
        if pageMeta <> invalid and pageMeta.has_more = true
            page.has_more = true
        else if data.has_more = true
            page.has_more = true
        end if
        if data.window_cursor <> invalid
            page.snapshot = data.window_cursor as string
        else if data.snapshot <> invalid
            page.snapshot = data.snapshot as string
        end if
        if data.total <> invalid
            page.total = data.total as integer
        end if
        return page
    end function

    function isNumber(value as dynamic) as boolean
        t = LCase(type(value))
        return t = "integer" or t = "rointeger" or t = "roint" or t = "longinteger" or t = "rolonginteger" or t = "float" or t = "rofloat" or t = "double" or t = "rodouble"
    end function

    ' Formats item detail `community_rating` ({ average, count }) as
    ' "4.2/5 · 7 ratings". Returns "" when absent or invalid so the caller
    ' can hide it (the server omits the field below 3 ratings).
    function formatCommunityRating(rating as dynamic) as string
        if type(rating) <> "roAssociativeArray"
            return ""
        end if
        if not isNumber(rating.average) or not isNumber(rating.count)
            return ""
        end if
        average = rating.average
        count = Int(rating.count)
        if average < 1 or average > 5 or count < 1 or count <> rating.count
            return ""
        end if
        tenths = Int(average * 10 + 0.5)
        text = (tenths \ 10).toStr() + "." + (tenths mod 10).toStr() + "/5 · " + count.toStr()
        if count = 1
            return text + " rating"
        end if
        return text + " ratings"
    end function

    ' Normalizes item detail `user_rating` to 1–5, or 0 when unrated/invalid.
    function normalizeUserRating(value as dynamic) as integer
        if not isNumber(value) or value <> Int(value) or value < 1 or value > 5
            return 0
        end if
        return Int(value)
    end function

    ' Label for the detail screen's rate control.
    function formatUserRating(rating as integer) as string
        if rating < 1 or rating > 5
            return "☆ Rate"
        end if
        return "★ Rated " + rating.toStr() + "/5"
    end function

    ' Dialog buttons for picking a rating; index i maps via ratingFromDialogIndex.
    function ratingDialogButtons() as object
        return ["★★★★★  5", "★★★★  4", "★★★  3", "★★  2", "★  1", "Clear rating"]
    end function

    ' Maps a ratingDialogButtons index to 5..1, 0 (clear), or -1 (out of range).
    function ratingFromDialogIndex(index as integer) as integer
        if index >= 0 and index <= 4
            return 5 - index
        end if
        if index = 5
            return 0
        end if
        return -1
    end function

    ' PUT /api/v2/ratings/{item_id} {"rating": n} for 1–5; DELETE to clear.
    function buildRatingRequest(options as object, itemId as string, rating as integer) as object
        path = "/api/v2/ratings/" + itemId.encodeUriComponent()
        if rating < 1 or rating > 5
            return Prairie.Api.buildRequest(options, path, "DELETE")
        end if
        return Prairie.Api.buildRequest(options, path, "PUT", FormatJson({ rating: rating }))
    end function

end namespace


