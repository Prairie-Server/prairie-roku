namespace Prairie.Libraries

    function librariesPath() as string
        return "/api/v2/user/libraries"
    end function

    function librariesFromResponse(data as dynamic) as object
        raw = []
        if data = invalid
            return []
        end if
        if GetInterface(data, "ifArray") <> invalid
            raw = data
        else if type(data) = "roAssociativeArray" and type(data.items) = "roArray"
            ' GET /api/v2/user/libraries wraps the list in "items".
            raw = data.items
        else if type(data) = "roAssociativeArray" and type(data.libraries) = "roArray"
            raw = data.libraries
        else
            return []
        end if

        libraries = []
        for each entry in raw
            if type(entry) = "roAssociativeArray"
                libraries.push(normalizeLibrary(entry))
            end if
        end for
        return libraries
    end function

    function normalizeLibrary(entry as object) as object
        library = {
            id: 0,
            name: "Library",
            type: "",
            poster_url: ""
        }
        library.id = idFromValue(entry.id)
        if entry.name <> invalid and (entry.name as string).len() > 0
            library.name = entry.name as string
        end if
        if entry.type <> invalid
            library.type = entry.type as string
        end if
        if entry.poster_url <> invalid
            library.poster_url = entry.poster_url as string
        end if
        return library
    end function

    ' v2 sends library ids as strings ("3"); the rest of the client keys
    ' libraries by integer id (catalog filters, collection paths).
    function idFromValue(value as dynamic) as integer
        if value = invalid
            return 0
        end if
        kind = LCase(type(value))
        if kind = "string" or kind = "rostring"
            return (value as string).trim().toInt()
        end if
        if kind = "integer" or kind = "roint" or kind = "rointeger" or kind = "longinteger" or kind = "rolonginteger" or kind = "float" or kind = "rofloat" or kind = "double" or kind = "rodouble"
            return Int(value)
        end if
        return 0
    end function

end namespace

