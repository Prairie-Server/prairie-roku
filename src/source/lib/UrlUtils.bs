namespace Prairie.Url

    ' Trim trailing slashes from a Prairie server base URL.
    function normalizeServerUrl(url as string) as string
        trimmed = url.trim()
        while trimmed.len() > 0 and trimmed.right(1) = "/"
            trimmed = trimmed.left(trimmed.len() - 1)
        end while
        return trimmed
    end function

    ' Join a server base URL with an absolute or relative API path.
    function joinUrl(base as string, path as string) as string
        normalizedBase = normalizeServerUrl(base)
        normalizedPath = path
        if normalizedPath.len() = 0
            return normalizedBase
        end if
        if normalizedPath.left(1) <> "/"
            normalizedPath = "/" + normalizedPath
        end if
        return normalizedBase + normalizedPath
    end function

    ' True when candidate resolves to the same origin as serverUrl.
    function isSameServerOrigin(serverUrl as string, candidate as string) as boolean
        server = normalizeServerUrl(serverUrl)
        target = candidate.trim()
        if server.len() = 0 or target.len() = 0
            return false
        end if

        if target.left(7) <> "http://" and target.left(8) <> "https://"
            target = joinUrl(server, target)
        end if

        serverParts = parseOrigin(server)
        targetParts = parseOrigin(target)
        if serverParts = invalid or targetParts = invalid
            return false
        end if
        return LCase(serverParts.scheme) = LCase(targetParts.scheme) and LCase(serverParts.host) = LCase(targetParts.host)
    end function

    ' Attach auth query params for same-origin Prairie stream URLs. Native Roku
    ' Video cannot send X-Profile-Id; callers pass profile_id alongside token.
    function buildStreamUrl(serverUrl as string, streamPath as string, token as dynamic, profileId as dynamic) as string
        base = streamPath.trim()
        if base.left(7) <> "http://" and base.left(8) <> "https://"
            base = joinUrl(serverUrl, base)
        end if

        tokenText = ""
        if token <> invalid
            tokenText = (token as string).trim()
        end if
        profileText = ""
        if profileId <> invalid
            profileText = (profileId as string).trim()
        end if
        if (tokenText.len() = 0 and profileText.len() = 0) or not isSameServerOrigin(serverUrl, base)
            return base
        end if

        separator = "?"
        if base.instr("?") >= 0
            separator = "&"
        end if
        query = ""
        if profileText.len() > 0
            query = "profile_id=" + profileText.encodeUriComponent()
        end if
        if tokenText.len() > 0
            if query.len() > 0
                query = query + "&"
            end if
            query = query + "token=" + tokenText
        end if
        return base + separator + query
    end function

    function parseOrigin(url as string) as dynamic
        lower = LCase(url)
        scheme = ""
        rest = ""
        if lower.left(8) = "https://"
            scheme = "https"
            rest = url.mid(8)
        else if lower.left(7) = "http://"
            scheme = "http"
            rest = url.mid(7)
        else
            return invalid
        end if

        slash = rest.instr("/")
        host = rest
        if slash >= 0
            host = rest.left(slash)
        end if
        if host.len() = 0
            return invalid
        end if
        return {
            scheme: scheme,
            host: LCase(host)
        }
    end function

end namespace
