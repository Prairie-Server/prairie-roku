namespace tests
    @suite("Prairie.Playback")
    class PlaybackSuite extends rooibos.BaseTestSuite

        @describe("paths and bodies")
        @it("builds start/progress/audio payloads and paths")
        sub _()
            m.assertEqual(Prairie.Playback.startPath(), "/api/v1/playback/start")
            m.assertEqual(Prairie.Playback.transcodeStartPath(), "/api/v1/playback/transcode/start")
            m.assertTrue(Prairie.Playback.progressPath("ab/c").instr("ab%2Fc") >= 0)
            m.assertTrue(Prairie.Playback.sessionPath("s1").instr("/api/v1/playback/s1") >= 0)
            body = ParseJson(Prairie.Playback.buildStartBody({
                fileId: 9,
                profileId: "p1",
                forcedPlayMethod: "direct",
                startPosition: 30
            }))
            m.assertEqual(body.file_id, 9)
            m.assertEqual(body.profile_id, "p1")
            m.assertEqual(body.play_method, "direct")
            m.assertEqual(body.start_position, 30)
            progress = ParseJson(Prairie.Playback.buildProgressBody(12.5, true))
            m.assertEqual(progress.position, 12.5)
            m.assertTrue(progress.is_paused)
            remux = ParseJson(Prairie.Playback.buildTranscodeStartBody({
                sessionId: "s1",
                seekSeconds: 12,
                playMethod: "remux"
            }))
            m.assertEqual(remux.target_codec_video, "copy")
            m.assertEqual(remux.target_codec_audio, "copy")
            m.assertEqual(remux.target_bitrate_kbps, 0)
            full = ParseJson(Prairie.Playback.buildTranscodeStartBody({
                sessionId: "s1",
                seekSeconds: 0,
                playMethod: "transcode"
            }))
            m.assertEqual(full.target_codec_video, "h264")
            m.assertEqual(full.target_resolution, "1080p")
            m.assertTrue(Prairie.Playback.needsHlsBootstrap("remux"))
            m.assertTrue(Prairie.Playback.needsHlsBootstrap("transcode"))
            m.assertFalse(Prairie.Playback.needsHlsBootstrap("direct"))
        end sub

        @describe("stream helpers")
        @it("detects stream format and resume seconds")
        sub _()
            m.assertEqual(Prairie.Playback.detectStreamFormat({ stream_url: "/x.m3u8" }), "hls")
            m.assertEqual(Prairie.Playback.detectStreamFormat({ stream_url: "/x.mp4" }), "mp4")
            m.assertEqual(Prairie.Playback.detectStreamFormat({
                playback_info: { stream_type: "dash" }
            }), "dash")
            m.assertEqual(Prairie.Playback.detectStreamFormat(invalid), "hls")
            m.assertEqual(Prairie.Playback.resumeSeconds({
                user_data: { position_seconds: 100, duration_seconds: 1000 }
            }), 100)
            m.assertEqual(Prairie.Playback.resumeSeconds({
                user_data: { position_seconds: 980, duration_seconds: 1000 }
            }), invalid)
            m.assertEqual(Prairie.Playback.resumeSeconds(invalid), invalid)
            url = Prairie.Playback.resolveStreamUrl("https://prairie.example.com", {
                stream_url: "/stream"
            }, "tok")
            m.assertTrue(url.instr("https://prairie.example.com/stream") = 0)
            m.assertTrue(url.instr("token=tok") >= 0)
            manifestUrl = Prairie.Playback.resolveStreamUrl("https://prairie.example.com", {
                stream_url: "/placeholder",
                manifest_url: "/hls/master.m3u8"
            }, "tok")
            m.assertTrue(manifestUrl.instr("master.m3u8") >= 0)
            audio = ParseJson(Prairie.Playback.buildAudioBody(2, 15.0))
            m.assertEqual(audio.audio_track_index, 2)
            m.assertEqual(Prairie.Playback.audioPath("s/1").instr("s%2F1") >= 0, true)
            applied = Prairie.Playback.applyTranscodeResponse({
                session_id: "s1",
                stream_url: "/placeholder",
                play_method: "remux"
            }, {
                session_id: "s1",
                manifest_url: "/hls/master.m3u8",
                player_start_seconds: 12,
                can_seek_anywhere: false
            })
            m.assertEqual(applied.stream_url, "/hls/master.m3u8")
            m.assertEqual(applied.play_method, "remux")
        end sub

    end class
end namespace
