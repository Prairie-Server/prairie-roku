namespace tests
    @suite("Prairie.Playback")
    class PlaybackSuite extends rooibos.BaseTestSuite

        @describe("paths and bodies")
        @it("builds start/progress/audio payloads and paths")
        sub _()
            m.assertEqual(Prairie.Playback.startPath(), "/api/v2/playback/start")
            m.assertEqual(Prairie.Playback.capabilitiesPath(), "/api/v2/playback/capabilities")
            m.assertEqual(Prairie.Playback.progressPath("ab/c"), "/api/v2/playback/ab%2Fc/progress")
            m.assertEqual(Prairie.Playback.sessionPath("s1"), "/api/v2/playback/s1")
            m.assertEqual(Prairie.Playback.replanPath("s/1"), "/api/v2/playback/s%2F1/replan")
            m.assertEqual(Prairie.Playback.legacyTranscodeStartPath(), "/api/v1/playback/transcode/start")
            m.assertEqual(Prairie.Playback.legacyReplanPath("s/1"), "/api/v1/playback/s%2F1/replan")
            body = ParseJson(Prairie.Playback.buildStartBody({
                fileId: 9,
                profileId: "p1",
                forcedPlayMethod: "direct",
                startPosition: 30
            }))
            m.assertEqual(body.protocol_version, 3)
            m.assertEqual(body.file_id, 9)
            m.assertEqual(body.profile_id, "p1")
            m.assertEqual(body.quality_preference, "original")
            m.assertInvalid(body.installation_id)
            withInstall = ParseJson(Prairie.Playback.buildStartBody({
                fileId: 9,
                profileId: "p1",
                installationId: "inst-1"
            }))
            m.assertEqual(withInstall.installation_id, "inst-1")
            preferred = ParseJson(Prairie.Playback.buildStartBody({
                fileId: 9,
                profileId: "p1",
                qualityPreference: "720p"
            }))
            m.assertEqual(preferred.quality_preference, "720p")
            m.assertInvalid(preferred.audio_track_index)
            withAudio = ParseJson(Prairie.Playback.buildStartBody({
                fileId: 9,
                profileId: "p1",
                audioTrackIndex: 2
            }))
            m.assertEqual(withAudio.audio_track_index, 2)
            m.assertEqual(body.client_playback_context.protocol_version, 3)
            m.assertEqual(body.client_playback_context.device.platform, "roku")
            m.assertEqual(body.start_position, 30)
            progress = ParseJson(Prairie.Playback.buildProgressBody("inst-1", 3, 12.5, true))
            m.assertEqual(progress.installation_id, "inst-1")
            m.assertEqual(progress.sequence, 3)
            m.assertEqual(progress.position, 12.5)
            m.assertTrue(progress.is_paused)
            remux = ParseJson(Prairie.Playback.buildTranscodeStartBody({
                sessionId: "s1",
                seekSeconds: 12,
                playMethod: "remux"
            }))
            m.assertEqual(remux.target_codec_video, "copy")
            m.assertEqual(remux.target_codec_audio, "copy")
            m.assertEqual(remux.target_bitrate_kbps, 0)
            full = ParseJson(Prairie.Playback.buildTranscodeStartBody({
                sessionId: "s1",
                seekSeconds: 0,
                playMethod: "transcode"
            }))
            m.assertEqual(full.target_codec_video, "h264")
            m.assertEqual(full.target_resolution, "1080p")
            targeted = ParseJson(Prairie.Playback.buildTranscodeStartBody({
                sessionId: "s1",
                seekSeconds: 5,
                playMethod: "transcode",
                targetResolution: "720p",
                targetBitrateKbps: 2000,
                copyVideo: false
            }))
            m.assertEqual(targeted.target_resolution, "720p")
            m.assertEqual(targeted.target_bitrate_kbps, 2000)
            m.assertEqual(targeted.target_codec_audio, "aac")
            copy = ParseJson(Prairie.Playback.buildTranscodeStartBody({
                sessionId: "s1",
                seekSeconds: 0,
                playMethod: "remux",
                copyVideo: true,
                targetResolution: "",
                targetBitrateKbps: 0
            }))
            m.assertEqual(copy.target_codec_video, "copy")
            m.assertEqual(copy.target_codec_audio, "aac")
            m.assertEqual(Prairie.Playback.qualityLadderPath(), "/api/v2/playback/quality-ladder")
            m.assertTrue(Prairie.Playback.needsHlsBootstrap("remux"))
            m.assertTrue(Prairie.Playback.needsHlsBootstrap("transcode"))
            m.assertFalse(Prairie.Playback.needsHlsBootstrap("direct"))
        end sub

        @describe("stream helpers")
        @it("detects stream format and resume seconds")
        sub _()
            m.assertEqual(Prairie.Playback.detectStreamFormat({ stream_url: "/x.m3u8" }), "hls")
            m.assertEqual(Prairie.Playback.detectStreamFormat({ stream_url: "/x.mp4" }), "mp4")
            m.assertEqual(Prairie.Playback.detectStreamFormat({
                playback_info: { stream_type: "dash" }
            }), "dash")
            m.assertEqual(Prairie.Playback.detectStreamFormat(invalid), "hls")
            m.assertEqual(Prairie.Playback.resumeSeconds({
                user_data: { position_seconds: 100, duration_seconds: 1000 }
            }), 100)
            m.assertEqual(Prairie.Playback.resumeSeconds({
                user_data: { position_seconds: 980, duration_seconds: 1000 }
            }), invalid)
            m.assertEqual(Prairie.Playback.resumeSeconds(invalid), invalid)
            url = Prairie.Playback.resolveStreamUrl("https://prairie.example.com", {
                stream_url: "/stream"
            }, "tok")
            m.assertTrue(url.instr("https://prairie.example.com/stream") = 0)
            m.assertTrue(url.instr("token=tok") >= 0)
            manifestUrl = Prairie.Playback.resolveStreamUrl("https://prairie.example.com", {
                stream_url: "/placeholder",
                manifest_url: "/hls/master.m3u8"
            }, "tok")
            m.assertTrue(manifestUrl.instr("master.m3u8") >= 0)
            audio = ParseJson(Prairie.Playback.buildAudioBody(2, 15.0))
            m.assertEqual(audio.audio_track_index, 2)
            m.assertEqual(Prairie.Playback.legacyAudioPath("s/1"), "/api/v1/playback/s%2F1/audio")
            applied = Prairie.Playback.applyTranscodeResponse({
                session_id: "s1",
                stream_url: "/placeholder",
                play_method: "remux"
            }, {
                session_id: "s1",
                manifest_url: "/hls/master.m3u8",
                player_start_seconds: 12,
                can_seek_anywhere: false
            })
            m.assertEqual(applied.stream_url, "/hls/master.m3u8")
            m.assertEqual(applied.play_method, "remux")
        end sub

        @it("covers HLS bootstrap edges and transcode merge branches")
        sub _()
            m.assertFalse(Prairie.Playback.needsHlsBootstrap(invalid))
            m.assertEqual(Prairie.Playback.applyTranscodeResponse(invalid, {}), invalid)
            kept = Prairie.Playback.applyTranscodeResponse({ session_id: "keep" }, invalid)
            m.assertEqual(kept.session_id, "keep")

            seekable = Prairie.Playback.applyTranscodeResponse({
                session_id: "s1",
                stream_url: "/placeholder",
                play_method: "remux",
                playback_info: { container: "mkv" }
            }, {
                session_id: "s2",
                manifest_url: "/hls/master.m3u8",
                duration_seconds: 3600,
                player_start_seconds: 5,
                can_seek_anywhere: true
            })
            m.assertEqual(seekable.session_id, "s2")
            m.assertEqual(seekable.play_method, "transcode")
            m.assertEqual(seekable.duration_seconds, 3600)
            m.assertEqual(seekable.playback_info.stream_type, "hls")
            m.assertTrue(seekable.playback_info.can_seek_anywhere)
            m.assertEqual(seekable.playback_info.container, "mkv")

            m.assertEqual(Prairie.Playback.detectStreamFormat({
                playback_info: { stream_type: "mpegts" }
            }), "hls")
            m.assertEqual(Prairie.Playback.detectStreamFormat({
                manifest_url: "/vod/master.m3u8",
                stream_url: "/ignored.ts"
            }), "hls")
            m.assertEqual(Prairie.Playback.detectStreamFormat({
                stream_url: "/manifest.mpd"
            }), "dash")
            m.assertEqual(Prairie.Playback.detectStreamFormat({
                stream_url: "/unknown.bin"
            }), "hls")
            m.assertEqual(Prairie.Playback.resumeSeconds({
                user_data: { position_seconds: 0, duration_seconds: 1000 }
            }), invalid)

            store = Prairie.Store.createMemoryStore()
            Prairie.PlaybackSettings.save({
                forceDirectPlay: true,
                forceTranscode: false
            }, store)
            m.assertEqual(Prairie.Playback.forcedPlayMethodFromStore(store), "direct")
        end sub

        @it("normalizes protocol-v3 playback plans and builds quality replans")
        sub _()
            playback = Prairie.Playback.normalizeStartResponse({
                protocol_version: 3,
                session_id: "s1",
                playback_plan: {
                    plan_id: "plan-12345678",
                    plan_attempt_key: "v3:plan-12345678",
                    delivery: "server_remux_progressive",
                    stream: { url: "/api/v2/playback/stream/s1", protocol: "http_progressive" },
                    timeline: { player_start_seconds: 10, stream_origin_seconds: 2, can_seek_anywhere: false },
                    selected_tracks: { audio: { id: "a1", index: 2 } },
                    effective_recipe: { video_codec: "hevc", audio_codec: "aac" },
                    source: { duration_seconds: 3600 },
                    effective_media_file_id: 9
                }
            })
            m.assertEqual(playback.session_id, "s1")
            m.assertEqual(playback.play_method, "remux")
            m.assertEqual(playback.stream_url, "/api/v2/playback/stream/s1")
            m.assertEqual(playback.position, 12)
            m.assertEqual(playback.audio_track_index, 2)
            m.assertTrue(playback.is_protocol_v3)
            m.assertEqual(playback.plan_id, "plan-12345678")
            m.assertEqual(playback.plan_attempt_key, "v3:plan-12345678")
            m.assertEqual(playback.effective_height, 0)

            playback.playback_attempt_id = "attempt-12345678"
            replan = ParseJson(Prairie.Playback.buildReplanBody(playback, "720p", 120.0))
            m.assertEqual(replan.protocol_version, 3)
            m.assertEqual(replan.operation, "quality_change")
            m.assertEqual(replan.playback_attempt_id, "attempt-12345678")
            m.assertEqual(replan.failed_plan_id, "plan-12345678")
            m.assertEqual(replan.plan_attempt_key, "v3:plan-12345678")
            m.assertEqual(replan.quality_preference, "720p")
            m.assertEqual(replan.position_seconds, 120)
            m.assertInvalid(replan.installation_id)
            m.assertEqual(replan.selected_tracks.audio.id, "a1")
            m.assertEqual(replan.selected_tracks.audio.index, 2)

            playback.installation_id = "inst-1"
            playback.progress_sequence = 4
            audioReplan = ParseJson(Prairie.Playback.buildAudioReplanBody(playback, 1, "auto", 30.0))
            m.assertEqual(audioReplan.operation, "track_change")
            m.assertEqual(audioReplan.installation_id, "inst-1")
            m.assertEqual(audioReplan.quality_preference, "auto")
            m.assertEqual(audioReplan.selected_tracks.audio.id, "file:9:audio:1")
            m.assertEqual(audioReplan.selected_tracks.audio.index, 1)

            updated = Prairie.Playback.applyReplanResponse(playback, {
                protocol_version: 3,
                session_id: "s1",
                playback_plan: {
                    plan_id: "plan-87654321",
                    plan_attempt_key: "v3:plan-87654321",
                    delivery: "hls_transcode",
                    stream: { url: "/api/v2/playback/transcode/s1/master.m3u8", protocol: "hls" },
                    timeline: { player_start_seconds: 120, stream_origin_seconds: 0, can_seek_anywhere: true },
                    selected_tracks: { audio: { id: "a1", index: 2 } },
                    effective_recipe: { video_codec: "h264", audio_codec: "aac", height: 720 },
                    source: { duration_seconds: 3600 },
                    effective_media_file_id: 9
                }
            })
            m.assertEqual(updated.plan_id, "plan-87654321")
            m.assertEqual(updated.effective_height, 720)
            m.assertEqual(updated.play_method, "transcode")
            m.assertEqual(updated.attempted_plan_keys.count(), 2)
            m.assertEqual(updated.installation_id, "inst-1")
            m.assertEqual(updated.progress_sequence, 4)
        end sub

        @describe("v2 session state")
        @it("reads installation id, numbers progress and builds stop bodies")
        sub _()
            m.assertEqual(Prairie.Playback.installationIdFromCapabilities({ installation_id: " inst-1 " }), "inst-1")
            m.assertEqual(Prairie.Playback.installationIdFromCapabilities({}), "")
            m.assertEqual(Prairie.Playback.installationIdFromCapabilities(invalid), "")

            playback = {}
            m.assertEqual(Prairie.Playback.nextSequence(playback), 1)
            m.assertEqual(Prairie.Playback.nextSequence(playback), 2)
            m.assertEqual(playback.progress_sequence, 2)

            stopId = Prairie.Playback.newStopId()
            m.assertEqual(stopId.len(), 36)
            m.assertEqual(stopId, LCase(stopId))
            m.assertNotEqual(stopId, Prairie.Playback.newStopId())

            final = ParseJson(Prairie.Playback.buildStopBody("inst-1", "stop-1", 5, 42.5, false))
            m.assertEqual(final.installation_id, "inst-1")
            m.assertEqual(final.stop_id, "stop-1")
            m.assertEqual(final.sequence, 5)
            m.assertEqual(final.position, 42.5)
            m.assertFalse(final.is_paused)
            bare = ParseJson(Prairie.Playback.buildStopBody("inst-1", "stop-2", 0, 0.0, false))
            m.assertEqual(bare.stop_id, "stop-2")
            m.assertInvalid(bare.sequence)
            m.assertInvalid(bare.position)
            m.assertInvalid(bare.is_paused)

            ' Plan identity is used only when its index matches.
            planned = { selected_audio: { id: "a1", index: 2 }, media_file_id: 7 }
            m.assertEqual(Prairie.Playback.audioTrackIdentity(planned, 2).id, "a1")
            m.assertEqual(Prairie.Playback.audioTrackIdentity(planned, 0).id, "file:7:audio:0")
            noAudio = ParseJson(Prairie.Playback.buildReplanBody({
                playback_attempt_id: "a",
                plan_id: "p",
                plan_attempt_key: "k"
            }, "auto", 0.0))
            m.assertInvalid(noAudio.selected_tracks.audio)
        end sub

    end class
end namespace
