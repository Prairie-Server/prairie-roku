namespace tests
    @suite("Prairie.LiveTv")
    class LiveTvSuite extends rooibos.BaseTestSuite

        @describe("paths and response helpers")
        @it("filters enabled channels and builds paths")
        sub _()
            m.assertEqual(Prairie.LiveTv.channelsPath(), "/api/v2/livetv/channels")
            m.assertTrue(Prairie.LiveTv.guidePath(["a", "b"]).instr("channel_id=a&channel_id=b") >= 0)
            m.assertTrue(Prairie.LiveTv.guidePath(["a"]).instr("start=") >= 0)
            m.assertTrue(Prairie.LiveTv.guidePath(["a"]).instr("end=") >= 0)
            m.assertEqual(Prairie.LiveTv.channelSessionPath("ch/1"), "/api/v2/livetv/channels/ch%2F1/sessions")
            m.assertEqual(Prairie.LiveTv.liveSessionPath("s1"), "/api/v2/livetv/sessions/s1")
            m.assertEqual(Prairie.LiveTv.liveHeartbeatPath("s1"), "/api/v2/livetv/sessions/s1/heartbeat")
            m.assertEqual(Prairie.LiveTv.guidePath(["a", "b"]).left(44), "/api/v2/livetv/guide?channel_id=a&channel_id")
            many = []
            for i = 1 to 501
                many.push("c" + i.toStr())
            end for
            m.assertTrue(Prairie.LiveTv.guidePath(many).instr("channel_id=c500&") >= 0)
            m.assertEqual(Prairie.LiveTv.guidePath(many).instr("channel_id=c501"), -1)
            startBody = ParseJson(Prairie.LiveTv.buildSessionStartBody({ codecs_video: ["h264"], codecs_audio: ["aac"], max_resolution: "1080p", hdr: true }))
            m.assertEqual(startBody.client_capabilities.codecs_video[0], "h264")
            m.assertEqual(startBody.client_capabilities.codecs_audio[0], "aac")
            m.assertEqual(startBody.client_capabilities.max_resolution, "1080p")
            m.assertInvalid(startBody.client_capabilities.hdr)
            m.assertEqual(Prairie.LiveTv.buildSessionStartBody(invalid), "{}")
            m.assertEqual(ParseJson(Prairie.LiveTv.buildSessionStartBody({})).client_capabilities.count(), 0)
            channels = Prairie.LiveTv.channelsFromResponse({
                items: [
                    { id: "1", enabled: true, name: "One" },
                    { id: "2", enabled: false, name: "Two" }
                ]
            })
            m.assertEqual(channels.count(), 1)
            m.assertEqual(Prairie.LiveTv.programsFromResponse({ items: [{ id: "p" }] }).count(), 1)
            m.assertEqual(Prairie.LiveTv.channelsFromResponse(invalid).count(), 0)
            m.assertEqual(Prairie.LiveTv.channelsFromResponse({}).count(), 0)
            m.assertEqual(Prairie.LiveTv.programsFromResponse(invalid).count(), 0)
            m.assertEqual(Prairie.LiveTv.programsFromResponse({}).count(), 0)
        end sub

        @describe("labels and stream resolution")
        @it("labels channels and rejects cross-origin streams")
        sub _()
            m.assertEqual(Prairie.LiveTv.channelDisplayLabel({ name: " PBS " }), "PBS")
            m.assertEqual(Prairie.LiveTv.channelDisplayLabel({ callsign: "WXYZ", number: "7.1" }), "WXYZ")
            m.assertEqual(Prairie.LiveTv.channelDisplayLabel({ number: "4.1" }), "Channel 4.1")
            m.assertEqual(Prairie.LiveTv.channelDisplayLabel({ number_override: "9.1", number: "4.1" }), "Channel 9.1")
            m.assertEqual(Prairie.LiveTv.channelDisplayLabel({}), "Channel ")
            m.assertEqual(Prairie.LiveTv.playableLiveUrl({ transport: "hls", stream_url: " /api/v1/livetv/live-hls/s1/index.m3u8?st=x " }), "/api/v1/livetv/live-hls/s1/index.m3u8?st=x")
            m.assertEqual(Prairie.LiveTv.playableLiveUrl({ transport: "mpegts", stream_url: "/ts.ts" }), "/ts.ts")
            m.assertEqual(Prairie.LiveTv.playableLiveUrl({ hls_url: "/legacy.m3u8" }), invalid)
            m.assertEqual(Prairie.LiveTv.playableLiveUrl(invalid), invalid)
            m.assertEqual(Prairie.LiveTv.playableLiveUrl({ stream_url: " " }), invalid)
            m.assertEqual(Prairie.LiveTv.playableLiveUrl({}), invalid)
            m.assertTrue(Prairie.LiveTv.isHlsSession({ transport: "hls", stream_url: "/live.m3u8" }))
            m.assertFalse(Prairie.LiveTv.isHlsSession({ transport: "mpegts", stream_url: "/live.ts" }))
            m.assertTrue(Prairie.LiveTv.isHlsSession({ stream_url: "/api/v1/livetv/live-hls/s1/index.m3u8" }))
            m.assertFalse(Prairie.LiveTv.isHlsSession(invalid))
            m.assertEqual(Prairie.LiveTv.liveStreamFormat({ transport: "hls", stream_url: "/x.m3u8" }), "hls")
            m.assertEqual(Prairie.LiveTv.liveStreamFormat({ transport: "mpegts", stream_url: "/x.ts" }), "mpegts")
            ok = Prairie.LiveTv.resolveLivePlaybackUrl("https://prairie.example.com", "/live.m3u8", "tok", "p1")
            m.assertTrue(ok.ok)
            m.assertTrue(ok.url.instr("token=tok") >= 0)
            m.assertTrue(ok.url.instr("profile_id=p1") >= 0)
            sameOrigin = Prairie.LiveTv.resolveLivePlaybackUrl("https://prairie.example.com", "https://prairie.example.com/live.m3u8", invalid, invalid)
            m.assertTrue(sameOrigin.ok)
            empty = Prairie.LiveTv.resolveLivePlaybackUrl("https://prairie.example.com", "  ", "tok", invalid)
            m.assertFalse(empty.ok)
            m.assertEqual(empty.message, "Playback failed to start")
            bad = Prairie.LiveTv.resolveLivePlaybackUrl("https://prairie.example.com", "https://tuner.example/x", "tok", invalid)
            m.assertFalse(bad.ok)
            m.assertTrue(Prairie.LiveTv.liveSessionPath("s/1").instr("s%2F1") >= 0)
            m.assertEqual(Prairie.LiveTv.recordingsPath(), "/api/v2/livetv/recordings")
            m.assertTrue(Prairie.LiveTv.recordingPath("rec/1").instr("rec%2F1") >= 0)
            recs = Prairie.LiveTv.recordingsFromResponse({
                items: [{ id: "r1", title: "Show" }, { id: "r2" }]
            })
            m.assertEqual(recs.count(), 2)
            m.assertEqual(Prairie.LiveTv.recordingsFromResponse(invalid).count(), 0)
            m.assertEqual(Prairie.LiveTv.recordingsFromResponse({}).count(), 0)
            body = ParseJson(Prairie.LiveTv.buildScheduleRecordingBody({
                id: "p1",
                channel_id: "c1",
                start: "2020-01-01T01:00:00Z",
                stop: "2020-01-01T02:00:00Z",
                title: "Show"
            }))
            m.assertEqual(body.program_id, "p1")
            m.assertInvalid(body.channel_id)
            bodyByProgramId = ParseJson(Prairie.LiveTv.buildScheduleRecordingBody({ program_id: " p2 " }))
            m.assertEqual(bodyByProgramId.program_id, "p2")
            m.assertInvalid(Prairie.LiveTv.buildScheduleRecordingBody(invalid))
            m.assertInvalid(Prairie.LiveTv.buildScheduleRecordingBody({ id: "" }))
            m.assertInvalid(Prairie.LiveTv.buildScheduleRecordingBody({}))
            m.assertFalse(Prairie.LiveTv.programBelongsToChannel(invalid, "p1", "c1"))
            m.assertFalse(Prairie.LiveTv.programBelongsToChannel([], "", "c1"))
            m.assertFalse(Prairie.LiveTv.programBelongsToChannel([], "p1", ""))
            m.assertTrue(Prairie.LiveTv.programBelongsToChannel([
                { id: "p1", channel_id: "c1" }
            ], "p1", "c1"))
            m.assertFalse(Prairie.LiveTv.programBelongsToChannel([
                { id: "p1", channel_id: "c1" }
            ], "p1", "c2"))
        end sub

        @describe("guide helpers")
        @it("picks current and next programs from a guide window")
        sub _()
            programs = [
                { channel_id: "c1", start: "2020-01-01T00:00:00Z", stop: "2020-01-01T01:00:00Z", title: "Past" },
                { channel_id: "c1", start: "2020-01-01T01:00:00Z", stop: "2020-01-01T02:00:00Z", title: "Now" },
                { channel_id: "c1", start: "2020-01-01T02:00:00Z", stop: "2020-01-01T03:00:00Z", title: "Next" }
            ]
            ' 2020-01-01T01:30:00Z
            nowSec = Prairie.LiveTv.isoToSeconds("2020-01-01T01:30:00Z")
            current = Prairie.LiveTv.currentProgramForChannel(programs, "c1", nowSec)
            nextProgram = Prairie.LiveTv.nextProgramForChannel(programs, "c1", nowSec)
            m.assertEqual(current.title, "Now")
            m.assertEqual(nextProgram.title, "Next")
            m.assertEqual(Prairie.LiveTv.isoToSeconds(""), -1)
            m.assertEqual(Prairie.LiveTv.programsForChannel(invalid, "c1").count(), 0)
            m.assertEqual(Prairie.LiveTv.currentProgramForChannel([
                { channel_id: "c1", start: "", stop: "", title: "Bad" }
            ], "c1", nowSec), invalid)
            m.assertEqual(Prairie.LiveTv.nextProgramForChannel(programs, "missing", nowSec), invalid)
            upcoming = Prairie.LiveTv.activeOrUpcomingProgramsForChannel(programs, "c1", nowSec)
            m.assertEqual(upcoming.count(), 2)
            m.assertEqual(upcoming[0].title, "Now")
            m.assertEqual(upcoming[1].title, "Next")
            endedOnly = Prairie.LiveTv.activeOrUpcomingProgramsForChannel([
                { channel_id: "c1", start: "2020-01-01T00:00:00Z", stop: "2020-01-01T01:00:00Z", title: "Past" }
            ], "c1", nowSec)
            m.assertEqual(endedOnly.count(), 0)
        end sub

    end class
end namespace
