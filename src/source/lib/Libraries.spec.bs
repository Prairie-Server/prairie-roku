namespace tests
    @suite("Prairie.Libraries")
    class LibrariesSuite extends rooibos.BaseTestSuite

        @describe("librariesFromResponse")
        @it("accepts bare arrays and wrapped objects")
        sub _()
            bare = Prairie.Libraries.librariesFromResponse([{ id: 1, name: "Movies", type: "movie" }])
            m.assertEqual(bare.count(), 1)
            m.assertEqual(bare[0].name, "Movies")
            wrapped = Prairie.Libraries.librariesFromResponse({ libraries: [{ id: 2 }] })
            m.assertEqual(wrapped.count(), 1)
            m.assertEqual(wrapped[0].name, "Library")
            m.assertEqual(Prairie.Libraries.librariesFromResponse(invalid).count(), 0)
            m.assertEqual(Prairie.Libraries.librariesPath(), "/api/v1/user/libraries")
        end sub

    end class
end namespace
