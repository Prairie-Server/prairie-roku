import "pkg:/source/lib/UrlUtils.bs"
import "pkg:/source/lib/PlaybackSettings.bs"
import "pkg:/source/lib/QualityLadder.bs"

namespace Prairie.Playback

    function startPath() as string
        return "/api/v1/playback/start"
    end function

    function transcodeStartPath() as string
        return "/api/v1/playback/transcode/start"
    end function

    function qualityLadderPath() as string
        return Prairie.QualityLadder.qualityLadderPath()
    end function

    function progressPath(sessionId as string) as string
        return "/api/v1/playback/" + sessionId.encodeUriComponent() + "/progress"
    end function

    function sessionPath(sessionId as string) as string
        return "/api/v1/playback/" + sessionId.encodeUriComponent()
    end function

    function audioPath(sessionId as string) as string
        return "/api/v1/playback/" + sessionId.encodeUriComponent() + "/audio"
    end function

    function defaultCapabilities() as object
        return {
            codecs_video: ["h264", "hevc"],
            codecs_audio: ["aac", "ac3", "eac3", "mp3"],
            containers: ["mp4", "mpegts", "hls", "mkv"],
            max_resolution: "2160p",
            hdr: true
        }
    end function

    function needsHlsBootstrap(playMethod as dynamic) as boolean
        if playMethod = invalid
            return false
        end if
        method = LCase((playMethod as string).trim())
        return method = "remux" or method = "transcode"
    end function

    function buildStartBody(input as object) as string
        caps = defaultCapabilities()
        body = {
            protocol_version: 3,
            client_features: ["playback_plan_v3", "neutral_playback_v3_contract_v1", "embedded_subtitles_v1"],
            file_id: input.fileId as integer,
            profile_id: input.profileId as string,
            playback_attempt_id: newRequestId(),
            quality_preference: "auto",
            subtitle_fidelity_preference: "compatible",
            progress_persistence: "server",
            metered: false,
            client_capabilities: buildClientCapabilities(caps),
            client_playback_context: buildClientPlaybackContext()
        }
        if input.forcedPlayMethod <> invalid and (input.forcedPlayMethod as string).len() > 0
            forced = LCase(input.forcedPlayMethod as string)
            if forced = "direct"
                body.quality_preference = "original"
                body.client_playback_context.deliveries.progressive.enabled = false
                body.client_playback_context.deliveries.hls.enabled = false
            else if forced = "transcode"
                body.client_playback_context.deliveries.original_http.enabled = false
                body.client_playback_context.deliveries.progressive.enabled = false
            else if forced = "remux"
                body.client_playback_context.deliveries.original_http.enabled = false
            end if
        end if
        if input.startPosition <> invalid and (input.startPosition as float) > 0
            body.start_position = input.startPosition as float
        end if
        return FormatJson(body)
    end function

    function buildClientCapabilities(caps as object) as object
        return {
            video_evidence: "declared",
            audio_evidence: "declared",
            codecs_video: caps.codecs_video,
            codecs_video_hardware: caps.codecs_video,
            codecs_audio: caps.codecs_audio,
            containers: caps.containers,
            max_resolution: caps.max_resolution,
            hdr: caps.hdr,
            hdr_details: {
                hdr10: caps.hdr,
                hdr10_plus: false,
                hlg: false,
                dolby_vision_profiles: []
            }
        }
    end function

    function buildClientPlaybackContext() as object
        appInfo = CreateObject("roAppInfo")
        version = "1.0.0"
        if appInfo <> invalid and appInfo.GetVersion() <> invalid
            version = appInfo.GetVersion()
        end if
        return {
            protocol_version: 3,
            form_factor: "tv",
            app_version: version,
            app_channel: "release",
            device: {
                platform: "roku"
            },
            output: {
                sink_type: "display",
                hdr_details: {
                    hdr10: true,
                    hdr10_plus: false,
                    hlg: false,
                    dolby_vision_profiles: []
                }
            },
            deliveries: {
                original_http: {
                    enabled: true,
                    supported_on_device: true,
                    containers: ["mp4", "mpegts", "hls", "mkv"],
                    video_codecs: ["h264", "hevc"],
                    audio_decode_codecs: ["aac", "ac3", "eac3", "mp3"],
                    audio_passthrough_codecs: [],
                    max_channels: 6,
                    subtitles: { embedded_text: false, sidecar_text: false, ass_styling: false, embedded_bitmap: false, sidecar_bitmap: false, font_attachments: false },
                    features: [], auth_header_refresh: false, validated_claims: [], transformations: []
                },
                progressive: {
                    enabled: true,
                    supported_on_device: true,
                    containers: ["mp4", "mpegts", "hls", "mkv"],
                    video_codecs: ["h264", "hevc"],
                    audio_decode_codecs: ["aac", "ac3", "eac3", "mp3"],
                    audio_passthrough_codecs: [],
                    max_channels: 6,
                    subtitles: { embedded_text: false, sidecar_text: false, ass_styling: false, embedded_bitmap: false, sidecar_bitmap: false, font_attachments: false },
                    features: [], auth_header_refresh: false, validated_claims: [], transformations: []
                },
                hls: {
                    enabled: true,
                    supported_on_device: true,
                    containers: ["hls"],
                    video_codecs: ["h264", "hevc"],
                    audio_decode_codecs: ["aac", "ac3", "eac3", "mp3"],
                    audio_passthrough_codecs: [],
                    max_channels: 6,
                    subtitles: { embedded_text: false, sidecar_text: false, ass_styling: false, embedded_bitmap: false, sidecar_bitmap: false, font_attachments: false },
                    features: [], auth_header_refresh: false, validated_claims: [], transformations: []
                }
            }
        }
    end function

    function newRequestId() as string
        clock = CreateObject("roDateTime")
        return "roku-" + clock.AsSeconds().toStr() + "-" + Rnd(999999).toStr()
    end function

    function normalizeStartResponse(data as object) as object
        if data = invalid or data.playback_plan = invalid
            return data
        end if
        plan = data.playback_plan
        delivery = ""
        if plan.delivery <> invalid
            delivery = LCase(plan.delivery as string)
        end if
        playMethod = "transcode"
        if delivery = "original_http"
            playMethod = "direct"
        else if delivery = "server_remux_progressive"
            playMethod = "remux"
        end if
        streamUrl = ""
        streamProtocol = "hls"
        if plan.stream <> invalid
            if plan.stream.url <> invalid
                streamUrl = plan.stream.url as string
            end if
            if plan.stream.protocol <> invalid
                streamProtocol = plan.stream.protocol as string
            end if
        end if
        position = 0
        streamOrigin = 0
        if plan.timeline <> invalid
            if plan.timeline.player_start_seconds <> invalid
                position = plan.timeline.player_start_seconds as float
            end if
            if plan.timeline.stream_origin_seconds <> invalid
                streamOrigin = plan.timeline.stream_origin_seconds as float
                position = position + streamOrigin
            end if
        end if
        audioIndex = 0
        if plan.selected_tracks <> invalid and plan.selected_tracks.audio <> invalid and plan.selected_tracks.audio.index <> invalid
            audioIndex = plan.selected_tracks.audio.index as integer
        end if
        duration = invalid
        if plan.source <> invalid and plan.source.duration_seconds <> invalid
            duration = plan.source.duration_seconds
        end if
        return {
            session_id: data.session_id,
            media_file_id: plan.effective_media_file_id,
            play_method: playMethod,
            position: position,
            is_paused: false,
            stream_url: streamUrl,
            audio_track_index: audioIndex,
            duration_seconds: duration,
            playback_info: {
                stream_type: streamProtocol,
                can_seek_anywhere: plan.timeline <> invalid and plan.timeline.can_seek_anywhere = true,
                transcode_audio: playMethod = "transcode",
                video_codec: plan.effective_recipe <> invalid and plan.effective_recipe.video_codec,
                audio_codec: plan.effective_recipe <> invalid and plan.effective_recipe.audio_codec
            },
            is_protocol_v3: true,
            playback_attempt_id: data.playback_attempt_id,
            plan_id: plan.plan_id,
            plan_attempt_key: plan.plan_attempt_key,
            attempted_plan_keys: [plan.plan_attempt_key]
        }
    end function

    function buildReplanBody(playback as object, qualityPreference as string, positionSeconds as float) as string
        attemptId = playback.playback_attempt_id as string
        planId = playback.plan_id as string
        planKey = playback.plan_attempt_key as string
        body = {
            protocol_version: 3,
            client_features: ["playback_plan_v3", "neutral_playback_v3_contract_v1", "embedded_subtitles_v1"],
            operation: "quality_change",
            playback_attempt_id: attemptId,
            replan_request_id: newRequestId(),
            failed_plan_id: planId,
            plan_attempt_id: newRequestId(),
            plan_attempt_key: planKey,
            attempted_plan_keys: playback.attempted_plan_keys,
            attempt_count: 1,
            quality_preference: qualityPreference,
            position_seconds: positionSeconds,
            metered: false,
            selected_tracks: {},
            client_capabilities: buildClientCapabilities(defaultCapabilities()),
            client_playback_context: buildClientPlaybackContext()
        }
        return FormatJson(body)
    end function

    function applyReplanResponse(playback as object, data as object) as object
        nextPlayback = normalizeStartResponse(data)
        if nextPlayback = invalid
            return playback
        end if
        if nextPlayback.session_id = invalid or (nextPlayback.session_id as string).len() = 0
            nextPlayback.session_id = playback.session_id
        end if
        keys = []
        if playback.attempted_plan_keys <> invalid
            for each key in playback.attempted_plan_keys
                keys.push(key)
            end for
        end if
        if nextPlayback.plan_attempt_key <> invalid
            found = false
            for each key in keys
                if key = nextPlayback.plan_attempt_key
                    found = true
                    exit for
                end if
            end for
            if not found
                keys.push(nextPlayback.plan_attempt_key)
            end if
        end if
        nextPlayback.attempted_plan_keys = keys
        return nextPlayback
    end function

    function buildTranscodeStartBody(input as object) as string
        playMethod = ""
        if input.playMethod <> invalid
            playMethod = LCase((input.playMethod as string).trim())
        end if
        isRemux = playMethod = "remux"
        seekSeconds = 0
        if input.seekSeconds <> invalid
            seekSeconds = input.seekSeconds
        end if

        ' Explicit quality targets from the picker / Auto ladder.
        hasTargets = false
        targetResolution = ""
        targetBitrate = 0
        copyVideo = false
        if input.targetResolution <> invalid
            hasTargets = true
            targetResolution = input.targetResolution as string
        end if
        if input.targetBitrateKbps <> invalid
            hasTargets = true
            targetBitrate = input.targetBitrateKbps as integer
        end if
        if input.copyVideo = true
            hasTargets = true
            copyVideo = true
        end if

        body = {
            session_id: input.sessionId as string,
            seek_seconds: seekSeconds,
            target_resolution: "",
            target_codec_video: "copy",
            target_codec_audio: "copy",
            target_bitrate_kbps: 0,
            segment_duration: 2,
            subtitle_track_index: -1,
            subtitle_burn_in: false
        }

        if hasTargets
            if copyVideo
                body.target_resolution = ""
                body.target_codec_video = "copy"
                body.target_codec_audio = "aac"
                body.target_bitrate_kbps = 0
            else
                body.target_resolution = targetResolution
                body.target_codec_video = "h264"
                body.target_codec_audio = "aac"
                body.target_bitrate_kbps = targetBitrate
            end if
        else if isRemux
            ' Default remux bootstrap: codec copy.
            body.target_codec_video = "copy"
            body.target_codec_audio = "copy"
            body.target_bitrate_kbps = 0
        else
            ' Legacy fallback when no ladder targets were supplied.
            body.target_resolution = "1080p"
            body.target_codec_video = "h264"
            body.target_codec_audio = "aac"
            body.target_bitrate_kbps = 6000
        end if
        return FormatJson(body)
    end function

    function buildProgressBody(position as float, isPaused as boolean) as string
        return FormatJson({
            position: position,
            is_paused: isPaused
        })
    end function

    function buildAudioBody(audioTrackIndex as integer, position as float) as string
        return FormatJson({
            audio_track_index: audioTrackIndex,
            position: position
        })
    end function

    function resolveStreamUrl(serverUrl as string, playback as object, accessToken as string) as string
        stream = ""
        if playback <> invalid
            ' Prefer HLS manifest from transcode/start when present.
            if playback.manifest_url <> invalid and (playback.manifest_url as string).len() > 0
                stream = playback.manifest_url as string
            else if playback.stream_url <> invalid
                stream = playback.stream_url as string
            end if
        end if
        return Prairie.Url.buildStreamUrl(serverUrl, stream, accessToken, invalid)
    end function

    function applyTranscodeResponse(playback as object, transcode as object) as object
        if playback = invalid or transcode = invalid
            return playback
        end if
        nextPlayback = {}
        for each key in playback
            nextPlayback[key] = playback[key]
        end for
        if transcode.session_id <> invalid
            nextPlayback.session_id = transcode.session_id
        end if
        if transcode.manifest_url <> invalid
            nextPlayback.stream_url = transcode.manifest_url
            nextPlayback.manifest_url = transcode.manifest_url
        end if
        if transcode.duration_seconds <> invalid
            nextPlayback.duration_seconds = transcode.duration_seconds
        end if
        if transcode.player_start_seconds <> invalid
            nextPlayback.position = transcode.player_start_seconds
            nextPlayback.player_start_seconds = transcode.player_start_seconds
        end if
        canSeek = false
        if transcode.can_seek_anywhere = true
            canSeek = true
        end if
        if canSeek
            nextPlayback.play_method = "transcode"
        else
            nextPlayback.play_method = "remux"
        end if
        info = {}
        if playback.playback_info <> invalid
            for each key in playback.playback_info
                info[key] = playback.playback_info[key]
            end for
        end if
        info.stream_type = "hls"
        info.can_seek_anywhere = canSeek
        nextPlayback.playback_info = info
        return nextPlayback
    end function

    function detectStreamFormat(playback as object) as string
        if playback = invalid
            return "hls"
        end if
        streamType = ""
        if playback.playback_info <> invalid and playback.playback_info.stream_type <> invalid
            streamType = LCase(playback.playback_info.stream_type as string)
        end if
        if streamType = "hls" or streamType = "mpegts"
            return "hls"
        end if
        if streamType = "mp4" or streamType = "dash"
            return streamType
        end if
        url = ""
        if playback.manifest_url <> invalid and (playback.manifest_url as string).len() > 0
            url = LCase(playback.manifest_url as string)
        else if playback.stream_url <> invalid
            url = LCase(playback.stream_url as string)
        end if
        if url.instr(".m3u8") >= 0 or url.instr("hls") >= 0
            return "hls"
        end if
        if url.instr(".mp4") >= 0
            return "mp4"
        end if
        if url.instr(".mpd") >= 0
            return "dash"
        end if
        return "hls"
    end function

    function resumeSeconds(watch as object) as dynamic
        if watch = invalid or watch.user_data = invalid
            return invalid
        end if
        position = watch.user_data.position_seconds
        if position = invalid or (position as float) <= 0
            return invalid
        end if
        duration = watch.user_data.duration_seconds
        if duration <> invalid and (duration as float) > 0
            if (position as float) / (duration as float) >= 0.95
                return invalid
            end if
        end if
        return CInt(position as float)
    end function

    function forcedPlayMethodFromStore(store as object) as dynamic
        settings = Prairie.PlaybackSettings.load(store)
        return Prairie.PlaybackSettings.resolveForcedPlayMethod(settings)
    end function

end namespace
