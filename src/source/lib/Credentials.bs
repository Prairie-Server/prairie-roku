import "pkg:/source/lib/ServerRegistry.bs"
import "pkg:/source/lib/UrlUtils.bs"

' The signed-in session this Roku keeps per server so a relaunch can skip
' sign-in, as the Android TV and Apple TV clients keep theirs: the refresh
' token (rotated on every use) and the username. Never the password, and
' never an access or profile token; those live in memory only.
'
' Kept apart from the server registry, which never holds secrets. The Roku
' registry is private to this channel but not encrypted at rest.
namespace Prairie.Credentials

    function storageKey() as string
        return "prairie.credentials"
    end function

    function refreshPath() as string
        return "/api/v1/auth/refresh"
    end function

    function buildRefreshBody(refreshToken as string) as string
        return FormatJson({
            refresh_token: refreshToken
        })
    end function

    function loadAll(store as object) as object
        raw = store.getItem(storageKey())
        if raw = invalid or (raw as string).trim().len() = 0
            return {}
        end if
        parsed = ParseJson(raw as string)
        if parsed = invalid or type(parsed) <> "roAssociativeArray" or type(parsed.servers) <> "roAssociativeArray"
            return {}
        end if
        return parsed.servers
    end function

    function saveAll(servers as object, store as object) as boolean
        saved = store.setItem(storageKey(), FormatJson({ servers: servers }))
        return saved = true
    end function

    ' { refreshToken, username } for the server at url, or invalid.
    function forServer(store as object, url as string) as dynamic
        id = Prairie.ServerRegistry.entryIdFromUrl(url)
        if id.len() = 0
            return invalid
        end if
        servers = loadAll(store)
        entry = servers[id]
        if entry = invalid or type(entry) <> "roAssociativeArray" or entry.refreshToken = invalid
            return invalid
        end if
        token = (entry.refreshToken as string).trim()
        if token.len() = 0
            return invalid
        end if
        username = ""
        if entry.username <> invalid
            username = entry.username as string
        end if
        return {
            refreshToken: token,
            username: username
        }
    end function

    ' Keep the session for url. A blank token clears it instead.
    function remember(store as object, url as string, refreshToken as dynamic, username as string) as boolean
        id = Prairie.ServerRegistry.entryIdFromUrl(url)
        if id.len() = 0
            return false
        end if
        token = ""
        if refreshToken <> invalid
            token = (refreshToken as string).trim()
        end if
        if token.len() = 0
            return forget(store, url)
        end if
        servers = loadAll(store)
        servers[id] = {
            refreshToken: token,
            username: username
        }
        return saveAll(servers, store)
    end function

    ' Drop the saved session for url (sign-out, a removed server, a session
    ' the server no longer accepts).
    function forget(store as object, url as string) as boolean
        id = Prairie.ServerRegistry.entryIdFromUrl(url)
        servers = loadAll(store)
        if id.len() = 0 or not servers.doesExist(id)
            return true
        end if
        servers.delete(id)
        return saveAll(servers, store)
    end function

    ' Parse POST /auth/refresh: { ok, accessToken, refreshToken }.
    function parseRefresh(data as dynamic) as object
        if data = invalid or type(data) <> "roAssociativeArray" or data.access_token = invalid
            return { ok: false }
        end if
        access = (data.access_token as string).trim()
        if access.len() = 0
            return { ok: false }
        end if
        refresh = ""
        if data.refresh_token <> invalid
            refresh = (data.refresh_token as string).trim()
        end if
        return {
            ok: true,
            accessToken: access,
            refreshToken: refresh
        }
    end function

    ' True when a failed refresh means the saved session is gone (sign in
    ' again); false for a network or server problem worth retrying later.
    function isSessionRejected(status as integer) as boolean
        return status = 400 or status = 401 or status = 403 or status = 404 or status = 422
    end function

    ' Notice for the sign-in screen after a saved session didn't resume.
    function resumeFailedMessage(serverName as string, rejected as boolean) as string
        name = serverName.trim()
        if name.len() = 0
            name = "this server"
        end if
        if rejected
            return "You were signed out of " + name + ". Sign in again."
        end if
        return "Can't reach " + name + ". Check this TV's connection."
    end function

end namespace
