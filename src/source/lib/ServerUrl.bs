import "pkg:/source/lib/UrlUtils.bs"

namespace Prairie.ServerUrl

    function stripPort(hostPart as string) as string
        host = hostPart.trim()
        if host.len() = 0
            return ""
        end if
        ' Preserve bracketed IPv6: [::1]:8096 → ::1
        if host.left(1) = "["
            close = host.instr("]")
            if close > 0
                return host.mid(1, close - 1)
            end if
            return host
        end if
        ' IPv4 / hostname:port — strip trailing :digits (not bare IPv6).
        colon = host.instr(":")
        if colon >= 0
            maybePort = host.mid(colon + 1)
            if maybePort.len() > 0 and isDigits(maybePort)
                return host.left(colon)
            end if
        end if
        return host
    end function

    function isDigits(value as string) as boolean
        if value.len() = 0
            return false
        end if
        for i = 0 to value.len() - 1
            ch = Asc(value.mid(i, 1))
            if ch < 48 or ch > 57
                return false
            end if
        end for
        return true
    end function

    function isIpv4Literal(host as string) as boolean
        parts = host.split(".")
        if parts.count() <> 4
            return false
        end if
        for each part in parts
            if part.len() = 0 or part.len() > 3
                return false
            end if
            for i = 0 to part.len() - 1
                ch = Asc(part.mid(i, 1))
                if ch < 48 or ch > 57
                    return false
                end if
            end for
            value = part.toInt()
            if value < 0 or value > 255
                return false
            end if
            ' Reject leading-zero tricks like 010.0.0.1 as non-canonical; still numeric.
        end for
        return true
    end function

    function isPrivateIpv4(host as string) as boolean
        parts = host.split(".")
        a = parts[0].toInt()
        b = parts[1].toInt()
        if a = 10
            return true
        end if
        if a = 192 and b = 168
            return true
        end if
        if a = 172 and b >= 16 and b <= 31
            return true
        end if
        if a = 127
            return true
        end if
        return false
    end function

    function isPrivateOrLocalHost(hostPart as string) as boolean
        host = LCase(stripPort(hostPart))
        if host.len() = 0
            return false
        end if
        if host = "localhost" or host = "::1"
            return true
        end if
        if host.right(6) = ".local"
            return true
        end if
        if isIpv4Literal(host)
            return isPrivateIpv4(host)
        end if
        return false
    end function

    function hasUsableHost(hostPart as string) as boolean
        host = hostPart.trim()
        if host.len() = 0
            return false
        end if
        if host.left(1) = "?" or host.left(1) = "#" or host.left(1) = ":"
            return false
        end if
        if host.left(1) = "[" and host.instr("]") < 0
            return false
        end if
        return true
    end function

    ' Validate a user-entered Prairie server base URL.
    ' Returns { ok: true, url: string } or { ok: false, message: string }.
    ' HTTP is only allowed for private/LAN hosts; public hosts require HTTPS.
    function validate(raw as string) as object
        trimmed = Prairie.Url.normalizeServerUrl(raw)
        if trimmed.len() = 0
            return {
                ok: false,
                message: "Enter your Prairie server URL"
            }
        end if

        lower = LCase(trimmed)
        isHttps = lower.left(8) = "https://"
        isHttp = lower.left(7) = "http://"
        if not isHttps and not isHttp
            return {
                ok: false,
                message: "Server URL must use http or https"
            }
        end if

        rest = trimmed
        if isHttps
            rest = trimmed.mid(8)
        else
            rest = trimmed.mid(7)
        end if
        at = rest.instr("@")
        slash = rest.instr("/")
        if at >= 0 and (slash < 0 or at < slash)
            return {
                ok: false,
                message: "Server URL must not include credentials"
            }
        end if

        hostPart = rest
        if slash >= 0
            hostPart = rest.left(slash)
        end if
        if not hasUsableHost(hostPart)
            return {
                ok: false,
                message: "Server URL must be a valid http(s) address"
            }
        end if

        if isHttp and not isPrivateOrLocalHost(hostPart)
            return {
                ok: false,
                message: "Use HTTPS, or HTTP only for a local/LAN server"
            }
        end if

        return {
            ok: true,
            url: trimmed
        }
    end function

end namespace
