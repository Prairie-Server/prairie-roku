    end if
    m.pending = "collectionsLibraries"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Libraries.librariesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadNextLibraryCollections()
    if m.collectionLibraryQueue.count() = 0
        loadPersonalCollections()
        return
    end if
    library = m.collectionLibraryQueue.shift()
    m.pendingLibraryId = library.id
    m.pending = "libraryCollections"
    path = Prairie.Collections.libraryCollectionsPath(library.id)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub loadPersonalCollections()
    m.pending = "personalCollections"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Collections.personalCollectionsPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub finishCollectionsScreen()
    if m.screen = invalid or m.route <> "collections"
        return
    end if
    m.screen.busy = false
    m.screen.libraryCollections = m.libraryCollectionCards
    m.screen.personalCollections = m.personalCollectionCards
    m.screen.callFunc("focusDefault")
end sub

sub onProfileChosen()
    profile = m.screen.selectedProfile
    if profile = invalid
        return
    end if
    if profile.has_pin = true
        askProfilePin(profile)
        return
    end if
    finishProfile(profile, invalid)
end sub

sub askProfilePin(profile as object)
    m.pinProfile = profile
    m.screen.pinProfileName = profile.name
    m.screen.pinMode = true
end sub

sub onPinSubmit()
    payload = m.screen.pinSubmit
    if payload = invalid or m.pinProfile = invalid or m.auth = invalid
        return
    end if
    m.pending = "verifyPin"
    m.screen.busy = true
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken
    }, Prairie.Auth.verifyPinPath(m.pinProfile.id), "POST", Prairie.Auth.buildVerifyPinBody(payload.pin))
    m.httpTask.control = "RUN"
end sub

sub finishProfile(profile as object, profileToken as dynamic)
    if m.auth = invalid
        return
    end if
    session = {
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken,
        username: m.auth.username,
        profileId: profile.id as string
    }
    if profile.name <> invalid
        session.profileName = profile.name as string
    end if
    if profileToken <> invalid
        session.profileToken = profileToken as string
    end if
    m.session = Prairie.Session.saveSession(session, m.store)
    m.registry = Prairie.ServerRegistry.rememberSession(m.registry, m.session, "")
    Prairie.ServerRegistry.save(m.registry, m.store)
    Prairie.Persist.saveLastServerUrl(m.session.serverUrl, m.store)
    ' A new sign-in (or a renewed one) is kept so the next launch skips it.
    if m.auth.refreshToken <> invalid and (m.auth.refreshToken as string).len() > 0
        Prairie.Credentials.remember(m.store, m.auth.serverUrl, m.auth.refreshToken, m.auth.username)
    end if
    m.pinProfile = invalid
    if m.profileLaunch.rememberOfferPending = true
        showRememberOffer(session.profileName)
        return
    end if
    showHome()
end sub

' First profile picked on this TV: offer to open it automatically from now
' on (Apple TV / Android TV). Remember has focus; Back is Ask Every Time.
' Shown over Who's Watching, which waits idle until it is answered.
sub showRememberOffer(profileName as dynamic)
    name = ""
    if profileName <> invalid
        name = profileName as string
    end if
    dialog = CreateObject("roSGNode", "Dialog")
    dialog.title = Prairie.ProfileLaunch.offerTitle(name)
    dialog.message = Prairie.ProfileLaunch.offerMessage()
    dialog.buttons = Prairie.ProfileLaunch.offerButtons()
    dialog.focusButton = Prairie.ProfileLaunch.offerFocusIndex()
    dialog.observeField("buttonSelected", "onRememberOfferButton")
    dialog.observeField("wasClosed", "onRememberOfferClosed")
    m.rememberOfferDialog = dialog
    m.top.dialog = dialog
end sub

sub onRememberOfferButton()
    dialog = m.rememberOfferDialog
    if dialog = invalid
        return
    end if
    m.rememberOfferDialog = invalid
    remember = Prairie.ProfileLaunch.offerRemembers(dialog.buttonSelected)
    dialog.close = true
    answerRememberOffer(remember)
end sub

sub onRememberOfferClosed()
    if m.rememberOfferDialog = invalid
        return
    end if
    m.rememberOfferDialog = invalid
    answerRememberOffer(false)
end sub

sub answerRememberOffer(remember as boolean)
    m.profileLaunch = Prairie.ProfileLaunch.answeringOffer(m.profileLaunch, remember)
    Prairie.ProfileLaunch.save(m.profileLaunch, m.store)
    if m.session <> invalid
        showHome()
    end if
end sub

sub onProfilesCancel()
    if m.profilesBackRoute = "home" and m.session <> invalid
        m.auth = invalid
        showHome()
        return
    end if
    Prairie.Session.clearSession(m.store)
    if m.registry.entries.count() > 0
        showServerList("connect")
    else
        showConnect()
    end if
end sub

' Sign Out asks first, as on Android TV / Apple TV: Cancel, Sign Out (keep
' the server and open its sign-in), or Sign Out & Remove Server.
sub onSignOut()
    if m.signOutTask <> invalid or m.session = invalid
        return
    end if
    dialog = CreateObject("roSGNode", "Dialog")
    dialog.title = Prairie.SignOut.dialogTitle()
    dialog.message = Prairie.SignOut.dialogMessage()
    dialog.buttons = Prairie.SignOut.dialogLabels()
    dialog.observeField("buttonSelected", "onSignOutDialogButton")
    m.signOutDialog = dialog
    m.top.dialog = dialog
end sub

sub onSignOutDialogButton()
    if m.signOutDialog = invalid
        return
    end if
    choice = Prairie.SignOut.choiceAt(m.signOutDialog.buttonSelected)
    m.signOutDialog.close = true
    m.signOutDialog = invalid
    if choice = "keep"
        startSignOut(false)
    else if choice = "remove"
        startSignOut(true)
    end if
end sub

' Revoke the login on the server (best effort, bounded), then sign out here.
' Runs on its own task so leaving the screen can't stop it halfway; a second
' request while one runs is ignored.
sub startSignOut(removeServer as boolean)
    if m.signOutTask <> invalid or m.session = invalid
        return
    end if
    m.signOutTarget = {
        serverUrl: m.session.serverUrl as string,
        accessToken: m.session.accessToken,
        removeServer: removeServer
    }
    task = CreateObject("roSGNode", "HttpTask")
    task.observeField("response", "onSignOutResponse")
    m.signOutTask = task
    task.request = Prairie.Api.buildRequest({
        serverUrl: m.signOutTarget.serverUrl,
        accessToken: m.signOutTarget.accessToken,
        timeoutMs: Prairie.SignOut.logoutTimeoutMs()
    }, Prairie.SignOut.logoutPath(), "POST", "{}")
    task.control = "RUN"
end sub

sub onSignOutResponse()
    target = m.signOutTarget
    if m.signOutTask <> invalid
        m.signOutTask.unobserveField("response")
        m.signOutTask.control = "STOP"
    end if
    m.signOutTask = invalid
    m.signOutTarget = invalid
    if target = invalid
        return
    end if
    ' The account that leaves is the one active when Sign Out was chosen.
    if m.session = invalid or (m.session.serverUrl as string) <> target.serverUrl or m.session.accessToken <> target.accessToken
        showMessage("Sign Out", Prairie.SignOut.sessionChangedMessage())
        return
    end if
    result = Prairie.SignOut.finish(m.registry, m.store, target.serverUrl, target.removeServer = true)
    m.registry = result.registry
    m.session = invalid
    m.auth = invalid
    m.connectPrefillUrl = result.prefillUrl
    m.connectNotice = result.notice
    showConnect()
end sub

' "Change server" on the sign-in screen: a server this TV never signed in to
' is forgotten first, so it stops coming back as the server to sign in to.
' Ignored while a sign-in is running.
sub onOpenServers()
    if m.route = "connect" and m.screen <> invalid
        if m.screen.busy = true or m.pending = "login"
            return
        end if
        url = m.screen.initialServerUrl
        if url <> invalid and (url as string).trim().len() > 0
            stopQuickConnect()
            forgotten = Prairie.ServerRegistry.forgetIfNeverSignedIn(m.registry, m.store, url as string)
            if forgotten.removed
                Prairie.Credentials.forget(m.store, url as string)
            end if
            if forgotten.saved
                m.registry = forgotten.registry
            else
                ' A failed write keeps the server; leave anyway, as before.
                m.registry = Prairie.ServerRegistry.load(m.store)
            end if
        end if
    end if
    showServerList("connect")
end sub

sub onConnectScanRequested()
    showServerList("connect")
    startDiscovery(true)
end sub

sub onServerScanRequested()
    startDiscovery(true)
end sub

sub onServerAddManual()
    stopDiscovery()
    showConnect()
end sub

sub onServerListBack()
    stopDiscovery()
    if m.serverListBackRoute = "home" and m.session <> invalid
        showHome()
    else
        showConnect()
    end if
end sub

sub onServerSelected()
    entry = m.screen.selectedServer
    if entry = invalid or entry.id = invalid
        return
    end if
    stopDiscovery()
    m.registry = Prairie.ServerRegistry.load(m.store)
    idx = Prairie.ServerRegistry.findIndex(m.registry, entry.id)
    if idx < 0
        return
    end if
    full = m.registry.entries[idx]
    m.registry = Prairie.ServerRegistry.switchTo(m.registry, full.id)
    Prairie.ServerRegistry.save(m.registry, m.store)
    session = Prairie.ServerRegistry.sessionFromEntry(full)
    if session <> invalid
        m.session = Prairie.Session.saveSession(session, m.store)
        Prairie.Persist.saveLastServerUrl(session.serverUrl, m.store)
        showHome()
        return
    end if
    if resumeSavedSession(full.url as string)
        return
    end if
    m.connectPrefillUrl = full.url
    showConnect()
end sub

sub onDiscoverySelected()
    hit = m.screen.selectedDiscovery
    if hit = invalid or hit.url = invalid
        return
    end if
    stopDiscovery()
    m.connectPrefillUrl = hit.url as string
    if hit.serverName <> invalid and (hit.serverName as string).trim().len() > 0
        m.registry = Prairie.ServerRegistry.addOrUpdate(m.registry, {
            url: hit.url,
            fetchedName: hit.serverName as string
        })
        Prairie.ServerRegistry.save(m.registry, m.store)
    end if
    showConnect()
end sub

sub onServerRemoveRequested()
    entry = m.screen.removeRequested
    if entry = invalid or entry.id = invalid
        return
    end if
    idx = Prairie.ServerRegistry.findIndex(m.registry, entry.id)
    if idx >= 0
        ' Removing a server always ends its saved session on this TV.
        Prairie.Credentials.forget(m.store, m.registry.entries[idx].url as string)
    end if
    removed = Prairie.ServerRegistry.remove(m.registry, entry.id)
    saved = Prairie.ServerRegistry.save(removed, m.store)
    paintServerList()
    if not saved
        m.screen.errorText = Prairie.SignOut.removeServerFailedMessage()
    else
        m.screen.errorText = ""
    end if
    m.screen.callFunc("focusDefault")
end sub

sub onHomeItemSelected()
    contentId = m.screen.selectedContentId
    if contentId = invalid or contentId.len() = 0
        return
    end if
    m.homeReturnFocus = m.screen.lastRowItem
    m.detailChain = invalid
    showItemDetail(contentId)
end sub

sub onHomeExploreSection()
    section = m.screen.exploreSection
    if section = invalid or section.id = invalid or (section.id as string).len() = 0
        return
