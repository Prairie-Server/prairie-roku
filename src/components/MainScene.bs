sub showProfileMenu()
    dialog = CreateObject("roSGNode", "Dialog")
    title = "Profile"
    if m.session <> invalid and m.session.profileName <> invalid and (m.session.profileName as string).len() > 0
        title = m.session.profileName as string
    end if
    dialog.title = title
    dialog.buttons = Prairie.Nav.profileMenuLabels(m.requestsEnabled)
    dialog.observeField("buttonSelected", "onProfileMenuButton")
    m.profileMenuDialog = dialog
    m.top.dialog = dialog
end sub

sub onProfileMenuButton()
    if m.profileMenuDialog = invalid
        return
    end if
    choice = Prairie.Nav.profileMenuIdAt(m.profileMenuDialog.buttonSelected, m.requestsEnabled)
    m.profileMenuDialog.close = true
    m.profileMenuDialog = invalid
    if choice = "switchProfile"
        switchProfile()
    else if choice = "requests"
        showRequestsHub()
    else if choice = "settings"
        showSettings()
    else if choice = "switchServer"
        showServerList("home")
    else if choice = "signOut"
        onSignOut()
    end if
end sub

' Re-open the profile picker on the signed-in account; cancelling returns home.
sub switchProfile()
    if m.session = invalid
        return
    end if
    username = ""
    if m.session.username <> invalid
        username = m.session.username as string
    end if
    m.auth = {
        serverUrl: m.session.serverUrl,
        accessToken: m.session.accessToken,
        username: username
    }
    showProfiles("home")
end sub

