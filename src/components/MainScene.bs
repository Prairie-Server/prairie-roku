' More Like This: the first pick pushes, later picks replace the page the
' rail opened, so Back returns to the starting title in two steps.
sub onDetailSimilarSelected()
    picked = m.screen.similarSelected
    if picked = invalid or ratingInFlight()
        return
    end if
    result = Prairie.DetailChain.pick(m.detailChain, m.detailContentId, m.detailBackRoute, picked)
    if result.action = "ignore"
        return
    end if
    m.detailChain = result.chain
    showItemDetail(result.contentId, result.backRoute)
end sub

sub onDetailBack()
    origin = Prairie.DetailChain.back(m.detailChain)
    if origin <> invalid
        m.detailChain = invalid
        showItemDetail(origin.contentId, origin.backRoute)
        return
    end if
    back = m.detailBackRoute
    if back = "section" and m.browseSection <> invalid
        showSectionBrowse(m.browseSection)
    else if back = "tab" and m.browseTab <> invalid
        showTabBrowse()
    else if back = "library" and m.browseLibrary <> invalid
        showLibraryBrowse(m.browseLibrary)
    else if back = "collection" and m.browseCollection <> invalid
        showCollectionBrowse(m.browseCollection)
    else if back = "search"
        showSearch()
    else if back = "foryou"
        showForYou()
    else if back = "calendar"
        showCalendar()
    else if back = "boxset" and m.boxSetPage <> invalid
        showBoxSet(m.boxSetPage)
    else if back = "requestsHub"
        showRequestsHub()
    else if back = "requestsRow" and m.requestsRow <> invalid
        showRequestsRow(m.requestsRow)
    else if back = "libraries"
        showLibraries()
    else
        showHome()
    end if
end sub

function ratingInFlight() as boolean
    return m.pending = "setRating" or m.pending = "ratingRefresh"
end function

sub onDetailSeasonSelected()
    seasonNumber = m.screen.seasonSelected
    if seasonNumber < 0 or ratingInFlight()
        return
    end if
    loadEpisodes(seasonNumber)
end sub

sub onDetailPlayRequested()
    launchReq = m.screen.playRequested
    if launchReq = invalid or m.session = invalid or ratingInFlight()
        return
    end if
    m.pending = "watchForPlay"
    m.playLaunch = {
        contentId: launchReq.contentId,
        title: launchReq.title
    }
    m.screen.busy = true
    path = Prairie.Watch.watchPath(launchReq.contentId)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub onPlayerExit()
    if m.exitingPlayer
        return
    end if
    m.exitingPlayer = true
    if m.screen <> invalid
        m.screen.callFunc("stopPlayback")
    end if
    if m.liveSessionId.len() > 0
        releaseLiveSessionAsync()
        m.playbackSession = invalid
        showLiveTv()
        return
    end if
    reportPlayerProgress(true)
    stopPlaybackSessionAsync()
    m.playbackSession = invalid
    savedBack = m.detailBackRoute
    contentId = m.detailContentId
    if contentId.len() > 0
        showItemDetail(contentId)
        m.detailBackRoute = savedBack
    else
        showHome()
    end if
end sub

sub onPlayerProgressTick()
    if m.liveSessionId.len() > 0
        sendLiveHeartbeat()
        return
    end if
    reportPlayerProgress(false)
end sub

sub onPlayerSeek()
    reportPlayerProgress(true)
end sub

sub onPlayerAudioCycle()
    if m.session = invalid or m.playbackSession = invalid or m.screen = invalid
        return
    end if
    if m.playLaunch = invalid or m.playLaunch.watch = invalid
        return
    end if
    version = activeWatchVersion()
    if version = invalid
        return
    end if
    tracks = version.audio_tracks
    if tracks = invalid or tracks.count() < 2
        m.screen.errorText = "No alternate audio tracks"
        return
    end if
    nextIndex = m.audioTrackIndex + 1
    if nextIndex >= tracks.count()
        nextIndex = 0
    end if
    m.audioTrackIndex = nextIndex
    m.pending = "audioSwitch"
    sid = m.playbackSession.session_id as string
    body = Prairie.Playback.buildAudioBody(nextIndex, m.screen.positionSeconds)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.audioPath(sid), "PATCH", body)
    m.httpTask.control = "RUN"
end sub

sub rememberPlayerAudio()
    seriesId = playLaunchSeriesId()
    version = activeWatchVersion()
    if seriesId.len() = 0 or version = invalid or version.audio_tracks = invalid
        return
    end if
    tracks = version.audio_tracks
    if m.audioTrackIndex < 0 or m.audioTrackIndex >= tracks.count()
        return
    end if
    Prairie.TrackMemory.rememberAudio(m.store, seriesId, tracks[m.audioTrackIndex], m.audioTrackIndex)
end sub

sub onPlayerQualityChange()
    if m.screen = invalid
        return
    end if
    applyPlayerQuality(m.screen.qualityChangeRequested, true)
end sub

' Buffering step-down / Restore from the player: same switch, but the
' temporary rung is never saved as the preferred quality (android #636).
sub onPlayerAutoQuality()
    if m.screen = invalid
        return
    end if
    applyPlayerQuality(m.screen.autoQualityRequested, false)
end sub

sub applyPlayerQuality(requested as dynamic, persist as boolean)
    if m.session = invalid or m.playbackSession = invalid or m.screen = invalid
        return
    end if
    if requested = invalid or (requested as string).len() = 0
        return
    end if
    qualityId = requested as string
    if persist
        settings = Prairie.PlaybackSettings.load(m.store)
        settings.preferredQuality = qualityId
        Prairie.PlaybackSettings.save(settings, m.store)
    end if

    playMethod = ""
    if m.playbackSession.play_method <> invalid
        playMethod = LCase((m.playbackSession.play_method as string).trim())
    end if
    ladder = m.qualityLadder
    if ladder = invalid
        ladder = Prairie.QualityLadder.fallbackLadder()
    end if
    version = activeWatchVersion()
    sourceResolution = ""
    sourceBitrate = 0
    if version <> invalid
        if version.resolution <> invalid
            sourceResolution = version.resolution as string
        end if
        if version.bitrate <> invalid
            sourceBitrate = version.bitrate as integer
        end if
    end if
    options = Prairie.QualityLadder.buildQualityOptions({
        ladder: ladder,
        playMethod: m.playbackSession.play_method,
        sourceResolution: sourceResolution,
        sourceBitrateKbps: sourceBitrate,
        nativeHeight: Prairie.QualityLadder.sourceHeightForVersion(version, ladder)
    })
    deviceMax = Prairie.QualityLadder.deviceDisplayHeight()
    if LCase(qualityId) = "auto"
        nativeH = Prairie.QualityLadder.sourceHeightForVersion(version, ladder)
        if nativeH > 0 and (deviceMax <= 0 or nativeH < deviceMax)
            deviceMax = nativeH
        end if
    end if
    targets = Prairie.QualityLadder.resolveQualityTargets({
        qualityId: qualityId,
        options: options,
        playMethod: m.playbackSession.play_method,
        ladder: ladder,
        deviceMaxHeight: deviceMax
    })

    m.activeQualityId = qualityId
    m.screen.activeQualityId = qualityId
    m.screen.qualityOptions = options
    resumeAt = m.screen.positionSeconds

    if m.playbackSession.is_protocol_v3 = true
        m.pending = "playbackReplan"
        m.screen.busy = true
        replanQuality = qualityId
        m.pendingQualityPreference = replanQuality
        body = Prairie.Playback.buildReplanBody(m.playbackSession, replanQuality, resumeAt)
        m.playbackRoute = "v2"
        sid = m.playbackSession.session_id
        if sid = invalid or (sid as string).len() = 0
            return
        end if
        m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), "/api/v2/playback/" + (sid as string).encodeUriComponent() + "/replan", "POST", body)
        m.httpTask.control = "RUN"
        return
    end if

    if targets = invalid and playMethod = "direct"
        ' Revert to the original direct stream (no HLS).
        m.screen.startPosition = resumeAt
        applyPlayerStream(m.playbackSession)
        return
    end if

    ' Remux/transcode (and original on those bases) restart HLS at current position.
    startPlaybackTranscode(resumeAt, qualityId)
end sub

sub onProgressResponse()
    ' Best-effort progress / session teardown — ignore failures.
end sub

sub onCatalogLoadMore()
    if m.catalogHasMore <> true or m.pending <> ""
        return
    end if
    loadCatalogPage(true)
end sub

sub onSearchSubmit()
    query = m.screen.submitQuery
    if query = invalid
        return
    end if
    trimmed = query.trim()
    if trimmed.len() = 0
        m.screen.items = []
        m.screen.requestItems = []
        m.screen.statusText = ""
        m.screen.errorText = ""
        return
    end if
    if m.session = invalid
        return
    end if
    m.pending = "search"
    m.searchQuery = trimmed
    m.screen.busy = true
    m.screen.statusText = ""
    m.httpTask.request = Prairie.Catalog.buildCatalogRequest({
        q: trimmed,
        source: "query",
        offset: 0,
        limit: 48
    }, Prairie.Api.sessionOptions(m.session))
    m.httpTask.control = "RUN"
end sub

sub applyCatalogPage(page as object, append as boolean)
    if append
        for each item in page.items
            m.catalogItems.push(item)
        end for
    else
        m.catalogItems = page.items
    end if
    m.catalogHasMore = false
    if page.has_more = true
        m.catalogHasMore = true
    end if
    if page.snapshot.len() > 0
        m.catalogSnapshot = page.snapshot
    end if
    if m.screen <> invalid
        m.screen.items = m.catalogItems
        m.screen.hasMore = m.catalogHasMore
        m.screen.busy = false
        m.screen.callFunc("focusDefault")
    end if
end sub

' Options (*) on a poster card: Mark as Watched / Unwatched (and Libraries
' on Home, which * opened directly before).
sub onCardOptionsRequested()
    request = m.screen.cardOptionsRequested
    if request = invalid or request.contentId = invalid or m.session = invalid or isSpecialCardId(request.contentId)
        return
    end if
    m.cardOptions = request
    m.cardActions = Prairie.WatchedState.cardActions(request.watched = true, m.route = "home")
    dialog = CreateObject("roSGNode", "Dialog")
    if request.title <> invalid
        dialog.title = request.title
    end if
    dialog.buttons = Prairie.WatchedState.cardActionLabels(m.cardActions)
    dialog.observeField("buttonSelected", "onCardOptionsButton")
    m.cardOptionsDialog = dialog
    m.top.dialog = dialog
end sub

sub onCardOptionsButton()
    dialog = m.cardOptionsDialog
    request = m.cardOptions
    if dialog = invalid or request = invalid
        return
    end if
    choice = Prairie.WatchedState.cardActionAt(m.cardActions, dialog.buttonSelected)
    dialog.close = true
    m.cardOptionsDialog = invalid
    m.cardOptions = invalid
    if choice = "libraries"
        onOpenLibraries()
    else if choice = "watched"
        node = request.node
        target = not (request.watched = true)
        if node <> invalid and node.hasField("watched")
            target = not (node.watched = true)
        end if
        startWatchedWrite(request.contentId as string, target, node)
    end if
end sub

sub onDetailWatchedRequested()
    if m.route <> "detail" or m.session = invalid or m.detailContentId.len() = 0
        return
    end if
    startWatchedWrite(m.detailContentId, not m.screen.watched, invalid)
end sub

' Shows the new state at once and writes it on its own task; a failed write
' puts the old state back (unless a newer write for the item replaced it)
' and says why.
sub startWatchedWrite(contentId as string, target as boolean, node as dynamic)
    if contentId.len() = 0 or m.session = invalid
        return
    end if
    previous = not target
    applyWatchedState(contentId, target, node)
    existing = m.watchedWrites[contentId]
    if existing <> invalid and existing.task <> invalid
        existing.task.unobserveField("response")
        existing.task.control = "STOP"
    end if
    m.watchedGeneration = m.watchedGeneration + 1
    task = CreateObject("roSGNode", "HttpTask")
    task.addFields({ watchedContentId: contentId, watchedGeneration: m.watchedGeneration })
    task.observeField("response", "onWatchedResponse")
    m.watchedWrites[contentId] = {
        task: task,
        generation: m.watchedGeneration,
        previous: previous,
        target: target,
        node: node
    }
    task.request = Prairie.WatchedState.buildRequest(Prairie.Api.sessionOptions(m.session), contentId, target)
    task.control = "RUN"
end sub

sub applyWatchedState(contentId as string, watched as boolean, node as dynamic)
    if node <> invalid and node.hasField("watched")
        node.watched = watched
    end if
    if m.route = "detail" and m.screen <> invalid and m.detailContentId = contentId
        m.screen.watched = watched
        if m.detailItem <> invalid
            m.detailItem = Prairie.WatchedState.withWatched(m.detailItem, watched)
        end if
    end if
end sub

sub onWatchedResponse(event as object)
    task = event.getRoSGNode()
    if task = invalid
        return
    end if
    response = event.getData()
    contentId = task.watchedContentId
    task.unobserveField("response")
    write = m.watchedWrites[contentId]
    if write = invalid or write.generation <> task.watchedGeneration
        return
    end if
    m.watchedWrites.delete(contentId)
    if response <> invalid and response.ok = true
        return
    end if
    errorInfo = invalid
    if response <> invalid
        errorInfo = response.error
    end if
    applyWatchedState(contentId, write.previous, write.node)
    showMessage(Prairie.WatchedState.actionLabel(write.previous), Prairie.WatchedState.failureMessage(write.target, errorInfo))
end sub

sub onHttpResponse()
    response = m.httpTask.response
    pending = m.pending
    m.pending = ""

    chainingCollections = pending = "collectionsLibraries" or pending = "libraryCollections"
    chainingDiscover = pending = "discoverProbe"
    chainingAuth = pending = "serverProbe" or pending = "deviceStart" or pending = "devicePoll" or pending = "sessionRefresh"
    chainingQuality = pending = "qualityLadder"
    if m.screen <> invalid and m.screen.hasField("busy") and not chainingCollections and not chainingDiscover and not chainingAuth and not chainingQuality
        m.screen.busy = false
    end if

    if response = invalid
        return
    end if

    if pending = "qualityLadder"
        if response.ok = true
            m.qualityLadder = Prairie.QualityLadder.rungsFromResponse(response.data)
        else
            m.qualityLadder = Prairie.QualityLadder.fallbackLadder()
        end if
        refreshPlayerQualityOptions()
        startPlaybackSession()
        return
    end if

    if pending = "discoverProbe"
        if response.ok = true
            health = Prairie.Discover.parseHealth(response.data)
            if health <> invalid and m.discoverCurrentUrl.len() > 0
                m.discoverHits = Prairie.Discover.mergeHits(m.discoverHits, m.discoverCurrentUrl, health)
                if m.route = "servers"
                    paintServerList()
                end if
            end if
        end if
        probeNextDiscoverCandidate()
        return
    end if

    if pending = "appUpdate"
        applyAppUpdateResponse(response)
        return
    end if

    if pending = "serverProbe"
        onServerProbeResponse(response)
        return
    end if

    if pending = "sessionRefresh"
        onSessionRefreshResponse(response)
        return
    end if

    if pending = "deviceStart" or pending = "devicePoll"
        applyDeviceSignInResponse(pending, response)
        return
    end if

    if response.ok <> true
        status = 0
        if response.error <> invalid and response.error.status <> invalid
            status = response.error.status as integer
        end if
        if (pending = "playbackStart" or pending = "playbackReplan") and m.playbackRoute = "v2" and (status = 404 or status = 405)
            m.playbackRoute = "v1"
            if pending = "playbackStart"
                body = m.playbackStartBody
                requestBody = ParseJson(body)
                if requestBody <> invalid and requestBody.playback_attempt_id <> invalid
                    m.playbackAttemptId = requestBody.playback_attempt_id as string
                end if
                m.pending = "playbackStart"
                m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), "/api/v1/playback/start", "POST", body)
            else
                m.pending = "playbackReplan"
                body = Prairie.Playback.buildReplanBody(m.playbackSession, m.pendingQualityPreference, m.screen.positionSeconds)
                m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.sessionPath(m.playbackSession.session_id) + "/replan", "POST", body)
            end if
            m.httpTask.control = "RUN"
            return
        end if
        message = "Request failed"
        if response.error <> invalid and response.error.message <> invalid
            message = response.error.message
        end if
        status = 0
        if response.error <> invalid and response.error.status <> invalid
            status = response.error.status as integer
        end if
        if pending = "setRating"
            if m.route = "detail" and m.screen <> invalid
                m.screen.userRating = m.ratingPrevious
                m.screen.errorText = "Could not save rating"
            end if
            return
        end if
        ' A failed or missing capability read means no item_limit.
        if pending = "homeCapabilities"
            m.homeItemLimit = 0
            loadHomeSections()
            return
        end if
        ' A server that still rejects item_limit is read without it for the session.
        if pending = "home" and m.homeItemLimit > 0 and Prairie.Home.rejectsItemLimit(status)
            m.homeItemLimit = 0
            loadHomeSections()
            return
        end if
        if pending = "home"
            if m.screen <> invalid and m.screen.hasField("errorText")
                m.screen.errorText = message
            end if
            continueHomeNavLoad()
            return
        end if
        if pending = "navLibraries"
            m.navLibraries = []
            continueHomeNavLoad()
            return
        end if
        if pending = "navLiveTv"
            m.navHasLiveTv = false
            m.navLiveTvKnown = true
            return
        end if
        ' More Like This is optional; the rail just stays hidden.
        if pending = "similar"
            return
        end if
        ' Rating saved; a failed community refresh only leaves the meta line stale.
        if pending = "ratingRefresh"
            return
        end if
        ' Personal collections are optional on some servers.
        if pending = "personalCollections"
            m.personalCollectionCards = []
            finishCollectionsScreen()
            return
        end if
        ' Live TV may be absent on older Prairie servers.
        if pending = "liveChannels" and status = 404
            m.liveChannels = []
            m.screen.channels = []
            m.screen.statusText = "Live TV is not enabled on this server"
            m.screen.callFunc("focusDefault")
            return
        end if
        if pending = "liveGuide"
            m.livePrograms = []
            m.screen.programs = []
            loadLiveTvRecordings()
            return
        end if
        if pending = "liveRecordings"
            m.liveRecordings = []
            m.screen.recordings = []
            return
        end if
        if chainingCollections
            ' Skip a failed library collections fetch and continue the chain.
            if pending = "libraryCollections"
                loadNextLibraryCollections()
                return
            end if
            if m.screen <> invalid and m.screen.hasField("busy")
                m.screen.busy = false
            end if
        end if
        if pending = "login"
            if m.screen <> invalid and m.screen.hasField("errorText")
                m.screen.errorText = Prairie.SignIn.loginFailureMessage(status, message)
            end if
            return
        end if
        if pending = "liveRecord"
            if m.screen <> invalid and m.screen.hasField("errorText")
                m.screen.errorText = "Could not schedule recording"
            end if
            return
        end if
        if pending = "liveCancelRecording"
            if m.screen <> invalid and m.screen.hasField("errorText")
                m.screen.errorText = "Could not cancel recording"
            end if
            return
        end if
        if pending = "liveSession"
            if m.screen <> invalid and m.screen.hasField("busy")
                m.screen.busy = false
            end if
            if m.screen <> invalid and m.screen.hasField("errorText")
                m.screen.errorText = message
            end if
            return
        end if
        if m.screen <> invalid and m.screen.hasField("errorText")
            m.screen.errorText = message
        end if
        return
    end if

    if pending = "login"
        data = response.data
        if data = invalid or data.access_token = invalid or data.user = invalid
            m.screen.errorText = "Unexpected login response"
            return
        end if
        username = ""
        if data.user.username <> invalid
            username = data.user.username as string
        end if
        m.auth = {
            serverUrl: m.loginServerUrl,
            accessToken: data.access_token as string,
            username: username,
            refreshToken: data.refresh_token
        }
        Prairie.Persist.saveLastServerUrl(m.loginServerUrl, m.store)
        showProfiles()
    else if pending = "profiles"
        profiles = Prairie.Auth.profilesFromResponse(response.data)
        m.screen.profiles = profiles
        m.screen.callFunc("focusDefault")
        if profiles.count() = 0
            m.screen.errorText = "No profiles on this account"
        end if
        if m.resume <> invalid
            resumed = m.resume
            m.resume = invalid
            autoOpenRememberedProfile(resumed.serverUrl, profiles)
        end if
    else if pending = "verifyPin"
        data = response.data
        if data = invalid or data.valid <> true or data.profile_token = invalid
            m.screen.errorText = "Incorrect PIN"
            return
        end if
        finishProfile(m.pinProfile, data.profile_token)
    else if pending = "homeCapabilities"
        m.homeItemLimit = Prairie.Home.sectionItemLimitFromCapabilities(response.data)
        loadHomeSections()
    else if pending = "home"
        sections = Prairie.Home.sectionsFromResponse(response.data)
        m.screen.sections = sections
        m.screen.callFunc("focusDefault")
        if sections.count() = 0
            m.screen.errorText = "No home sections yet"
        end if
        continueHomeNavLoad()
    else if pending = "navLibraries"
        m.navLibraries = Prairie.Libraries.librariesFromResponse(response.data)
        paintHomeNav()
        continueHomeNavLoad()
    else if pending = "navLiveTv"
        m.navHasLiveTv = Prairie.LiveTv.channelsFromResponse(response.data).count() > 0
        m.navLiveTvKnown = true
        paintHomeNav()
    else if pending = "similar"
        if m.route = "detail" and m.screen <> invalid
            m.screen.similar = Prairie.Catalog.itemsFromResponse(response.data)
        end if
    else if pending = "libraries"
        libraries = Prairie.Libraries.librariesFromResponse(response.data)
        m.screen.libraries = libraries
        m.screen.callFunc("focusDefault")
        if libraries.count() = 0
            m.screen.errorText = "No libraries yet"
        end if
    else if pending = "catalog" or pending = "catalogMore"
        page = Prairie.Catalog.pageFromResponse(response.data)
        applyCatalogPage(page, pending = "catalogMore")
    else if pending = "search"
        page = Prairie.Catalog.pageFromResponse(response.data)
        m.screen.items = page.items
        if page.items.count() = 0
            m.screen.statusText = "No matches"
        else
            m.screen.statusText = ""
        end if
        m.screen.callFunc("focusDefault")
        startSearchExtras(m.searchQuery, page.items)
    else if pending = "collectionsLibraries"
        libraries = Prairie.Libraries.librariesFromResponse(response.data)
        m.collectionLibraryQueue = []
        for each library in libraries
            m.collectionLibraryQueue.push(library)
        end for
        m.libraryCollectionCards = []
        loadNextLibraryCollections()
    else if pending = "libraryCollections"
        cards = Prairie.Collections.flattenLibraryCollections(m.pendingLibraryId, response.data)
        for each card in cards
            m.libraryCollectionCards.push(card)
        end for
        loadNextLibraryCollections()
    else if pending = "personalCollections"
        m.personalCollectionCards = Prairie.Collections.flattenPersonalCollections(response.data)
        finishCollectionsScreen()
    else if pending = "setRating"
        if m.route = "detail"
            m.pending = "ratingRefresh"
            m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Catalog.itemDetailPath(m.detailContentId), "GET")
            m.httpTask.control = "RUN"
        end if
    else if pending = "ratingRefresh"
        if m.route = "detail" and type(response.data) = "roAssociativeArray"
            m.detailItem = response.data
            m.screen.detail = response.data
        end if
    else if pending = "itemDetail"
        detail = response.data
        if detail = invalid or type(detail) <> "roAssociativeArray"
            m.screen.errorText = "Unexpected item response"
            return
        end if
        m.detailItem = detail
        m.screen.detail = detail
        m.screen.callFunc("focusDefault")
        onDetailLoaded(detail)
        if isSeriesDetail(detail)
            loadSeasons()
        else
            loadSimilar()
        end if
    else if pending = "seasons"
        seasons = Prairie.Catalog.seasonsFromResponse(response.data)
        m.screen.seasons = seasons
        if seasons.count() > 0 and seasons[0].season_number <> invalid
            loadEpisodes(seasons[0].season_number as integer)
        else
            m.screen.callFunc("focusDefault")
        end if
    else if pending = "episodes"
        episodes = Prairie.Catalog.episodesFromResponse(response.data)
        m.screen.episodeSeason = m.episodesSeason
        m.screen.episodes = episodes
        m.screen.callFunc("focusDefault")
    else if pending = "watchForPlay"
        watch = response.data
        if watch = invalid
            m.screen.errorText = "Could not load watch details"
            return
        end if
        if watch.versions = invalid
            watch.versions = []
        end if
        fileId = Prairie.Watch.selectPlaybackFileId(watch)
        if fileId = invalid
            m.screen.errorText = "No playable file for this title"
            return
        end if
        title = m.playLaunch.title
        if watch.title <> invalid and (watch.title as string).len() > 0
            title = watch.title as string
        end if
        showPlayer({
            fileId: fileId as integer,
            title: title,
            contentId: m.playLaunch.contentId,
            startPosition: Prairie.Playback.resumeSeconds(watch),
            watch: watch
        })
    else if pending = "playbackStart"
        playback = Prairie.Playback.normalizeStartResponse(response.data)
        if playback = invalid or playback.session_id = invalid or playback.stream_url = invalid
            m.screen.errorText = "Playback failed to start"
            return
        end if
    if playback <> invalid and m.playbackAttemptId <> invalid
        playback.playback_attempt_id = m.playbackAttemptId
    end if
    m.playbackSession = playback
    if playback.audio_track_index <> invalid
        m.audioTrackIndex = playback.audio_track_index as integer
    end if
    if playback.is_protocol_v3 = true
        if playback.play_method = "direct"
            m.activeQualityId = "original"
        else
            m.activeQualityId = "auto"
        end if
        applyPlayerStream(playback)
        return
    end if
    ' Legacy fallback for older Prairie servers.
    if Prairie.Playback.needsHlsBootstrap(playback.play_method)
            seekSeconds = 0
            if m.playLaunch <> invalid and m.playLaunch.startPosition <> invalid
                seekSeconds = m.playLaunch.startPosition
            else if playback.position <> invalid
                seekSeconds = playback.position
            end if
            startPlaybackTranscode(seekSeconds)
            return
        end if
        m.activeQualityId = "original"
        applyPlayerStream(playback)
    else if pending = "playbackReplan"
        replanned = Prairie.Playback.applyReplanResponse(m.playbackSession, response.data)
        if replanned = invalid or replanned.stream_url = invalid
            m.screen.errorText = "Could not change playback quality"
            return
        end if
        m.playbackSession = replanned
        m.screen.startPosition = m.screen.positionSeconds
        applyPlayerStream(replanned)
    else if pending = "playbackTranscodeStart"
        transcode = response.data
        if transcode = invalid or transcode.manifest_url = invalid
            m.screen.errorText = "Could not start HLS playback"
            return
        end if
        m.playbackSession = Prairie.Playback.applyTranscodeResponse(m.playbackSession, transcode)
        if transcode.player_start_seconds <> invalid
            m.screen.startPosition = transcode.player_start_seconds
        end if
        applyPlayerStream(m.playbackSession)
    else if pending = "audioSwitch"
        updated = response.data
        if updated = invalid or updated.stream_url = invalid
            m.screen.errorText = "Could not switch audio"
            return
        end if
        m.playbackSession.stream_url = updated.stream_url
        m.playbackSession.play_method = updated.play_method
        m.playbackSession.audio_track_index = updated.audio_track_index
        if updated.audio_track_index <> invalid
            m.audioTrackIndex = updated.audio_track_index as integer
        end if
        rememberPlayerAudio()
        resumeAt = m.screen.positionSeconds
        if updated.player_start_seconds <> invalid
            resumeAt = updated.player_start_seconds
        end if
        m.screen.startPosition = resumeAt
        if Prairie.Playback.needsHlsBootstrap(updated.play_method)
            startPlaybackTranscode(resumeAt)
            return
        end if
        m.screen.streamFormat = Prairie.Playback.detectStreamFormat(m.playbackSession)
        m.screen.streamUrl = Prairie.Playback.resolveStreamUrl(m.session.serverUrl, m.playbackSession, m.session.accessToken)
        m.screen.errorText = "Audio track " + (m.audioTrackIndex + 1).toStr()
    else if pending = "liveChannels"
        channels = Prairie.LiveTv.channelsFromResponse(response.data)
        m.liveChannels = channels
        m.screen.channels = channels
        if channels.count() = 0
            m.screen.statusText = "No enabled channels on this server"
            m.screen.callFunc("focusDefault")
            loadLiveTvRecordings()
        else
            m.screen.statusText = channels.count().toStr() + " channels"
            m.screen.callFunc("focusDefault")
            loadLiveTvGuide(channels)
        end if
    else if pending = "liveGuide"
        programs = Prairie.LiveTv.programsFromResponse(response.data)
        m.livePrograms = programs
        m.screen.programs = programs
        loadLiveTvRecordings()
    else if pending = "liveRecordings"
        recordings = Prairie.LiveTv.recordingsFromResponse(response.data)
        m.liveRecordings = recordings
        m.screen.recordings = recordings
        m.screen.busy = false
    else if pending = "liveRecord"
        m.screen.statusText = "Recording scheduled"
        m.screen.errorText = ""
        loadLiveTvRecordings()
    else if pending = "liveCancelRecording"
        m.screen.statusText = "Recording cancelled"
        m.screen.errorText = ""
        loadLiveTvRecordings()
    else if pending = "liveSession"
        m.screen.busy = false
        start = response.data
        streamPath = Prairie.LiveTv.playableLiveUrl(start)
        if streamPath = invalid
            m.screen.errorText = "Playback failed to start"
            return
        end if
        profileId = invalid
        if m.session <> invalid and m.session.profileId <> invalid
            profileId = m.session.profileId
        end if
        resolved = Prairie.LiveTv.resolveLivePlaybackUrl(m.session.serverUrl, streamPath as string, m.session.accessToken, profileId)
        if resolved.ok <> true
            m.screen.errorText = resolved.message
            return
        end if
        if start.session_id <> invalid
            m.liveSessionId = start.session_id as string
        end if
        title = Prairie.LiveTv.channelDisplayLabel(m.liveChannel)
        clearScreen()
        m.route = "player"
        m.exitingPlayer = false
        m.playbackSession = invalid
        screen = CreateObject("roSGNode", "PlayerScreen")
        screen.titleText = title
        screen.streamFormat = Prairie.LiveTv.liveStreamFormat(start)
        screen.startPosition = 0
        screen.observeField("exitRequested", "onPlayerExit")
        screen.observeField("progressTick", "onPlayerProgressTick")
        m.screenHost.appendChild(screen)
        m.screen = screen
        screen.busy = false
        screen.streamUrl = resolved.url
        screen.callFunc("focusDefault")
    end if
end sub
