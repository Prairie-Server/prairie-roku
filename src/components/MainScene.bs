import "pkg:/source/lib/Theme.bs"
import "pkg:/source/lib/Store.bs"
import "pkg:/source/lib/Persist.bs"
import "pkg:/source/lib/Session.bs"
import "pkg:/source/lib/ApiClient.bs"
import "pkg:/source/lib/Auth.bs"
import "pkg:/source/lib/Home.bs"
import "pkg:/source/lib/Libraries.bs"
import "pkg:/source/lib/Catalog.bs"
import "pkg:/source/lib/Collections.bs"
import "pkg:/source/lib/Watch.bs"
import "pkg:/source/lib/Playback.bs"
import "pkg:/source/lib/UrlUtils.bs"

sub init()
    m.top.backgroundURI = ""
    m.top.backgroundColor = Prairie.Theme.colors().bg
    m.store = Prairie.Store.createRegistryStore("prairie")
    Prairie.Persist.ensureStorageSchema(m.store)

    m.screenHost = m.top.findNode("screenHost")
    m.httpTask = m.top.findNode("httpTask")
    m.httpTask.observeField("response", "onHttpResponse")
    m.progressTask = m.top.findNode("progressTask")
    m.progressTask.observeField("response", "onProgressResponse")

    m.pending = ""
    m.auth = invalid
    m.session = Prairie.Session.loadSession(m.store)
    m.pinProfile = invalid
    m.catalogItems = []
    m.catalogSnapshot = ""
    m.catalogHasMore = false
    m.browseLibrary = invalid
    m.browseCollection = invalid
    m.collectionLibraryQueue = []
    m.libraryCollectionCards = []
    m.personalCollectionCards = []
    m.detailContentId = ""
    m.detailBackRoute = "home"
    m.detailItem = invalid
    m.playLaunch = invalid
    m.playbackSession = invalid
    m.audioTrackIndex = 0
    m.exitingPlayer = false

    if m.session <> invalid
        showHome()
    else
        showConnect()
    end if
end sub

sub clearScreen()
    if m.screenHost = invalid
        return
    end if
    if m.httpTask <> invalid
        m.httpTask.control = "STOP"
    end if
    m.pending = ""
    m.pinProfile = invalid
    while m.screenHost.getChildCount() > 0
        m.screenHost.removeChildIndex(0)
    end while
    m.screen = invalid
end sub

sub showConnect()
    clearScreen()
    m.route = "connect"
    m.auth = invalid
    m.session = invalid
    screen = CreateObject("roSGNode", "ConnectScreen")
    screen.initialServerUrl = Prairie.Persist.loadLastServerUrl(m.store)
    screen.observeField("submitRequest", "onConnectSubmit")
    m.screenHost.appendChild(screen)
    m.screen = screen
    screen.callFunc("focusDefault")
end sub

sub showProfiles()
    clearScreen()
    m.route = "profiles"
    screen = CreateObject("roSGNode", "ProfileSelectScreen")
    if m.auth <> invalid
        screen.username = m.auth.username
    end if
    screen.observeField("selectedProfile", "onProfileChosen")
    screen.observeField("pinSubmit", "onPinSubmit")
    screen.observeField("cancelRequested", "onProfilesCancel")
    m.screenHost.appendChild(screen)
    m.screen = screen
    loadProfiles()
end sub

sub showHome()
    clearScreen()
    m.route = "home"
    screen = CreateObject("roSGNode", "HomeBrowseScreen")
    if m.session <> invalid and m.session.profileName <> invalid
        screen.profileName = m.session.profileName
    end if
    screen.observeField("selectedContentId", "onHomeItemSelected")
    screen.observeField("openLibraries", "onOpenLibraries")
    screen.observeField("openSearch", "onOpenSearch")
    screen.observeField("signOutRequested", "onSignOut")
    m.screenHost.appendChild(screen)
    m.screen = screen
    loadHomeSections()
end sub

sub showLibraries()
    clearScreen()
    m.route = "libraries"
    screen = CreateObject("roSGNode", "LibrariesScreen")
    screen.observeField("selectedLibrary", "onLibraryChosen")
    screen.observeField("openCollections", "onOpenCollections")
    screen.observeField("backRequested", "onBrowseBackHome")
    m.screenHost.appendChild(screen)
    m.screen = screen
    loadLibraries()
end sub

sub showLibraryBrowse(library as object)
    clearScreen()
    m.route = "library"
    m.browseLibrary = library
    m.browseCollection = invalid
    m.catalogItems = []
    m.catalogSnapshot = ""
    m.catalogHasMore = false
    screen = CreateObject("roSGNode", "CatalogBrowseScreen")
    screen.eyebrow = "Library"
    screen.titleText = library.name
    screen.observeField("selectedContentId", "onCatalogItemSelected")
    screen.observeField("loadMoreRequested", "onCatalogLoadMore")
    screen.observeField("backRequested", "onLibraryBrowseBack")
    m.screenHost.appendChild(screen)
    m.screen = screen
    loadCatalogPage(false)
end sub

sub showSearch()
    clearScreen()
    m.route = "search"
    screen = CreateObject("roSGNode", "SearchScreen")
    screen.observeField("submitQuery", "onSearchSubmit")
    screen.observeField("selectedContentId", "onCatalogItemSelected")
    screen.observeField("backRequested", "onBrowseBackHome")
    m.screenHost.appendChild(screen)
    m.screen = screen
    screen.callFunc("focusDefault")
end sub

sub showCollections()
    clearScreen()
    m.route = "collections"
    m.libraryCollectionCards = []
    m.personalCollectionCards = []
    m.collectionLibraryQueue = []
    screen = CreateObject("roSGNode", "CollectionsScreen")
    screen.busy = true
    screen.observeField("selectedCollection", "onCollectionChosen")
    screen.observeField("backRequested", "onCollectionsBack")
    m.screenHost.appendChild(screen)
    m.screen = screen
    startCollectionsLoad()
end sub

sub showCollectionBrowse(collection as object)
    clearScreen()
    m.route = "collection"
    m.browseCollection = collection
    m.browseLibrary = invalid
    m.catalogItems = []
    m.catalogSnapshot = ""
    m.catalogHasMore = false
    screen = CreateObject("roSGNode", "CatalogBrowseScreen")
    screen.eyebrow = "Collection"
    screen.titleText = collection.title
    screen.observeField("selectedContentId", "onCatalogItemSelected")
    screen.observeField("loadMoreRequested", "onCatalogLoadMore")
    screen.observeField("backRequested", "onCollectionBrowseBack")
    m.screenHost.appendChild(screen)
    m.screen = screen
    loadCatalogPage(false)
end sub

sub showMessage(title as string, message as string)
    dialog = CreateObject("roSGNode", "Dialog")
    dialog.title = title
    dialog.message = message
    dialog.buttons = ["OK"]
    dialog.observeField("buttonSelected", "onMessageDialogButton")
    m.messageDialog = dialog
    m.top.dialog = dialog
end sub

sub onMessageDialogButton()
    if m.messageDialog <> invalid
        m.messageDialog.close = true
        m.messageDialog = invalid
    end if
end sub

sub showItemDetail(contentId as string)
    m.detailContentId = contentId
    m.detailBackRoute = m.route
    clearScreen()
    m.route = "detail"
    m.detailItem = invalid
    screen = CreateObject("roSGNode", "ItemDetailScreen")
    screen.observeField("playRequested", "onDetailPlayRequested")
    screen.observeField("seasonSelected", "onDetailSeasonSelected")
    screen.observeField("backRequested", "onDetailBack")
    m.screenHost.appendChild(screen)
    m.screen = screen
    loadItemDetail()
end sub

sub showPlayer(launch as object)
    clearScreen()
    m.route = "player"
    m.playLaunch = launch
    m.playbackSession = invalid
    m.exitingPlayer = false
    m.audioTrackIndex = 0
    screen = CreateObject("roSGNode", "PlayerScreen")
    screen.titleText = launch.title
    screen.busy = true
    if launch.startPosition <> invalid
        screen.startPosition = launch.startPosition
    end if
    screen.observeField("exitRequested", "onPlayerExit")
    screen.observeField("progressTick", "onPlayerProgressTick")
    screen.observeField("seekDelta", "onPlayerSeek")
    screen.observeField("audioCycleRequested", "onPlayerAudioCycle")
    m.screenHost.appendChild(screen)
    m.screen = screen
    startPlaybackSession()
end sub

sub loadItemDetail()
    if m.session = invalid or m.detailContentId.len() = 0
        return
    end if
    m.pending = "itemDetail"
    m.screen.busy = true
    path = Prairie.Catalog.itemDetailPath(m.detailContentId)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub loadSeasons()
    if m.session = invalid
        return
    end if
    m.pending = "seasons"
    path = Prairie.Catalog.seasonsPath(m.detailContentId)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub loadEpisodes(seasonNumber as integer)
    if m.session = invalid
        return
    end if
    m.pending = "episodes"
    path = Prairie.Catalog.episodesPath(m.detailContentId, seasonNumber)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub startPlaybackSession()
    if m.session = invalid or m.playLaunch = invalid
        return
    end if
    m.pending = "playbackStart"
    if m.screen <> invalid
        m.screen.busy = true
    end if
    forced = Prairie.Playback.forcedPlayMethodFromStore(m.store)
    body = Prairie.Playback.buildStartBody({
        fileId: m.playLaunch.fileId,
        profileId: m.session.profileId,
        forcedPlayMethod: forced,
        startPosition: m.playLaunch.startPosition
    })
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.startPath(), "POST", body)
    m.httpTask.control = "RUN"
end sub

sub reportPlayerProgress(force as boolean)
    if m.session = invalid or m.playbackSession = invalid or m.screen = invalid
        return
    end if
    if m.route <> "player"
        return
    end if
    sid = m.playbackSession.session_id
    if sid = invalid or (sid as string).len() = 0
        return
    end if
    position = m.screen.positionSeconds
    isPaused = m.screen.isPaused
    req = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.progressPath(sid as string), "POST", Prairie.Playback.buildProgressBody(position, isPaused))
    m.progressTask.request = req
    m.progressTask.control = "RUN"
end sub

sub stopPlaybackSessionAsync()
    if m.session = invalid or m.playbackSession = invalid
        return
    end if
    sid = m.playbackSession.session_id
    if sid = invalid or (sid as string).len() = 0
        return
    end if
    req = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.sessionPath(sid as string), "DELETE")
    m.progressTask.request = req
    m.progressTask.control = "RUN"
end sub

function isSeriesDetail(detail as object) as boolean
    if detail = invalid or detail.type = invalid
        return false
    end if
    lower = LCase(detail.type as string)
    return lower = "series" or lower = "show" or lower = "tv"
end function

sub onConnectSubmit()
    req = m.screen.submitRequest
    if req = invalid
        return
    end if
    m.pending = "login"
    m.loginServerUrl = serverBaseFromRequestUrl(req.url)
    m.httpTask.request = req
    m.httpTask.control = "RUN"
end sub

function serverBaseFromRequestUrl(url as string) as string
    marker = "/api/v1/auth/login"
    idx = LCase(url).instr(marker)
    if idx >= 0
        return url.left(idx)
    end if
    return Prairie.Url.normalizeServerUrl(url)
end function

sub loadProfiles()
    if m.auth = invalid
        return
    end if
    m.pending = "profiles"
    m.screen.busy = true
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken
    }, Prairie.Auth.profilesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadHomeSections()
    if m.session = invalid
        return
    end if
    m.pending = "home"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Home.sectionsPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadLibraries()
    if m.session = invalid
        return
    end if
    m.pending = "libraries"
    m.screen.busy = true
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Libraries.librariesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

function buildCatalogQuery(append as boolean) as object
    query = {
        limit: 48
    }
    if append
        query.offset = m.catalogItems.count()
        if m.catalogSnapshot.len() > 0
            query.snapshot = m.catalogSnapshot
        end if
    else
        query.offset = 0
    end if

    if m.route = "library" and m.browseLibrary <> invalid
        query.libraryId = m.browseLibrary.id
    else if m.route = "collection" and m.browseCollection <> invalid
        query.collectionId = m.browseCollection.id
        if m.browseCollection.library_id <> invalid
            query.source = "library_collection"
            query.libraryId = m.browseCollection.library_id
        else
            query.source = "user_collection"
        end if
    end if
    return query
end function

sub loadCatalogPage(append as boolean)
    if m.session = invalid
        return
    end if
    if append
        m.pending = "catalogMore"
    else
        m.pending = "catalog"
    end if
    if m.screen <> invalid and m.screen.hasField("busy")
        m.screen.busy = true
    end if
    path = Prairie.Catalog.buildCatalogPath(buildCatalogQuery(append))
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub startCollectionsLoad()
    if m.session = invalid
        return
    end if
    m.pending = "collectionsLibraries"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Libraries.librariesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadNextLibraryCollections()
    if m.collectionLibraryQueue.count() = 0
        loadPersonalCollections()
        return
    end if
    library = m.collectionLibraryQueue.shift()
    m.pendingLibraryId = library.id
    m.pending = "libraryCollections"
    path = Prairie.Collections.libraryCollectionsPath(library.id)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub loadPersonalCollections()
    m.pending = "personalCollections"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Collections.personalCollectionsPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub finishCollectionsScreen()
    if m.screen = invalid or m.route <> "collections"
        return
    end if
    m.screen.busy = false
    m.screen.libraryCollections = m.libraryCollectionCards
    m.screen.personalCollections = m.personalCollectionCards
    m.screen.callFunc("focusDefault")
end sub

sub onProfileChosen()
    profile = m.screen.selectedProfile
    if profile = invalid
        return
    end if
    if profile.has_pin = true
        m.pinProfile = profile
        m.screen.pinProfileName = profile.name
        m.screen.pinMode = true
        return
    end if
    finishProfile(profile, invalid)
end sub

sub onPinSubmit()
    payload = m.screen.pinSubmit
    if payload = invalid or m.pinProfile = invalid or m.auth = invalid
        return
    end if
    m.pending = "verifyPin"
    m.screen.busy = true
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken
    }, Prairie.Auth.verifyPinPath(m.pinProfile.id), "POST", Prairie.Auth.buildVerifyPinBody(payload.pin))
    m.httpTask.control = "RUN"
end sub

sub finishProfile(profile as object, profileToken as dynamic)
    if m.auth = invalid
        return
    end if
    session = {
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken,
        username: m.auth.username,
        profileId: profile.id as string
    }
    if profile.name <> invalid
        session.profileName = profile.name as string
    end if
    if profileToken <> invalid
        session.profileToken = profileToken as string
    end if
    m.session = Prairie.Session.saveSession(session, m.store)
    m.pinProfile = invalid
    showHome()
end sub

sub onProfilesCancel()
    Prairie.Session.clearSession(m.store)
    showConnect()
end sub

sub onSignOut()
    Prairie.Session.clearSession(m.store)
    m.session = invalid
    showConnect()
end sub

sub onHomeItemSelected()
    contentId = m.screen.selectedContentId
    if contentId = invalid or contentId.len() = 0
        return
    end if
    showItemDetail(contentId)
end sub

sub onOpenLibraries()
    showLibraries()
end sub

sub onOpenSearch()
    showSearch()
end sub

sub onOpenCollections()
    showCollections()
end sub

sub onBrowseBackHome()
    showHome()
end sub

sub onLibraryBrowseBack()
    showLibraries()
end sub

sub onCollectionsBack()
    showLibraries()
end sub

sub onCollectionBrowseBack()
    showCollections()
end sub

sub onLibraryChosen()
    library = m.screen.selectedLibrary
    if library = invalid
        return
    end if
    showLibraryBrowse(library)
end sub

sub onCollectionChosen()
    collection = m.screen.selectedCollection
    if collection = invalid
        return
    end if
    showCollectionBrowse(collection)
end sub

sub onCatalogItemSelected()
    contentId = m.screen.selectedContentId
    if contentId = invalid or contentId.len() = 0
        return
    end if
    showItemDetail(contentId)
end sub

sub onDetailBack()
    back = m.detailBackRoute
    if back = "library" and m.browseLibrary <> invalid
        showLibraryBrowse(m.browseLibrary)
    else if back = "collection" and m.browseCollection <> invalid
        showCollectionBrowse(m.browseCollection)
    else if back = "search"
        showSearch()
    else if back = "libraries"
        showLibraries()
    else
        showHome()
    end if
end sub

sub onDetailSeasonSelected()
    seasonNumber = m.screen.seasonSelected
    if seasonNumber < 0
        return
    end if
    loadEpisodes(seasonNumber)
end sub

sub onDetailPlayRequested()
    launchReq = m.screen.playRequested
    if launchReq = invalid or m.session = invalid
        return
    end if
    m.pending = "watchForPlay"
    m.playLaunch = {
        contentId: launchReq.contentId,
        title: launchReq.title
    }
    m.screen.busy = true
    path = Prairie.Watch.watchPath(launchReq.contentId)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub onPlayerExit()
    if m.exitingPlayer
        return
    end if
    m.exitingPlayer = true
    if m.screen <> invalid
        m.screen.callFunc("stopPlayback")
    end if
    reportPlayerProgress(true)
    stopPlaybackSessionAsync()
    m.playbackSession = invalid
    savedBack = m.detailBackRoute
    contentId = m.detailContentId
    if contentId.len() > 0
        showItemDetail(contentId)
        m.detailBackRoute = savedBack
    else
        showHome()
    end if
end sub

sub onPlayerProgressTick()
    reportPlayerProgress(false)
end sub

sub onPlayerSeek()
    reportPlayerProgress(true)
end sub

sub onPlayerAudioCycle()
    if m.session = invalid or m.playbackSession = invalid or m.screen = invalid
        return
    end if
    if m.playLaunch = invalid or m.playLaunch.watch = invalid
        return
    end if
    versions = m.playLaunch.watch.versions
    if versions = invalid or versions.count() = 0
        return
    end if
    version = versions[0]
    tracks = version.audio_tracks
    if tracks = invalid or tracks.count() < 2
        m.screen.errorText = "No alternate audio tracks"
        return
    end if
    nextIndex = m.audioTrackIndex + 1
    if nextIndex >= tracks.count()
        nextIndex = 0
    end if
    m.audioTrackIndex = nextIndex
    m.pending = "audioSwitch"
    sid = m.playbackSession.session_id as string
    body = Prairie.Playback.buildAudioBody(nextIndex, m.screen.positionSeconds)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.audioPath(sid), "PATCH", body)
    m.httpTask.control = "RUN"
end sub

sub onProgressResponse()
    ' Best-effort progress / session teardown — ignore failures.
end sub

sub onCatalogLoadMore()
    if m.catalogHasMore <> true or m.pending <> ""
        return
    end if
    loadCatalogPage(true)
end sub

sub onSearchSubmit()
    query = m.screen.submitQuery
    if query = invalid
        return
    end if
    trimmed = query.trim()
    if trimmed.len() = 0
        m.screen.items = []
        m.screen.statusText = ""
        m.screen.errorText = ""
        return
    end if
    if m.session = invalid
        return
    end if
    m.pending = "search"
    m.screen.busy = true
    m.screen.statusText = ""
    path = Prairie.Catalog.buildCatalogPath({
        q: trimmed,
        offset: 0,
        limit: 48
    })
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub applyCatalogPage(page as object, append as boolean)
    if append
        for each item in page.items
            m.catalogItems.push(item)
        end for
    else
        m.catalogItems = page.items
    end if
    m.catalogHasMore = false
    if page.has_more = true
        m.catalogHasMore = true
    end if
    if page.snapshot.len() > 0
        m.catalogSnapshot = page.snapshot
    end if
    if m.screen <> invalid
        m.screen.items = m.catalogItems
        m.screen.hasMore = m.catalogHasMore
        m.screen.busy = false
        m.screen.callFunc("focusDefault")
    end if
end sub

sub onHttpResponse()
    response = m.httpTask.response
    pending = m.pending
    m.pending = ""

    chainingCollections = pending = "collectionsLibraries" or pending = "libraryCollections"
    if m.screen <> invalid and m.screen.hasField("busy") and not chainingCollections
        m.screen.busy = false
    end if

    if response = invalid
        return
    end if

    if response.ok <> true
        message = "Request failed"
        if response.error <> invalid and response.error.message <> invalid
            message = response.error.message
        end if
        ' Personal collections are optional on some servers.
        if pending = "personalCollections"
            m.personalCollectionCards = []
            finishCollectionsScreen()
            return
        end if
        if chainingCollections
            ' Skip a failed library collections fetch and continue the chain.
            if pending = "libraryCollections"
                loadNextLibraryCollections()
                return
            end if
            if m.screen <> invalid and m.screen.hasField("busy")
                m.screen.busy = false
            end if
        end if
        if m.screen <> invalid and m.screen.hasField("errorText")
            m.screen.errorText = message
        end if
        return
    end if

    if pending = "login"
        data = response.data
        if data = invalid or data.access_token = invalid or data.user = invalid
            m.screen.errorText = "Unexpected login response"
            return
        end if
        username = ""
        if data.user.username <> invalid
            username = data.user.username as string
        end if
        m.auth = {
            serverUrl: m.loginServerUrl,
            accessToken: data.access_token as string,
            username: username
        }
        Prairie.Persist.saveLastServerUrl(m.loginServerUrl, m.store)
        showProfiles()
    else if pending = "profiles"
        profiles = Prairie.Auth.profilesFromResponse(response.data)
        m.screen.profiles = profiles
        m.screen.callFunc("focusDefault")
        if profiles.count() = 0
            m.screen.errorText = "No profiles on this account"
        end if
    else if pending = "verifyPin"
        data = response.data
        if data = invalid or data.valid <> true or data.profile_token = invalid
            m.screen.errorText = "Incorrect PIN"
            return
        end if
        finishProfile(m.pinProfile, data.profile_token)
    else if pending = "home"
        sections = Prairie.Home.sectionsFromResponse(response.data)
        m.screen.sections = sections
        m.screen.callFunc("focusDefault")
        if sections.count() = 0
            m.screen.errorText = "No home sections yet"
        end if
    else if pending = "libraries"
        libraries = Prairie.Libraries.librariesFromResponse(response.data)
        m.screen.libraries = libraries
        m.screen.callFunc("focusDefault")
        if libraries.count() = 0
            m.screen.errorText = "No libraries yet"
        end if
    else if pending = "catalog" or pending = "catalogMore"
        page = Prairie.Catalog.pageFromResponse(response.data)
        applyCatalogPage(page, pending = "catalogMore")
    else if pending = "search"
        page = Prairie.Catalog.pageFromResponse(response.data)
        m.screen.items = page.items
        if page.items.count() = 0
            m.screen.statusText = "No matches"
        else
            m.screen.statusText = ""
        end if
        m.screen.callFunc("focusDefault")
    else if pending = "collectionsLibraries"
        libraries = Prairie.Libraries.librariesFromResponse(response.data)
        m.collectionLibraryQueue = []
        for each library in libraries
            m.collectionLibraryQueue.push(library)
        end for
        m.libraryCollectionCards = []
        loadNextLibraryCollections()
    else if pending = "libraryCollections"
        cards = Prairie.Collections.flattenLibraryCollections(m.pendingLibraryId, response.data)
        for each card in cards
            m.libraryCollectionCards.push(card)
        end for
        loadNextLibraryCollections()
    else if pending = "personalCollections"
        m.personalCollectionCards = Prairie.Collections.flattenPersonalCollections(response.data)
        finishCollectionsScreen()
    else if pending = "itemDetail"
        detail = response.data
        if detail = invalid or type(detail) <> "roAssociativeArray"
            m.screen.errorText = "Unexpected item response"
            return
        end if
        m.detailItem = detail
        m.screen.detail = detail
        m.screen.callFunc("focusDefault")
        if isSeriesDetail(detail)
            loadSeasons()
        end if
    else if pending = "seasons"
        seasons = Prairie.Catalog.seasonsFromResponse(response.data)
        m.screen.seasons = seasons
        if seasons.count() > 0 and seasons[0].season_number <> invalid
            loadEpisodes(seasons[0].season_number as integer)
        else
            m.screen.callFunc("focusDefault")
        end if
    else if pending = "episodes"
        episodes = Prairie.Catalog.episodesFromResponse(response.data)
        m.screen.episodes = episodes
        m.screen.callFunc("focusDefault")
    else if pending = "watchForPlay"
        watch = response.data
        if watch = invalid
            m.screen.errorText = "Could not load watch details"
            return
        end if
        if watch.versions = invalid
            watch.versions = []
        end if
        fileId = Prairie.Watch.selectPlaybackFileId(watch)
        if fileId = invalid
            m.screen.errorText = "No playable file for this title"
            return
        end if
        title = m.playLaunch.title
        if watch.title <> invalid and (watch.title as string).len() > 0
            title = watch.title as string
        end if
        showPlayer({
            fileId: fileId as integer,
            title: title,
            contentId: m.playLaunch.contentId,
            startPosition: Prairie.Playback.resumeSeconds(watch),
            watch: watch
        })
    else if pending = "playbackStart"
        playback = response.data
        if playback = invalid or playback.session_id = invalid or playback.stream_url = invalid
            m.screen.errorText = "Playback failed to start"
            return
        end if
        m.playbackSession = playback
        if playback.audio_track_index <> invalid
            m.audioTrackIndex = playback.audio_track_index as integer
        end if
        streamUrl = Prairie.Playback.resolveStreamUrl(m.session.serverUrl, playback, m.session.accessToken)
        m.screen.streamFormat = Prairie.Playback.detectStreamFormat(playback)
        m.screen.busy = false
        m.screen.streamUrl = streamUrl
        m.screen.callFunc("focusDefault")
    else if pending = "audioSwitch"
        updated = response.data
        if updated = invalid or updated.stream_url = invalid
            m.screen.errorText = "Could not switch audio"
            return
        end if
        m.playbackSession.stream_url = updated.stream_url
        m.playbackSession.play_method = updated.play_method
        m.playbackSession.audio_track_index = updated.audio_track_index
        if updated.audio_track_index <> invalid
            m.audioTrackIndex = updated.audio_track_index as integer
        end if
        resumeAt = m.screen.positionSeconds
        if updated.player_start_seconds <> invalid
            resumeAt = updated.player_start_seconds
        end if
        m.screen.startPosition = resumeAt
        m.screen.streamFormat = Prairie.Playback.detectStreamFormat(m.playbackSession)
        m.screen.streamUrl = Prairie.Playback.resolveStreamUrl(m.session.serverUrl, m.playbackSession, m.session.accessToken)
        m.screen.errorText = "Audio track " + (m.audioTrackIndex + 1).toStr()
    end if
end sub
