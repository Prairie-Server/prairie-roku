    m.homeReturnFocus = m.screen.lastRowItem
    showSectionBrowse(section)
end sub

sub onHomeNavRequested()
    entryId = m.screen.navRequested
    if entryId = "search"
        showSearch()
    else if entryId = "home"
        showHome()
    else if entryId = "foryou"
        showForYou()
    else if entryId = "calendar"
        showCalendar()
    else if entryId = "livetv"
        showLiveTv()
    else if entryId = "profile"
        showProfileMenu()
    else
        entries = currentNavEntries()
        index = Prairie.Nav.indexOfEntry(entries, entryId)
        if index >= 0
            showNavTab(entries[index])
        end if
    end if
end sub

