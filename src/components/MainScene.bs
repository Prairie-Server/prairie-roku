sub onSettingsSave()
    payload = m.screen.saveRequested
    if payload = invalid
        return
    end if
    ' Preserve in-player quality preference when saving force/subtitle settings.
    current = Prairie.PlaybackSettings.load(m.store)
    if payload.preferredQuality = invalid
        payload.preferredQuality = current.preferredQuality
    end if
    Prairie.PlaybackSettings.save(payload, m.store)
end sub

' Profile Selection applies at once; it also answers a pending remember offer.
sub onSettingsProfileSelection()
    chosen = m.screen.profileSelectionChosen
    if chosen = invalid or (chosen as string).len() = 0
        return
    end if
    m.profileLaunch = Prairie.ProfileLaunch.withBehavior(m.profileLaunch, chosen as string)
    Prairie.ProfileLaunch.save(m.profileLaunch, m.store)
    m.screen.profileSelection = m.profileLaunch.behavior
    m.screen.profileSelectionDescription = Prairie.ProfileLaunch.behaviorDescription(m.profileLaunch.behavior)
end sub

sub onSettingsBack()
    back = m.settingsBackRoute
    if back = "livetv"
        showLiveTv()
    else
        showHome()
