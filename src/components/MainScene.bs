sub startPlaybackSession()
    if m.session = invalid or m.playLaunch = invalid
        return
    end if
    m.pending = "playbackStart"
    if m.screen <> invalid
        m.screen.busy = true
    end if
    forced = Prairie.Playback.forcedPlayMethodFromStore(m.store)
    settings = Prairie.PlaybackSettings.load(m.store)
    body = Prairie.Playback.buildStartBody({
        fileId: m.playLaunch.fileId,
        profileId: m.session.profileId,
        forcedPlayMethod: forced,
        qualityPreference: settings.preferredQuality,
        startPosition: m.playLaunch.startPosition,
        audioTrackIndex: rememberedAudioIndex()
    })
    requestBody = ParseJson(body)
    if requestBody <> invalid and requestBody.playback_attempt_id <> invalid
        m.playbackAttemptId = requestBody.playback_attempt_id as string
    else
        m.playbackAttemptId = invalid
    end if
    m.playbackRoute = "v2"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), "/api/v2/playback/start", "POST", body)
    m.httpTask.control = "RUN"
end sub

' Series the playing episode belongs to ("" for movies and unknown).
function playLaunchSeriesId() as string
    if m.playLaunch = invalid or m.playLaunch.watch = invalid
        return ""
    end if
    seriesId = m.playLaunch.watch.series_id
    if seriesId = invalid
        return ""
    end if
    return seriesId as string
end function

' Audio index remembered for this series, matched by language (android #680).
function rememberedAudioIndex() as dynamic
    seriesId = playLaunchSeriesId()
    if seriesId.len() = 0
        return invalid
    end if
    version = activeWatchVersion()
    if version = invalid
        return invalid
    end if
    return Prairie.TrackMemory.resolveAudioIndex(Prairie.TrackMemory.recall(m.store, seriesId), version.audio_tracks)
end function

sub startPlaybackTranscode(seekSeconds as dynamic, qualityId = invalid as dynamic)
    if m.session = invalid or m.playbackSession = invalid
        return
    end if
    sid = m.playbackSession.session_id
    if sid = invalid or (sid as string).len() = 0
        return
    end if
    m.pending = "playbackTranscodeStart"
    if m.screen <> invalid
        m.screen.busy = true
    end if

    ladder = m.qualityLadder
    if ladder = invalid
        ladder = Prairie.QualityLadder.fallbackLadder()
    end if
    version = activeWatchVersion()
    sourceResolution = ""
    sourceBitrate = 0
    if version <> invalid
        if version.resolution <> invalid
            sourceResolution = version.resolution as string
        end if
        if version.bitrate <> invalid
            sourceBitrate = version.bitrate as integer
        end if
    end if
    options = Prairie.QualityLadder.buildQualityOptions({
        ladder: ladder,
        playMethod: m.playbackSession.play_method,
        sourceResolution: sourceResolution,
        sourceBitrateKbps: sourceBitrate,
        nativeHeight: Prairie.QualityLadder.sourceHeightForVersion(version, ladder)
    })
    settings = Prairie.PlaybackSettings.load(m.store)
    chosen = qualityId
    if chosen = invalid or (chosen as string).len() = 0
        chosen = Prairie.QualityLadder.autoStartQualityId({
            playMethod: m.playbackSession.play_method,
            preferredQuality: settings.preferredQuality,
            options: options
        })
    end if
    m.activeQualityId = chosen as string
    if m.screen <> invalid
        m.screen.qualityOptions = options
        m.screen.activeQualityId = m.activeQualityId
    end if

    deviceMax = Prairie.QualityLadder.deviceDisplayHeight()
    ' Auto: also cap by source height so we don't upscale.
    if LCase(m.activeQualityId) = "auto"
        nativeH = Prairie.QualityLadder.sourceHeightForVersion(version, ladder)
        if nativeH > 0 and (deviceMax <= 0 or nativeH < deviceMax)
            deviceMax = nativeH
        end if
    end if
    targets = Prairie.QualityLadder.resolveQualityTargets({
        qualityId: m.activeQualityId,
        options: options,
        playMethod: m.playbackSession.play_method,
        ladder: ladder,
        deviceMaxHeight: deviceMax
    })

    bodyInput = {
        sessionId: sid as string,
        seekSeconds: seekSeconds,
        playMethod: m.playbackSession.play_method
    }
    if targets <> invalid
        bodyInput.targetResolution = targets.resolution
        bodyInput.targetBitrateKbps = targets.bitrateKbps
        bodyInput.copyVideo = targets.copyVideo
    end if
    body = Prairie.Playback.buildTranscodeStartBody(bodyInput)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.transcodeStartPath(), "POST", body)
    m.httpTask.control = "RUN"
end sub

sub applyPlayerStream(playback as object)
    if m.screen = invalid or m.session = invalid or playback = invalid
        return
    end if
    streamUrl = Prairie.Playback.resolveStreamUrl(m.session.serverUrl, playback, m.session.accessToken)
    m.screen.streamFormat = Prairie.Playback.detectStreamFormat(playback)
    m.screen.busy = false
    if playback.effective_height <> invalid
        m.screen.effectiveHeight = playback.effective_height as integer
    end if
    m.screen.streamUrl = streamUrl
    m.screen.activeQualityId = m.activeQualityId
    refreshPlayerQualityOptions()
    paintPlayerStats()
    m.screen.callFunc("focusDefault")
end sub

sub reportPlayerProgress(force as boolean)
    if m.session = invalid or m.playbackSession = invalid or m.screen = invalid
        return
    end if
    if m.route <> "player"
        return
    end if
    sid = m.playbackSession.session_id
    if sid = invalid or (sid as string).len() = 0
        return
    end if
    position = m.screen.positionSeconds
    isPaused = m.screen.isPaused
    req = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.progressPath(sid as string), "POST", Prairie.Playback.buildProgressBody(position, isPaused))
    m.progressTask.request = req
    m.progressTask.control = "RUN"
end sub

sub stopPlaybackSessionAsync()
    if m.session = invalid or m.playbackSession = invalid
        return
    end if
    sid = m.playbackSession.session_id
    if sid = invalid or (sid as string).len() = 0
        return
    end if
    req = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.sessionPath(sid as string), "DELETE")
    m.progressTask.request = req
    m.progressTask.control = "RUN"
end sub

function isSeriesDetail(detail as object) as boolean
    if detail = invalid or detail.type = invalid
        return false
    end if
    lower = LCase(detail.type as string)
    return lower = "series" or lower = "show" or lower = "tv"
end function

sub onConnectSubmit()
    req = m.screen.submitRequest
    if req = invalid or type(req.urls) <> "roArray" or req.urls.count() = 0
        return
    end if
    stopQuickConnect()
    startServerProbe("login", req.urls, req.loginBody as string)
end sub

sub loadProfiles()
