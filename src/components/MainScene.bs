' A library-type top bar entry. One library opens that library; several
' page the catalog by type (Movies, Series, Audiobooks) or, for Music, which
' has no catalog type, open the Libraries list.
sub showNavTab(entry as object)
    libraries = entry.libraries
    if libraries = invalid or libraries.count() = 0
        return
    end if
    if libraries.count() = 1
        m.libraryBackRoute = "home"
        showLibraryBrowse(libraries[0])
        return
    end if
    catalogType = Prairie.Nav.tabCatalogType(entry.id)
    if catalogType.len() = 0
        showLibraries()
        return
    end if
    m.browseTab = { id: entry.id, label: entry.label, catalogType: catalogType }
    showTabBrowse()
end sub

