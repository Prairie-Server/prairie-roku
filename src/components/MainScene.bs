sub init()
    m.top.backgroundURI = ""
    m.top.backgroundColor = Prairie.Theme.colors().bg
    m.store = Prairie.Store.createRegistryStore("prairie")
    Prairie.Persist.ensureStorageSchema(m.store)
    m.registry = Prairie.ServerRegistry.migrateFromLegacy(m.store)

    m.screenHost = m.top.findNode("screenHost")
    m.httpTask = m.top.findNode("httpTask")
    m.httpTask.observeField("response", "onHttpResponse")
    m.progressTask = m.top.findNode("progressTask")
    m.progressTask.observeField("response", "onProgressResponse")
    m.markersTask = m.top.findNode("markersTask")
    m.markersTask.observeField("response", "onMarkersResponse")
    m.markersFileId = -1
    m.quickConnectTimer = m.top.findNode("quickConnectTimer")
    m.quickConnectTimer.observeField("fire", "onQuickConnectTimerFire")

    m.pending = ""
    m.auth = invalid
    m.session = Prairie.Session.loadSession(m.store)
    m.pinProfile = invalid
    m.catalogItems = []
    m.catalogSnapshot = ""
    m.catalogHasMore = false
    m.browseLibrary = invalid
    m.browseCollection = invalid
    m.browseSection = invalid
    m.browseTab = invalid
    m.libraryBackRoute = "libraries"
    m.homeItemLimit = -1
    m.navLibraries = invalid
    m.navHasLiveTv = false
    m.navLiveTvKnown = false
    m.navCacheKey = ""
    m.homeReturnFocus = invalid
    m.detailChain = invalid
    m.profilesBackRoute = ""
    m.profileMenuDialog = invalid
    m.episodesSeason = -1
    m.collectionLibraryQueue = []
    m.libraryCollectionCards = []
    m.personalCollectionCards = []
    m.detailContentId = ""
    m.ratingPrevious = 0
    m.ratingDialog = invalid
    m.detailBackRoute = "home"
    m.detailItem = invalid
    m.playLaunch = invalid
    m.playbackSession = invalid
    m.audioTrackIndex = 0
    m.activeQualityId = "original"
    m.qualityLadder = invalid
    m.exitingPlayer = false
    m.liveChannels = []
    m.livePrograms = []
    m.liveRecordings = []
    m.liveSessionId = ""
    m.liveChannel = invalid
    m.settingsBackRoute = "home"
    m.discoverQueue = []
    m.discoverHits = []
    m.discoverIndex = 0
    m.discoverCurrentUrl = ""
    m.discoverDeep = false
    m.serverListBackRoute = "connect"
    m.connectPrefillUrl = ""
    m.connectNotice = ""
    m.serverProbe = invalid
    m.signOutTask = invalid
    m.signOutTarget = invalid
    m.signOutDialog = invalid
    m.quickConnectDeviceCode = ""
    m.quickConnectRenewed = false
    m.quickConnectServerUrl = ""
    m.quickConnectInterval = 3
    m.playbackRoute = "v2"
    m.profileLaunch = Prairie.ProfileLaunch.load(m.store)
    m.resume = invalid
    m.rememberOfferDialog = invalid
    m.watchedWrites = {}
    m.watchedGeneration = 0
    m.cardOptions = invalid
    m.cardOptionsDialog = invalid
    m.cardActions = []

    ' If the persisted session blob exists but tokens are missing, treat the
    ' user as logged out and route to the login/connect flow.
    if m.session <> invalid and not Prairie.Session.hasAccessToken(m.session)
        m.connectPrefillUrl = m.session.serverUrl
        m.session = invalid
    end if

    if m.session = invalid
        m.session = sessionFromActiveRegistry()
    end if

    initFeatures()
    if m.session <> invalid and Prairie.Session.hasAccessToken(m.session)
        showHome()
    else if not resumeSavedSession(startupServerUrl())
        showConnect()
    end if
end sub

' The server this TV last used: the active saved server, else the last URL.
function startupServerUrl() as string
    idx = Prairie.ServerRegistry.findIndex(m.registry, m.registry.activeServerId)
    if idx >= 0
        return m.registry.entries[idx].url as string
    end if
    return Prairie.Persist.loadLastServerUrl(m.store)
end function

function serverDisplayName(url as string) as string
    entry = Prairie.ServerRegistry.findByUrl(m.registry, url)
    if entry <> invalid and entry.fetchedName <> invalid and (entry.fetchedName as string).trim().len() > 0
        return (entry.fetchedName as string).trim()
    end if
    return url
end function

' A saved session for url skips sign-in, as on Android TV / Apple TV: renew
' it with the refresh token, then Who's Watching (or the remembered profile).
' False when this TV has no saved session for url.
function resumeSavedSession(url as string) as boolean
    if url.len() = 0
        return false
    end if
    saved = Prairie.Credentials.forServer(m.store, url)
    if saved = invalid
        return false
    end if
    m.session = invalid
    m.auth = invalid
    showProfiles("")
    m.resume = {
        serverUrl: url,
        username: saved.username
    }
    m.screen.username = saved.username
    m.screen.busy = true
    m.pending = "sessionRefresh"
    m.httpTask.request = Prairie.Api.buildRequest({ serverUrl: url }, Prairie.Credentials.refreshPath(), "POST", Prairie.Credentials.buildRefreshBody(saved.refreshToken))
    m.httpTask.control = "RUN"
    return true
end function

' A renewed session loads the profiles. A session the server rejects is
' forgotten; one that can't be checked (network) is kept for the next try.
' Either way the sign-in screen explains what happened.
sub onSessionRefreshResponse(response as object)
    target = m.resume
    if target = invalid
        return
    end if
    if response.ok = true
        renewed = Prairie.Credentials.parseRefresh(response.data)
        if renewed.ok
            ' The server rotates the refresh token: keep the new one at once.
            if renewed.refreshToken.len() > 0
                Prairie.Credentials.remember(m.store, target.serverUrl, renewed.refreshToken, target.username)
            end if
            m.auth = {
                serverUrl: target.serverUrl,
                accessToken: renewed.accessToken,
                username: target.username,
                refreshToken: renewed.refreshToken
            }
            Prairie.Persist.saveLastServerUrl(target.serverUrl, m.store)
            loadProfiles()
            return
        end if
    end if
    status = 0
    if response.ok <> true and response.error <> invalid and response.error.status <> invalid
        status = response.error.status as integer
    end if
    rejected = Prairie.Credentials.isSessionRejected(status)
    if rejected
        Prairie.Credentials.forget(m.store, target.serverUrl)
    end if
    m.resume = invalid
    m.connectPrefillUrl = target.serverUrl
    m.connectNotice = Prairie.Credentials.resumeFailedMessage(serverDisplayName(target.serverUrl), rejected)
    showConnect()
end sub

' After a resumed session's profiles load: Automatic opens the profile last
' picked on this server. A profile with a PIN still asks for it.
sub autoOpenRememberedProfile(url as string, profiles as object)
    remembered = ""
    entry = Prairie.ServerRegistry.findByUrl(m.registry, url)
    if entry <> invalid and entry.profileId <> invalid
        remembered = entry.profileId as string
    end if
    pick = Prairie.ProfileLaunch.autoOpen(m.profileLaunch, profiles, remembered)
    if pick = invalid
        return
    end if
    if pick.needsPin
        askProfilePin(pick.profile)
        return
    end if
    finishProfile(pick.profile, invalid)
end sub

function sessionFromActiveRegistry() as dynamic
    return invalid
end function

sub clearScreen()
    if m.screenHost = invalid
        return
    end if
    stopDiscovery()
    stopQuickConnect()
    if m.httpTask <> invalid
        m.httpTask.control = "STOP"
    end if
    m.pending = ""
    m.screenGeneration = m.screenGeneration + 1
    if not m.keepThemeMusic
        stopThemeMusic()
    end if
    ' Drop any cached login body (password) when leaving the connect flow.
    m.serverProbe = invalid
    m.pinProfile = invalid
    m.resume = invalid
    while m.screenHost.getChildCount() > 0
        m.screenHost.removeChildIndex(0)
    end while
    m.screen = invalid
end sub

sub stopQuickConnect()
    m.quickConnectDeviceCode = ""
    m.quickConnectServerUrl = ""
    m.quickConnectInterval = 3
    m.quickConnectRenewed = false
    if m.quickConnectTimer <> invalid
        m.quickConnectTimer.control = "stop"
    end if
end sub

sub showConnect()
    clearScreen()
    m.route = "connect"
    m.auth = invalid
    m.session = invalid
    stopDiscovery()
    screen = CreateObject("roSGNode", "ConnectScreen")
    prefill = m.connectPrefillUrl
    if prefill.len() = 0
        prefill = Prairie.Persist.loadLastServerUrl(m.store)
    end if
    m.connectPrefillUrl = ""
    screen.observeField("submitRequest", "onConnectSubmit")
    screen.observeField("quickConnectStartRequested", "onQuickConnectStartRequested")
    screen.observeField("openServers", "onOpenServers")
    screen.observeField("scanRequested", "onConnectScanRequested")
    m.screenHost.appendChild(screen)
    m.screen = screen
    screen.initialServerUrl = prefill
    if m.connectNotice.len() > 0
        screen.errorText = m.connectNotice
        m.connectNotice = ""
    end if
    screen.callFunc("focusDefault")
end sub

sub paintSignInState(state as string, activate = "" as string)
    if m.route <> "connect" or m.screen = invalid
        return
    end if
    m.screen.quickConnectActivate = activate
    m.screen.quickConnectState = state
    if state <> "waiting" and state <> "newCode"
        m.screen.quickConnectUserCode = ""
        m.screen.quickConnectMatchCode = ""
        m.screen.quickConnectVerificationUri = ""
    end if
end sub

sub onQuickConnectStartRequested()
    if m.route <> "connect" or m.screen = invalid
        return
    end if
    if m.screen.busy = true
        return
    end if
    resolved = m.screen.callFunc("serverCandidates")
    stopQuickConnect()
    if resolved = invalid or resolved.ok <> true
        paintSignInState("failed")
        if resolved <> invalid
            m.screen.quickConnectStatus = resolved.message
        end if
        return
    end if
    paintSignInState("gettingCode")
    startServerProbe("quickConnect", resolved.urls, "")
end sub

' Try each candidate address in turn (Auto: HTTPS, HTTP, then port 8090)
' with GET /auth/setup; the first that answers as Prairie is used for
' purpose "login" (loginBody is then posted) or "quickConnect".
sub startServerProbe(purpose as string, urls as object, loginBody as string)
    m.serverProbe = {
        purpose: purpose,
        urls: urls,
        index: 0,
        currentUrl: "",
        loginBody: loginBody,
        lastError: invalid
    }
    probeNextServerCandidate()
end sub

sub probeNextServerCandidate()
    probe = m.serverProbe
    if probe = invalid
        return
    end if
    if probe.index >= probe.urls.count()
        finishServerProbeFailure(Prairie.ServerAddress.probeFailureMessage(probe.lastError))
        return
    end if
    url = probe.urls[probe.index]
    probe.index = probe.index + 1
    probe.currentUrl = url
    m.pending = "serverProbe"
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: url,
        timeoutMs: 10000
    }, Prairie.Auth.setupStatusPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub onServerProbeResponse(response as object)
    probe = m.serverProbe
    if probe = invalid or m.route <> "connect"
        return
    end if
    if response.ok <> true
        probe.lastError = response.error
        probeNextServerCandidate()
        return
    end if
    setup = Prairie.Auth.parseSetupStatus(response.data)
    if setup.ok <> true
        ' Something answered, but not as Prairie: try the next address.
        probe.lastError = {
            status: 200,
            code: invalid,
            body: invalid
        }
        probeNextServerCandidate()
        return
    end if
    if setup.needsSetup = true
        finishServerProbeFailure("This server needs setup in a browser on another device. Create the first account there, then try again.")
        return
    end if
    url = probe.currentUrl as string
    m.serverProbe = invalid
    if probe.purpose = "quickConnect"
        m.quickConnectServerUrl = url
        requestDeviceCode(false)
        return
    end if
    m.loginServerUrl = url
    m.pending = "login"
    if m.screen <> invalid and m.screen.hasField("busy")
        m.screen.busy = true
    end if
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: url
    }, Prairie.Auth.loginPath(), "POST", probe.loginBody)
    m.httpTask.control = "RUN"
end sub

sub finishServerProbeFailure(message as string)
    probe = m.serverProbe
    m.serverProbe = invalid
    if m.screen = invalid or m.route <> "connect" or probe = invalid
        return
    end if
    if probe.purpose = "quickConnect"
        paintSignInState("failed")
        m.screen.quickConnectStatus = message
        return
    end if
    m.screen.busy = false
    m.screen.errorText = message
end sub

' The name the person gave this Roku (Settings > System > About).
function deviceFriendlyName() as dynamic
    info = CreateObject("roDeviceInfo")
    if info = invalid
        return invalid
    end if
    return info.GetFriendlyName()
end function

' Ask for a sign-in code on the resolved server; renewed marks a code that
' replaces an expired one ("New code. Waiting for approval.").
sub requestDeviceCode(renewed as boolean)
    if m.quickConnectServerUrl.len() = 0
        return
    end if
    m.quickConnectDeviceCode = ""
    m.quickConnectRenewed = renewed
    if m.quickConnectTimer <> invalid
        m.quickConnectTimer.control = "stop"
    end if
    if not renewed
        paintSignInState("gettingCode")
    end if
    m.pending = "deviceStart"
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.quickConnectServerUrl
    }, Prairie.Auth.deviceStartPath(), "POST", Prairie.Auth.buildDeviceStartBody(Prairie.SignIn.deviceName(deviceFriendlyName()), Prairie.Theme.devicePlatformHeader()))
    m.httpTask.control = "RUN"
end sub

sub applyDeviceSignInResponse(pending as string, response as object)
    if m.route <> "connect" or m.screen = invalid
        return
    end if
    if response.ok <> true
        status = 0
        if response.error <> invalid and response.error.status <> invalid
            status = response.error.status as integer
        end if
        if pending = "deviceStart"
            paintSignInState("failed")
            return
        end if
        if status = 404 or status = 410
            ' The code is gone on the server: show a new one.
            requestDeviceCode(true)
            return
        end if
        scheduleQuickConnectPoll(m.quickConnectInterval)
        return
    end if
    if pending = "deviceStart"
        started = Prairie.Auth.parseDeviceStart(response.data)
        if started.ok <> true
            paintSignInState("failed")
            return
        end if
        m.quickConnectDeviceCode = started.deviceCode
        m.quickConnectInterval = started.interval
        state = "waiting"
        if m.quickConnectRenewed
            state = "newCode"
        end if
        paintSignInState(state, started.verificationUri)
        m.screen.quickConnectUserCode = started.userCode
        m.screen.quickConnectMatchCode = started.matchCode
        m.screen.quickConnectVerificationUri = started.verificationUriComplete
        scheduleQuickConnectPoll(m.quickConnectInterval)
        return
    end if
    polled = Prairie.Auth.parseDevicePoll(response.data)
    if polled.ok <> true
        scheduleQuickConnectPoll(m.quickConnectInterval)
        return
    end if
    if polled.status = "approved" and polled.accessToken <> invalid and polled.user <> invalid
        applyQuickConnectLogin(polled)
        return
    end if
    if polled.status = "denied"
        m.quickConnectDeviceCode = ""
        paintSignInState("declined")
        return
    end if
    if polled.status = "expired" or polled.status = "consumed"
        requestDeviceCode(true)
        return
    end if
    scheduleQuickConnectPoll(polled.pollAfter)
end sub

sub scheduleQuickConnectPoll(seconds as integer)
    if m.quickConnectTimer = invalid
        return
    end if
    waitSeconds = seconds
    if waitSeconds < 1
        waitSeconds = 3
    end if
    m.quickConnectTimer.duration = waitSeconds
    m.quickConnectTimer.control = "stop"
    m.quickConnectTimer.control = "start"
end sub

sub onQuickConnectTimerFire()
    if m.route <> "connect"
        return
    end if
    if m.quickConnectDeviceCode.len() = 0 or m.quickConnectServerUrl.len() = 0
        return
    end if
    if m.pending <> "" and m.pending <> "devicePoll"
        ' Another request owns the HTTP task (password login). Retry shortly.
        scheduleQuickConnectPoll(m.quickConnectInterval)
        return
    end if
    m.pending = "devicePoll"
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.quickConnectServerUrl
    }, Prairie.Auth.devicePollPath(), "POST", Prairie.Auth.buildDevicePollBody(m.quickConnectDeviceCode))
    m.httpTask.control = "RUN"
end sub

sub applyQuickConnectLogin(data as object)
    username = ""
    if data.user <> invalid and data.user.username <> invalid
        username = data.user.username as string
    end if
    m.auth = {
        serverUrl: m.quickConnectServerUrl,
        accessToken: data.accessToken as string,
        username: username,
        refreshToken: data.refreshToken
    }
    Prairie.Persist.saveLastServerUrl(m.quickConnectServerUrl, m.store)
    stopQuickConnect()
    showProfiles()
end sub

sub showServerList(backRoute = "connect" as string)
    clearScreen()
    m.route = "servers"
    m.serverListBackRoute = backRoute
    screen = CreateObject("roSGNode", "ServerListScreen")
    screen.observeField("selectedServer", "onServerSelected")
    screen.observeField("selectedDiscovery", "onDiscoverySelected")
    screen.observeField("scanRequested", "onServerScanRequested")
    screen.observeField("addManualRequested", "onServerAddManual")
    screen.observeField("removeRequested", "onServerRemoveRequested")
    screen.observeField("backRequested", "onServerListBack")
    m.screenHost.appendChild(screen)
    m.screen = screen
    paintServerList()
    screen.callFunc("focusDefault")
end sub

sub paintServerList()
    if m.screen = invalid or m.route <> "servers"
        return
    end if
    m.registry = Prairie.ServerRegistry.load(m.store)
    cards = []
    for each entry in Prairie.ServerRegistry.sortedEntries(m.registry)
        cards.push({
            id: entry.id,
            url: entry.url,
            displayName: Prairie.ServerRegistry.displayName(entry),
            isActive: entry.id = m.registry.activeServerId
        })
    end for
    m.screen.servers = cards
    m.screen.discovered = m.discoverHits
end sub

sub stopDiscovery()
    m.discoverQueue = []
    m.discoverIndex = 0
    m.discoverCurrentUrl = ""
    if m.pending = "discoverProbe"
        m.pending = ""
        if m.httpTask <> invalid
            m.httpTask.control = "STOP"
        end if
    end if
end sub

sub startDiscovery(deepScan = true as boolean)
    m.registry = Prairie.ServerRegistry.load(m.store)
    m.discoverDeep = deepScan
    m.discoverHits = []

    ' Cross-subnet base hosts come from saved/manual server URLs.
    ' Admin publishes one A record for that hostname; discovery probes the
    ' resolved IP by hitting Prairie /api/v1/health on candidate ports.
    m.baseHosts = []
    baseSeen = {}
    for each entry in m.registry.entries
        if entry <> invalid and entry.url <> invalid
            origin = Prairie.Url.parseOrigin(entry.url as string)
            if origin <> invalid and origin.host <> invalid
                host = Prairie.ServerUrl.stripPort(origin.host as string)
                key = LCase(host)
                if host.len() > 0 and not baseSeen.doesExist(key)
                    baseSeen[key] = true
                    m.baseHosts.push(host)
                end if
            end if
        end if
    end for

    lastUrl = Prairie.Persist.loadLastServerUrl(m.store)
    if lastUrl <> invalid and lastUrl.len() > 0
        origin = Prairie.Url.parseOrigin(lastUrl)
        if origin <> invalid and origin.host <> invalid
            host = Prairie.ServerUrl.stripPort(origin.host as string)
            key = LCase(host)
            if host.len() > 0 and not baseSeen.doesExist(key)
                baseSeen[key] = true
                m.baseHosts.push(host)
            end if
        end if
    end if

    m.discoverQueue = Prairie.Discover.buildCandidates(m.registry.scanCidrs, deepScan, 254, m.baseHosts)
    m.discoverIndex = 0
    m.discoverCurrentUrl = ""
    if m.screen <> invalid and m.screen.hasField("busy")
        m.screen.busy = true
    end if
    if m.screen <> invalid and m.screen.hasField("statusText")
        m.screen.statusText = "Scanning for Prairie servers…"
    end if
    if m.screen <> invalid and m.screen.hasField("errorText")
        m.screen.errorText = ""
    end if
    if m.route = "servers"
        paintServerList()
    end if
    probeNextDiscoverCandidate()
end sub

sub probeNextDiscoverCandidate()
    if m.discoverIndex >= m.discoverQueue.count()
        finishDiscovery()
        return
    end if
    url = m.discoverQueue[m.discoverIndex]
    m.discoverCurrentUrl = url
    m.discoverIndex = m.discoverIndex + 1
    m.pending = "discoverProbe"
    if m.screen <> invalid and m.screen.hasField("statusText")
        total = m.discoverQueue.count()
        done = m.discoverIndex
        m.screen.statusText = "Scanning " + done.toStr() + "/" + total.toStr() + "…"
    end if
    m.httpTask.request = Prairie.Discover.buildProbeRequest(url, 400)
    m.httpTask.control = "RUN"
end sub

sub finishDiscovery()
    m.pending = ""
    if m.screen <> invalid and m.screen.hasField("busy")
        m.screen.busy = false
    end if
    if m.screen <> invalid and m.screen.hasField("statusText")
        if m.discoverHits.count() = 0
            m.screen.statusText = "No Prairie servers found on the LAN"
        else
            m.screen.statusText = "Found " + m.discoverHits.count().toStr() + " server(s)"
        end if
    end if
    if m.route = "servers"
        paintServerList()
        m.screen.callFunc("focusDefault")
    end if
end sub

sub showProfiles(backRoute = "" as string)
    clearScreen()
    m.profilesBackRoute = backRoute
    m.route = "profiles"
    screen = CreateObject("roSGNode", "ProfileSelectScreen")
    if m.auth <> invalid
        screen.username = m.auth.username
    end if
    screen.observeField("selectedProfile", "onProfileChosen")
    screen.observeField("pinSubmit", "onPinSubmit")
    screen.observeField("cancelRequested", "onProfilesCancel")
    m.screenHost.appendChild(screen)
    m.screen = screen
    loadProfiles()
end sub

sub showHome()
    clearScreen()
    m.route = "home"
    resetNavCacheForSession()
    resetFeatureCacheForSession()
    loadRequestsStatus()
    screen = CreateObject("roSGNode", "HomeBrowseScreen")
    if m.session <> invalid and m.session.profileName <> invalid
        screen.profileName = m.session.profileName
    end if
    screen.navEntries = currentNavEntries()
    if m.homeReturnFocus <> invalid
        screen.restoreRowItem = m.homeReturnFocus
        m.homeReturnFocus = invalid
    end if
    screen.observeField("selectedContentId", "onHomeItemSelected")
    screen.observeField("cardOptionsRequested", "onCardOptionsRequested")
    screen.observeField("exploreSection", "onHomeExploreSection")
    screen.observeField("navRequested", "onHomeNavRequested")
    screen.observeField("openLibraries", "onOpenLibraries")
    screen.observeField("openSearch", "onOpenSearch")
    screen.observeField("openLiveTv", "onOpenLiveTv")
    screen.observeField("signOutRequested", "onSignOut")
    m.screenHost.appendChild(screen)
    m.screen = screen
    if m.homeItemLimit < 0
        loadHomeCapabilities()
    else
        loadHomeSections()
    end if
end sub

' Nav entries, the Home item_limit and Live TV presence are read once per
' server + profile; switching either reads them again.
sub resetNavCacheForSession()
    key = ""
    if m.session <> invalid
        key = m.session.serverUrl
        if m.session.profileId <> invalid
            key = key + "|" + (m.session.profileId as string)
        end if
    end if
    if key = m.navCacheKey
        return
    end if
    m.navCacheKey = key
    m.homeItemLimit = -1
    m.navLibraries = invalid
    m.navHasLiveTv = false
    m.navLiveTvKnown = false
    m.homeReturnFocus = invalid
end sub

function currentNavEntries() as object
    return Prairie.Nav.topEntries(m.navLibraries, m.navHasLiveTv)
end function

sub paintHomeNav()
    if m.route = "home" and m.screen <> invalid and m.screen.hasField("navEntries")
        m.screen.navEntries = currentNavEntries()
    end if
end sub

' After Home's rows: libraries for the type entries, then Live TV presence.
sub continueHomeNavLoad()
    if m.session = invalid or m.route <> "home"
        return
    end if
    if m.navLibraries = invalid
        m.pending = "navLibraries"
        m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Libraries.librariesPath(), "GET")
        m.httpTask.control = "RUN"
        return
    end if
    if not m.navLiveTvKnown
        m.pending = "navLiveTv"
        m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.LiveTv.channelsPath(), "GET")
        m.httpTask.control = "RUN"
    end if
end sub

sub loadHomeCapabilities()
    if m.session = invalid
        return
    end if
    m.pending = "homeCapabilities"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Home.capabilitiesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

