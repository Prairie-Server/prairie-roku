sub showPlayer(launch as object)
    clearScreen()
    m.route = "player"
    m.playLaunch = launch
    m.playbackSession = invalid
    m.exitingPlayer = false
    m.audioTrackIndex = 0
    m.activeQualityId = "original"
    screen = CreateObject("roSGNode", "PlayerScreen")
    screen.titleText = launch.title
    screen.busy = true
    if launch.startPosition <> invalid
        screen.startPosition = launch.startPosition
    end if
    screen.observeField("exitRequested", "onPlayerExit")
    screen.observeField("progressTick", "onPlayerProgressTick")
    screen.observeField("seekDelta", "onPlayerSeek")
    screen.observeField("audioCycleRequested", "onPlayerAudioCycle")
    screen.observeField("qualityChangeRequested", "onPlayerQualityChange")
    screen.observeField("autoQualityRequested", "onPlayerAutoQuality")
    applyPlayerTrickplay(screen)
    m.screenHost.appendChild(screen)
    m.screen = screen
    applyPlayerMarkers()
    if m.qualityLadder = invalid
        fetchQualityLadderThenPlay()
    else
        refreshPlayerQualityOptions()
        startPlaybackSession()
    end if
end sub

sub fetchQualityLadderThenPlay()
    if m.session = invalid
        m.qualityLadder = Prairie.QualityLadder.fallbackLadder()
        refreshPlayerQualityOptions()
        startPlaybackSession()
        return
    end if
    m.pending = "qualityLadder"
    if m.screen <> invalid
        m.screen.busy = true
    end if
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.qualityLadderPath(), "GET")
    m.httpTask.control = "RUN"
end sub

function activeWatchVersion() as dynamic
    if m.playLaunch = invalid or m.playLaunch.watch = invalid
        return invalid
    end if
    versions = m.playLaunch.watch.versions
    if versions = invalid or versions.count() = 0
        return invalid
    end if
    fileId = m.playLaunch.fileId
    if fileId <> invalid
        for each version in versions
            if version.file_id = fileId
                return version
            end if
        end for
    end if
    return versions[0]
end function

sub applyPlayerTrickplay(screen as object)
    if screen = invalid
        return
    end if
    version = activeWatchVersion()
    trickplay = Prairie.Trickplay.fromVersion(version)
    if trickplay = invalid or m.session = invalid
        screen.trickplay = trickplay
        return
    end if
    sheets = []
    for each sheet in trickplay.sheets
        nextSheet = {
            index: 0,
            url: ""
        }
        if sheet.index <> invalid
            nextSheet.index = sheet.index as integer
        end if
        if sheet.url <> invalid and (sheet.url as string).len() > 0
            nextSheet.url = Prairie.Url.buildStreamUrl(m.session.serverUrl, sheet.url as string, m.session.accessToken, invalid)
        end if
        sheets.push(nextSheet)
    end for
    trickplay.sheets = sheets
    screen.trickplay = trickplay
end sub

' Skip markers: start from the v1 watch version's first-occurrence fields,
' then upgrade to every occurrence from GET /api/v2/markers/files/{id}.
sub applyPlayerMarkers()
    if m.screen = invalid
        return
    end if
    timeline = Prairie.Markers.timelineFrom(activeWatchVersion())
    if timeline.count() = 0 and m.playLaunch <> invalid
        timeline = Prairie.Markers.timelineFrom(m.playLaunch.watch)
    end if
    m.screen.markerSegments = timeline
    m.markersFileId = -1
    if m.session = invalid or m.playLaunch = invalid or m.playLaunch.fileId = invalid
        return
    end if
    m.markersFileId = m.playLaunch.fileId as integer
    m.markersTask.control = "STOP"
    m.markersTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Markers.filesPath(m.markersFileId), "GET")
    m.markersTask.control = "RUN"
end sub

sub onMarkersResponse()
    response = m.markersTask.response
    if response = invalid or response.ok <> true or response.data = invalid
        return
    end if
    if m.route <> "player" or m.screen = invalid or m.markersFileId < 0
        return
    end if
    ' Drop a late answer for another file (file_id is an opaque string in v2).
    if response.data.file_id <> invalid and Str(m.markersFileId).trim() <> (response.data.file_id as string)
        return
    end if
    timeline = Prairie.Markers.timelineFrom(response.data)
    if timeline.count() > 0
        m.screen.markerSegments = timeline
    end if
end sub

sub refreshPlayerQualityOptions()
    if m.screen = invalid or m.route <> "player"
        return
    end if
    ladder = m.qualityLadder
    if ladder = invalid
        ladder = Prairie.QualityLadder.fallbackLadder()
    end if
    version = activeWatchVersion()
    sourceResolution = ""
    sourceBitrate = 0
    if version <> invalid
        if version.resolution <> invalid
            sourceResolution = version.resolution as string
        end if
        if version.bitrate <> invalid
            sourceBitrate = version.bitrate as integer
        end if
    end if
    playMethod = invalid
    if m.playbackSession <> invalid
        playMethod = m.playbackSession.play_method
    end if
    options = Prairie.QualityLadder.buildQualityOptions({
        ladder: ladder,
        playMethod: playMethod,
        sourceResolution: sourceResolution,
        sourceBitrateKbps: sourceBitrate,
        nativeHeight: Prairie.QualityLadder.sourceHeightForVersion(version, ladder)
    })
    m.screen.qualityOptions = options
    m.screen.activeQualityId = m.activeQualityId
end sub

sub paintPlayerStats()
    if m.screen = invalid or m.route <> "player"
        return
    end if
    sid = ""
    method = ""
    if m.playbackSession <> invalid
        if m.playbackSession.session_id <> invalid
            sid = m.playbackSession.session_id as string
        end if
        if m.playbackSession.play_method <> invalid
            method = m.playbackSession.play_method as string
        end if
    end if
    m.screen.statsSessionId = sid
    m.screen.statsPlayMethod = method
    stream = m.screen.streamUrl
    m.screen.statsStreamUrl = stream
    resolution = m.activeQualityId
    if m.screen.qualityOptions <> invalid
        for each opt in m.screen.qualityOptions
            if opt <> invalid and (opt.id as string) = m.activeQualityId and (opt.resolution as string).len() > 0
                resolution = opt.resolution as string
            end if
        end for
    end if
    m.screen.statsResolution = resolution
end sub

