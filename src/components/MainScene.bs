sub showPlayer(launch as object)
    clearScreen()
    m.route = "player"
    m.playLaunch = launch
    m.playbackSession = invalid
    m.exitingPlayer = false
    m.audioTrackIndex = 0
    screen = CreateObject("roSGNode", "PlayerScreen")
    screen.titleText = launch.title
    screen.busy = true
    if launch.startPosition <> invalid
        screen.startPosition = launch.startPosition
    end if
    screen.observeField("exitRequested", "onPlayerExit")
    screen.observeField("progressTick", "onPlayerProgressTick")
    screen.observeField("seekDelta", "onPlayerSeek")
    screen.observeField("audioCycleRequested", "onPlayerAudioCycle")
    m.screenHost.appendChild(screen)
    m.screen = screen
    startPlaybackSession()
end sub

sub loadItemDetail()
    if m.session = invalid or m.detailContentId.len() = 0
        return
    end if
    m.pending = "itemDetail"
    m.screen.busy = true
    path = Prairie.Catalog.itemDetailPath(m.detailContentId)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub loadSeasons()
    if m.session = invalid
        return
    end if
    m.pending = "seasons"
    path = Prairie.Catalog.seasonsPath(m.detailContentId)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub loadEpisodes(seasonNumber as integer)
    if m.session = invalid
        return
    end if
    m.pending = "episodes"
    path = Prairie.Catalog.episodesPath(m.detailContentId, seasonNumber)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub startPlaybackSession()
    if m.session = invalid or m.playLaunch = invalid
        return
    end if
    m.pending = "playbackStart"
    if m.screen <> invalid
        m.screen.busy = true
    end if
    forced = Prairie.Playback.forcedPlayMethodFromStore(m.store)
    body = Prairie.Playback.buildStartBody({
        fileId: m.playLaunch.fileId,
        profileId: m.session.profileId,
        forcedPlayMethod: forced,
        startPosition: m.playLaunch.startPosition
    })
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.startPath(), "POST", body)
    m.httpTask.control = "RUN"
end sub

sub reportPlayerProgress(force as boolean)
    if m.session = invalid or m.playbackSession = invalid or m.screen = invalid
        return
    end if
    if m.route <> "player"
        return
    end if
    sid = m.playbackSession.session_id
    if sid = invalid or (sid as string).len() = 0
        return
    end if
    position = m.screen.positionSeconds
    isPaused = m.screen.isPaused
    req = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.progressPath(sid as string), "POST", Prairie.Playback.buildProgressBody(position, isPaused))
    m.progressTask.request = req
    m.progressTask.control = "RUN"
end sub

sub stopPlaybackSessionAsync()
    if m.session = invalid or m.playbackSession = invalid
        return
    end if
    sid = m.playbackSession.session_id
    if sid = invalid or (sid as string).len() = 0
        return
    end if
    req = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Playback.sessionPath(sid as string), "DELETE")
    m.progressTask.request = req
    m.progressTask.control = "RUN"
end sub

function isSeriesDetail(detail as object) as boolean
    if detail = invalid or detail.type = invalid
        return false
    end if
    lower = LCase(detail.type as string)
    return lower = "series" or lower = "show" or lower = "tv"
end function

sub onConnectSubmit()
    req = m.screen.submitRequest
    if req = invalid
        return
    end if
    stopQuickConnect()
    m.pendingLoginRequest = req
    m.loginServerUrl = serverBaseFromRequestUrl(req.url)
    m.pending = "authSetup"
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.loginServerUrl
    }, Prairie.Auth.setupStatusPath(), "GET")
    m.httpTask.control = "RUN"
end sub

function serverBaseFromRequestUrl(url as string) as string
    marker = "/api/v1/auth/login"
    idx = LCase(url).instr(marker)
    if idx >= 0
        return url.left(idx)
    end if
    return Prairie.Url.normalizeServerUrl(url)
end function

sub loadProfiles()
    if m.auth = invalid
        return
    end if
    m.pending = "profiles"
    m.screen.busy = true
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken
    }, Prairie.Auth.profilesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadHomeSections()
    if m.session = invalid
        return
    end if
    m.pending = "home"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Home.sectionsPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadLibraries()
    if m.session = invalid
        return
    end if
    m.pending = "libraries"
    m.screen.busy = true
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Libraries.librariesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

function buildCatalogQuery(append as boolean) as object
    query = {
        limit: 48
    }
    if append
        query.offset = m.catalogItems.count()
        if m.catalogSnapshot.len() > 0
            query.snapshot = m.catalogSnapshot
        end if
    else
        query.offset = 0
    end if

    if m.route = "library" and m.browseLibrary <> invalid
        query.libraryId = m.browseLibrary.id
    else if m.route = "collection" and m.browseCollection <> invalid
        query.collectionId = m.browseCollection.id
        if m.browseCollection.library_id <> invalid
            query.source = "library_collection"
            query.libraryId = m.browseCollection.library_id
        else
            query.source = "user_collection"
        end if
    end if
    return query
end function

sub loadCatalogPage(append as boolean)
    if m.session = invalid
        return
    end if
    if append
        m.pending = "catalogMore"
    else
        m.pending = "catalog"
    end if
    if m.screen <> invalid and m.screen.hasField("busy")
        m.screen.busy = true
    end if
    path = Prairie.Catalog.buildCatalogPath(buildCatalogQuery(append))
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub startCollectionsLoad()
    if m.session = invalid
        return
    end if
    m.pending = "collectionsLibraries"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Libraries.librariesPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadNextLibraryCollections()
    if m.collectionLibraryQueue.count() = 0
        loadPersonalCollections()
        return
    end if
    library = m.collectionLibraryQueue.shift()
    m.pendingLibraryId = library.id
    m.pending = "libraryCollections"
    path = Prairie.Collections.libraryCollectionsPath(library.id)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "GET")
    m.httpTask.control = "RUN"
end sub

sub loadPersonalCollections()
    m.pending = "personalCollections"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.Collections.personalCollectionsPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub finishCollectionsScreen()
    if m.screen = invalid or m.route <> "collections"
        return
    end if
    m.screen.busy = false
    m.screen.libraryCollections = m.libraryCollectionCards
    m.screen.personalCollections = m.personalCollectionCards
    m.screen.callFunc("focusDefault")
end sub

sub onProfileChosen()
    profile = m.screen.selectedProfile
    if profile = invalid
        return
    end if
    if profile.has_pin = true
        m.pinProfile = profile
        m.screen.pinProfileName = profile.name
        m.screen.pinMode = true
        return
    end if
    finishProfile(profile, invalid)
end sub

sub onPinSubmit()
    payload = m.screen.pinSubmit
    if payload = invalid or m.pinProfile = invalid or m.auth = invalid
        return
    end if
    m.pending = "verifyPin"
    m.screen.busy = true
    m.httpTask.request = Prairie.Api.buildRequest({
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken
    }, Prairie.Auth.verifyPinPath(m.pinProfile.id), "POST", Prairie.Auth.buildVerifyPinBody(payload.pin))
    m.httpTask.control = "RUN"
end sub

sub finishProfile(profile as object, profileToken as dynamic)
    if m.auth = invalid
        return
    end if
    session = {
        serverUrl: m.auth.serverUrl,
        accessToken: m.auth.accessToken,
        username: m.auth.username,
        profileId: profile.id as string
    }
    if profile.name <> invalid
        session.profileName = profile.name as string
    end if
    if profileToken <> invalid
        session.profileToken = profileToken as string
    end if
    m.session = Prairie.Session.saveSession(session, m.store)
    m.registry = Prairie.ServerRegistry.rememberSession(m.registry, m.session, "")
    Prairie.ServerRegistry.save(m.registry, m.store)
    Prairie.Persist.saveLastServerUrl(m.session.serverUrl, m.store)
    m.pinProfile = invalid
    showHome()
end sub

sub onProfilesCancel()
    Prairie.Session.clearSession(m.store)
    if m.registry.entries.count() > 0
        showServerList("connect")
    else
        showConnect()
    end if
end sub

sub onSignOut()
    if m.registry <> invalid and m.registry.activeServerId <> invalid and m.registry.activeServerId.len() > 0
        m.registry = Prairie.ServerRegistry.clearTokens(m.registry, m.registry.activeServerId)
        Prairie.ServerRegistry.save(m.registry, m.store)
    end if
    Prairie.Session.clearSession(m.store)
    m.session = invalid
    m.auth = invalid
    if m.registry.entries.count() > 0
        showServerList("connect")
    else
        showConnect()
    end if
end sub

sub onOpenServers()
    showServerList("connect")
end sub

sub onConnectScanRequested()
    showServerList("connect")
    startDiscovery(true)
end sub

sub onServerScanRequested()
    startDiscovery(true)
end sub

sub onServerAddManual()
    stopDiscovery()
    showConnect()
end sub

sub onServerListBack()
    stopDiscovery()
    if m.serverListBackRoute = "home" and m.session <> invalid
        showHome()
    else
        showConnect()
    end if
end sub

sub onServerSelected()
    entry = m.screen.selectedServer
    if entry = invalid or entry.id = invalid
        return
    end if
    stopDiscovery()
    m.registry = Prairie.ServerRegistry.load(m.store)
    idx = Prairie.ServerRegistry.findIndex(m.registry, entry.id)
    if idx < 0
        return
    end if
    full = m.registry.entries[idx]
    m.registry = Prairie.ServerRegistry.switchTo(m.registry, full.id)
    Prairie.ServerRegistry.save(m.registry, m.store)
    session = Prairie.ServerRegistry.sessionFromEntry(full)
    if session <> invalid
        m.session = Prairie.Session.saveSession(session, m.store)
        Prairie.Persist.saveLastServerUrl(session.serverUrl, m.store)
        showHome()
        return
    end if
    m.connectPrefillUrl = full.url
    showConnect()
end sub

sub onDiscoverySelected()
    hit = m.screen.selectedDiscovery
    if hit = invalid or hit.url = invalid
        return
    end if
    stopDiscovery()
    m.connectPrefillUrl = hit.url as string
    if hit.serverName <> invalid and (hit.serverName as string).trim().len() > 0
        m.registry = Prairie.ServerRegistry.addOrUpdate(m.registry, {
            url: hit.url,
            fetchedName: hit.serverName as string
        })
        Prairie.ServerRegistry.save(m.registry, m.store)
    end if
    showConnect()
end sub

sub onServerRemoveRequested()
    entry = m.screen.removeRequested
    if entry = invalid or entry.id = invalid
        return
    end if
    m.registry = Prairie.ServerRegistry.remove(m.registry, entry.id)
    Prairie.ServerRegistry.save(m.registry, m.store)
    paintServerList()
    m.screen.callFunc("focusDefault")
end sub

sub onHomeItemSelected()
    contentId = m.screen.selectedContentId
    if contentId = invalid or contentId.len() = 0
        return
    end if
    showItemDetail(contentId)
end sub

sub onOpenLibraries()
    showLibraries()
end sub

sub onOpenSearch()
    showSearch()
end sub

sub onOpenLiveTv()
    showLiveTv()
end sub

sub onOpenSettings()
    showSettings()
end sub

sub onOpenCollections()
    showCollections()
end sub

sub onSettingsSave()
    payload = m.screen.saveRequested
    if payload = invalid
        return
    end if
    Prairie.PlaybackSettings.save(payload, m.store)
end sub

sub onSettingsBack()
    back = m.settingsBackRoute
    if back = "livetv"
        showLiveTv()
    else
        showHome()
    end if
end sub

sub loadLiveTvChannels()
    if m.session = invalid
        return
    end if
    m.pending = "liveChannels"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.LiveTv.channelsPath(), "GET")
    m.httpTask.control = "RUN"
end sub

sub loadLiveTvGuide(channels as object)
    if m.session = invalid or channels.count() = 0
        return
    end if
    ids = []
    for each channel in channels
        if channel.id <> invalid
            ids.push(channel.id as string)
        end if
    end for
    if ids.count() = 0
        return
    end if
    m.pending = "liveGuide"
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.LiveTv.guidePath(ids), "GET")
    m.httpTask.control = "RUN"
end sub

sub onLiveChannelChosen()
    channel = m.screen.selectedChannel
    if channel = invalid or m.session = invalid
        return
    end if
    m.liveChannel = channel
    m.pending = "liveSession"
    m.screen.busy = true
    path = Prairie.LiveTv.channelSessionPath(channel.id as string)
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), path, "POST", "{}")
    m.httpTask.control = "RUN"
end sub

sub onLiveRecordRequested()
    if m.screen.recordRequested <> true
        return
    end if
    program = m.screen.recordProgram
    if program = invalid or m.session = invalid
        return
    end if
    programId = ""
    channelId = ""
    if program.id <> invalid
        programId = (program.id as string).trim()
    end if
    if program.channel_id <> invalid
        channelId = (program.channel_id as string).trim()
    end if
    if programId.len() = 0 or not Prairie.LiveTv.programBelongsToChannel(m.livePrograms, programId, channelId)
        m.screen.errorText = "Could not schedule recording"
        return
    end if
    body = Prairie.LiveTv.buildScheduleRecordingBody(program)
    if body = invalid
        m.screen.errorText = "Could not schedule recording"
        return
    end if
    m.pending = "liveRecord"
    m.screen.errorText = ""
    m.httpTask.request = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.LiveTv.recordingsPath(), "POST", body)
    m.httpTask.control = "RUN"
end sub

sub releaseLiveSessionAsync()
    if m.session = invalid or m.liveSessionId.len() = 0
        return
    end if
    req = Prairie.Api.buildRequest(Prairie.Api.sessionOptions(m.session), Prairie.LiveTv.liveSessionPath(m.liveSessionId), "DELETE")
    m.progressTask.request = req
    m.progressTask.control = "RUN"
    m.liveSessionId = ""
end sub

