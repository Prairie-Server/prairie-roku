sub onDetailRateRequested()
    ' ponytail: one shared HttpTask; ignore rating while another request is in flight.
    if m.route <> "detail" or m.session = invalid or m.pending <> ""
        return
    end if
    dialog = CreateObject("roSGNode", "Dialog")
    dialog.title = "Your rating"
    dialog.buttons = Prairie.Catalog.ratingDialogButtons()
    dialog.observeField("buttonSelected", "onRatingDialogButton")
    m.ratingDialog = dialog
    m.top.dialog = dialog
end sub

sub onRatingDialogButton()
    if m.ratingDialog = invalid
        return
    end if
    rating = Prairie.Catalog.ratingFromDialogIndex(m.ratingDialog.buttonSelected)
    m.ratingDialog.close = true
    m.ratingDialog = invalid
    if rating < 0 or m.route <> "detail" or m.session = invalid or m.pending <> ""
        return
    end if
    m.ratingPrevious = m.screen.userRating
    m.screen.userRating = rating
    m.screen.errorText = ""
    m.pending = "setRating"
    m.httpTask.request = Prairie.Catalog.buildRatingRequest(Prairie.Api.sessionOptions(m.session), m.detailContentId, rating)
    m.httpTask.control = "RUN"
end sub

