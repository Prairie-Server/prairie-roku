import "pkg:/source/lib/Theme.bs"
import "pkg:/source/lib/Trickplay.bs"
import "pkg:/source/lib/ArtworkUrl.bs"
import "pkg:/source/lib/LoadingSpinner.bs"
import "pkg:/source/lib/Markers.bs"
import "pkg:/source/lib/BufferingQuality.bs"

sub init()
    colors = Prairie.Theme.colors()
    m.video = m.top.findNode("video")
    m.chromeBg = m.top.findNode("chromeBg")
    m.title = m.top.findNode("title")
    m.status = m.top.findNode("status")
    m.errorLabel = m.top.findNode("errorLabel")
    m.progressTimer = m.top.findNode("progressTimer")
    m.seekPreviewTimer = m.top.findNode("seekPreviewTimer")
    m.statsTimer = m.top.findNode("statsTimer")

    m.seekPreviewGroup = m.top.findNode("seekPreviewGroup")
    m.seekTileClip = m.top.findNode("seekTileClip")
    m.seekTilePoster = m.top.findNode("seekTilePoster")
    m.seekTimeLabel = m.top.findNode("seekTimeLabel")

    m.statsBg = m.top.findNode("statsBg")
    m.statsLabel = m.top.findNode("statsLabel")

    m.qualityBg = m.top.findNode("qualityBg")
    m.qualityTitle = m.top.findNode("qualityTitle")
    m.qualityList = m.top.findNode("qualityList")

    m.chromeBg.color = "0x141820CC"
    m.title.color = colors.ink
    m.status.color = colors.muted
    m.errorLabel.color = colors.danger
    m.seekTimeLabel.color = colors.ink
    m.statsLabel.color = colors.ink
    m.qualityTitle.color = colors.amber
    m.qualityList.color = colors.ink

    m.skipGroup = m.top.findNode("skipGroup")
    m.skipLabel = m.top.findNode("skipLabel")
    m.qualityPill = m.top.findNode("qualityPill")
    m.qualityPillLabel = m.top.findNode("qualityPillLabel")
    m.spinner = m.top.findNode("spinner")
    m.spinnerTimer = m.top.findNode("spinnerTimer")
    m.stallTimer = m.top.findNode("stallTimer")
    m.qualityPillTimer = m.top.findNode("qualityPillTimer")
    m.skipBg = m.top.findNode("skipBg")
    m.skipBg.color = colors.ink
    m.skipLabel.color = colors.bg
    m.qualityPillLabel.color = colors.ink

    ' Our spinner is the only loading indicator: hide the Video node's own bars.
    m.video.retrievingBarVisibilityAuto = false
    m.video.bufferingBarVisibilityAuto = false
    m.spinner.poster.uri = "pkg:/images/spinner.png"
    m.spinner.poster.width = 96
    m.spinner.poster.height = 96

    m.started = false
    m.showStats = false
    m.qualityMenuOpen = false
    m.qualityIndex = 0
    m.previewScale = 1.0
    m.clock = CreateObject("roTimespan")
    m.spinnerState = Prairie.LoadingSpinner.create()
    m.buffering = Prairie.BufferingQuality.create(nowMs())
    m.autoLowered = false
    m.activeSkip = invalid
    m.activeSkipKey = ""

    m.top.observeField("streamUrl", "onStreamUrl")
    m.top.observeField("titleText", "onTitleText")
    m.top.observeField("errorText", "onErrorText")
    m.top.observeField("busy", "onBusy")
    m.top.observeField("qualityOptions", "onQualityOptions")
    m.top.observeField("activeQualityId", "onActiveQualityId")
    m.top.observeField("statsSessionId", "refreshStats")
    m.top.observeField("statsPlayMethod", "refreshStats")
    m.top.observeField("statsStreamUrl", "refreshStats")
    m.top.observeField("statsResolution", "refreshStats")
    m.video.observeField("position", "onPosition")
    m.video.observeField("duration", "onDuration")
    m.video.observeField("state", "onVideoState")
    m.progressTimer.observeField("fire", "onProgressFire")
    m.seekPreviewTimer.observeField("fire", "onSeekPreviewHide")
    m.statsTimer.observeField("fire", "refreshStats")
    m.top.observeField("markerSegments", "refreshSkip")
    m.spinnerTimer.observeField("fire", "refreshSpinner")
    m.stallTimer.observeField("fire", "onStallTick")
    m.qualityPillTimer.observeField("fire", "onQualityPillHide")
end sub

function nowMs() as integer
    return m.clock.TotalMilliseconds()
end function

' ---- Loading spinner -------------------------------------------------------

sub refreshSpinner()
    videoState = ""
    if m.video <> invalid and m.video.state <> invalid
        videoState = m.video.state
    end if
    now = nowMs()
    loading = Prairie.LoadingSpinner.isLoading(m.top.busy, videoState)
    m.spinnerState = Prairie.LoadingSpinner.update(m.spinnerState, loading, now)
    if m.spinnerState.visible <> m.spinner.visible
        m.spinner.visible = m.spinnerState.visible
        if m.spinnerState.visible
            m.spinner.control = "start"
        else
            m.spinner.control = "stop"
        end if
    end if
    m.spinnerTimer.control = "stop"
    if m.spinnerState.nextCheckMs >= 0
        waitMs = m.spinnerState.nextCheckMs - now
        if waitMs < 1
            waitMs = 1
        end if
        m.spinnerTimer.duration = waitMs / 1000.0
        m.spinnerTimer.control = "start"
    end if
end sub

' ---- Skip intro / recap / credits ------------------------------------------

sub refreshSkip()
    segment = Prairie.Markers.activeSegment(m.top.markerSegments, m.top.positionSeconds)
    key = Prairie.Markers.segmentKey(segment)
    if key = m.activeSkipKey
        return
    end if
    m.activeSkipKey = key
    m.activeSkip = segment
    if segment = invalid
        m.skipGroup.visible = false
        return
    end if
    m.skipLabel.text = Prairie.Markers.skipLabel(segment.kind as string) + "  ·  OK"
    m.skipGroup.visible = true
end sub

sub skipActiveSegment()
    if m.activeSkip = invalid
        return
    end if
    target = Prairie.Markers.skipTarget(m.activeSkip, m.video.duration)
    m.activeSkip = invalid
    m.skipGroup.visible = false
    Prairie.BufferingQuality.onSeek(m.buffering, nowMs())
    m.video.seek = target
    m.top.seekDelta = CInt(target - m.top.positionSeconds)
end sub

' ---- Buffering quality (Auto steps down after repeated stalls) -------------

sub onBufferingState(videoState as string)
    now = nowMs()
    if videoState = "playing"
        Prairie.BufferingQuality.onPlaying(m.buffering, now)
        m.stallTimer.control = "stop"
    else if videoState = "buffering"
        if Prairie.BufferingQuality.onBuffering(m.buffering, now)
            m.stallTimer.control = "start"
            evaluateQualityStepDown()
        end if
    else
        m.stallTimer.control = "stop"
    end if
end sub

sub onStallTick()
    if m.video.state <> "buffering"
        m.stallTimer.control = "stop"
        return
    end if
    evaluateQualityStepDown()
end sub

sub evaluateQualityStepDown()
    autoInCharge = LCase(m.top.activeQualityId) = "auto" or m.autoLowered
    now = nowMs()
    if not Prairie.BufferingQuality.shouldLower(m.buffering, now, autoInCharge)
        return
    end if
    nextId = Prairie.BufferingQuality.nextLowerQualityId(m.top.qualityOptions, m.top.activeQualityId, m.top.effectiveHeight)
    if nextId = invalid
        return
    end if
    m.autoLowered = true
    m.stallTimer.control = "stop"
    Prairie.BufferingQuality.onQualityChanged(m.buffering, now)
    m.qualityPillLabel.text = "Buffering · lowered quality to " + qualityLabel(nextId as string) + " · ▼ Restore"
    m.qualityPill.visible = true
    m.qualityPillTimer.control = "stop"
    m.qualityPillTimer.control = "start"
    m.top.autoQualityRequested = nextId as string
end sub

sub restoreAutoQuality()
    m.autoLowered = false
    Prairie.BufferingQuality.onQualityChanged(m.buffering, nowMs())
    hideQualityPill()
    m.top.autoQualityRequested = "auto"
end sub

sub hideQualityPill()
    m.qualityPillTimer.control = "stop"
    m.qualityPill.visible = false
end sub

sub onQualityPillHide()
    m.qualityPill.visible = false
    refreshStatus()
end sub

function qualityLabel(qualityId as string) as string
    options = m.top.qualityOptions
    if options <> invalid
        for each opt in options
            if opt <> invalid and (opt.id as string) = qualityId
                return opt.label as string
            end if
        end for
    end if
    return qualityId
end function

sub onTitleText()
    m.title.text = m.top.titleText
end sub

sub onErrorText()
    m.errorLabel.text = m.top.errorText
    refreshStats()
end sub

sub onBusy()
    if m.top.busy
        m.status.text = "Starting playback…"
    end if
    refreshSpinner()
end sub

sub onStreamUrl()
    url = m.top.streamUrl
    if url.len() = 0
        return
    end if
    content = CreateObject("roSGNode", "ContentNode")
    content.url = url
    content.streamFormat = m.top.streamFormat
    if m.top.titleText.len() > 0
        content.title = m.top.titleText
    end if
    m.video.content = content
    m.video.control = "play"
    m.started = true
    Prairie.BufferingQuality.onSourceStart(m.buffering, nowMs())
    m.progressTimer.control = "start"
    m.top.isPaused = false
    refreshStatus()
    refreshStats()
end sub

sub onQualityOptions()
    syncQualityIndex()
    if m.qualityMenuOpen
        paintQualityMenu()
    end if
end sub

sub onActiveQualityId()
    syncQualityIndex()
    if m.qualityMenuOpen
        paintQualityMenu()
    end if
    refreshStatus()
    refreshStats()
end sub

sub syncQualityIndex()
    options = m.top.qualityOptions
    if options = invalid or options.count() = 0
        m.qualityIndex = 0
        return
    end if
    active = m.top.activeQualityId
    for i = 0 to options.count() - 1
        if options[i] <> invalid and (options[i].id as string) = active
            m.qualityIndex = i
            return
        end if
    end for
    if m.qualityIndex >= options.count()
        m.qualityIndex = 0
    end if
end sub

sub focusDefault()
    m.video.setFocus(true)
end sub

sub stopPlayback()
    m.progressTimer.control = "stop"
    m.statsTimer.control = "stop"
    m.seekPreviewTimer.control = "stop"
    m.spinnerTimer.control = "stop"
    m.stallTimer.control = "stop"
    m.qualityPillTimer.control = "stop"
    m.spinner.control = "stop"
    if m.video <> invalid
        m.video.control = "stop"
    end if
end sub

sub onPosition()
    m.top.positionSeconds = m.video.position
    refreshSkip()
    refreshStatus()
end sub

sub onDuration()
    m.top.durationSeconds = m.video.duration
    refreshStatus()
end sub

sub onVideoState()
    state = m.video.state
    if state = "playing"
        m.top.isPaused = false
        if m.top.startPosition > 0 and m.started
            ' Seek once after start when resume is requested.
            if m.video.position < 1 and m.top.startPosition > 1
                Prairie.BufferingQuality.onSeek(m.buffering, nowMs())
                m.video.seek = m.top.startPosition
            end if
        end if
    else if state = "paused"
        m.top.isPaused = true
    else if state = "finished" or state = "error"
        m.top.exitRequested = true
    end if
    onBufferingState(state)
    refreshSpinner()
    refreshStatus()
    refreshStats()
end sub

sub refreshStatus()
    if m.qualityMenuOpen
        return
    end if
    positionSec = CInt(m.top.positionSeconds)
    durationSec = CInt(m.top.durationSeconds)
    pauseLabel = "Playing"
    if m.top.isPaused
        pauseLabel = "Paused"
    end if
    qualityHint = m.top.activeQualityId
    if qualityHint.len() = 0
        qualityHint = "—"
    end if
    restoreHint = ""
    if m.autoLowered
        restoreHint = " · ▼ restore Auto"
    end if
    m.status.text = pauseLabel + " · " + positionSec.toStr() + "s / " + durationSec.toStr() + "s · ↑ quality · ★ audio · replay stats · ←/→ ±15s · Back exits · " + qualityHint + restoreHint
end sub

sub onProgressFire()
    m.top.progressTick = true
end sub

sub seekBy(delta as integer)
    nextPos = m.video.position + delta
    if nextPos < 0
        nextPos = 0
    end if
    duration = m.video.duration
    if duration > 0 and nextPos > duration
        nextPos = duration
    end if
    Prairie.BufferingQuality.onSeek(m.buffering, nowMs())
    m.video.seek = nextPos
    m.top.seekDelta = delta
    showSeekPreview(nextPos)
end sub

sub showSeekPreview(seconds as float)
    m.seekTimeLabel.text = Prairie.Trickplay.formatSeekTime(seconds)
    tile = Prairie.Trickplay.resolveTile(m.top.trickplay, seconds)
    previewW = 320
    previewH = 180
    if tile = invalid
        m.seekTilePoster.uri = ""
        m.seekTilePoster.visible = false
        m.seekTileClip.clippingRect = [0, 0, previewW, previewH]
        m.seekPreviewGroup.visible = true
        m.seekPreviewTimer.control = "stop"
        m.seekPreviewTimer.control = "start"
        return
    end if

    ' Scale sprite sheet so one tile fills the preview box.
    scaleX = previewW / (tile.tileWidth as float)
    scaleY = previewH / (tile.tileHeight as float)
    scale = scaleX
    if scaleY < scaleX
        scale = scaleY
    end if
    sheetW = CInt((tile.sheetPixelWidth as float) * scale)
    sheetH = CInt((tile.sheetPixelHeight as float) * scale)
    offsetX = CInt((tile.offsetX as float) * scale)
    offsetY = CInt((tile.offsetY as float) * scale)
    clipW = CInt((tile.tileWidth as float) * scale)
    clipH = CInt((tile.tileHeight as float) * scale)

    m.seekTileClip.clippingRect = [0, 0, clipW, clipH]
    m.seekTilePoster.visible = true
    m.seekTilePoster.width = sheetW
    m.seekTilePoster.height = sheetH
    m.seekTilePoster.translation = [-offsetX, -offsetY]
    m.seekTilePoster.loadDisplayMode = "scaleToFill"
    if m.seekTilePoster.uri <> (tile.url as string)
        m.seekTilePoster.uri = tile.url as string
    end if
    m.seekPreviewGroup.visible = true
    m.seekPreviewTimer.control = "stop"
    m.seekPreviewTimer.control = "start"
end sub

sub onSeekPreviewHide()
    m.seekPreviewGroup.visible = false
end sub

sub toggleStats()
    m.showStats = not m.showStats
    m.statsBg.visible = m.showStats
    m.statsLabel.visible = m.showStats
    if m.showStats
        m.statsTimer.control = "start"
        refreshStats()
    else
        m.statsTimer.control = "stop"
    end if
end sub

sub refreshStats()
    if not m.showStats
        return
    end if
    positionSec = Prairie.Trickplay.formatSeekTime(m.top.positionSeconds)
    durationSec = Prairie.Trickplay.formatSeekTime(m.top.durationSeconds)
    buffering = "no"
    state = ""
    if m.video <> invalid
        state = m.video.state
        if state = "buffering"
            buffering = "yes"
        end if
    end if
    stream = m.top.statsStreamUrl
    if stream.len() = 0
        stream = m.top.streamUrl
    end if
    if stream.len() > 72
        stream = stream.left(69) + "…"
    end if
    err = m.top.errorText
    if err.len() = 0
        err = "—"
    end if
    lines = []
    lines.push("session: " + blankDash(m.top.statsSessionId))
    lines.push("playMethod: " + blankDash(m.top.statsPlayMethod))
    lines.push("state: " + blankDash(state))
    lines.push("buffering: " + buffering)
    lines.push("position: " + positionSec + " / " + durationSec)
    lines.push("quality: " + blankDash(m.top.activeQualityId))
    lines.push("resolution: " + blankDash(m.top.statsResolution))
    lines.push("stream: " + blankDash(stream))
    lines.push("error: " + err)
    m.statsLabel.text = lines.join(Chr(10))
end sub

function blankDash(value as string) as string
    if value.len() = 0
        return "—"
    end if
    return value
end function

sub openQualityMenu()
    options = m.top.qualityOptions
    if options = invalid or options.count() = 0
        m.status.text = "Quality ladder unavailable"
        return
    end if
    m.qualityMenuOpen = true
    syncQualityIndex()
    paintQualityMenu()
    m.qualityBg.visible = true
    m.qualityTitle.visible = true
    m.qualityList.visible = true
end sub

sub closeQualityMenu()
    m.qualityMenuOpen = false
    m.qualityBg.visible = false
    m.qualityTitle.visible = false
    m.qualityList.visible = false
    refreshStatus()
end sub

sub paintQualityMenu()
    options = m.top.qualityOptions
    if options = invalid
        return
    end if
    lines = []
    for i = 0 to options.count() - 1
        opt = options[i]
        if opt <> invalid
            marker = "  "
            if i = m.qualityIndex
                marker = "> "
            end if
            active = ""
            if (opt.id as string) = m.top.activeQualityId
                active = " ●"
            end if
            line = marker + (opt.label as string) + active
            if opt.sublabel <> invalid and (opt.sublabel as string).len() > 0
                line = line + "  " + (opt.sublabel as string)
            end if
            lines.push(line)
        end if
    end for
    m.qualityList.text = lines.join(Chr(10))
    m.status.text = "Quality · ↑/↓ move · OK select · Back closes"
end sub

sub selectQualityAtIndex()
    options = m.top.qualityOptions
    if options = invalid or m.qualityIndex < 0 or m.qualityIndex >= options.count()
        return
    end if
    opt = options[m.qualityIndex]
    if opt = invalid or opt.id = invalid
        return
    end if
    ' A manual pick takes over from the buffering step-down.
    m.autoLowered = false
    hideQualityPill()
    Prairie.BufferingQuality.onQualityChanged(m.buffering, nowMs())
    m.top.qualityChangeRequested = opt.id as string
    closeQualityMenu()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press
        return false
    end if

    if m.qualityMenuOpen
        if key = "back"
            closeQualityMenu()
            return true
        end if
        if key = "up"
            if m.qualityIndex > 0
                m.qualityIndex = m.qualityIndex - 1
                paintQualityMenu()
            end if
            return true
        end if
        if key = "down"
            options = m.top.qualityOptions
            if options <> invalid and m.qualityIndex < options.count() - 1
                m.qualityIndex = m.qualityIndex + 1
                paintQualityMenu()
            end if
            return true
        end if
        if key = "OK" or key = "play"
            selectQualityAtIndex()
            return true
        end if
        return true
    end if

    if key = "back"
        m.top.exitRequested = true
        return true
    end if
    if key = "up"
        openQualityMenu()
        return true
    end if
    if key = "replay" or key = "info"
        toggleStats()
        return true
    end if
    if key = "OK" and m.activeSkip <> invalid
        skipActiveSegment()
        return true
    end if
    if key = "down" and m.autoLowered
        restoreAutoQuality()
        refreshStatus()
        return true
    end if
    if key = "OK" or key = "play"
        if m.top.isPaused
            m.video.control = "resume"
            m.top.isPaused = false
        else
            m.video.control = "pause"
            m.top.isPaused = true
        end if
        refreshStatus()
        m.top.progressTick = true
        return true
    end if
    if key = "left" or key = "rewind"
        seekBy(-15)
        return true
    end if
    if key = "right" or key = "fastforward"
        seekBy(15)
        return true
    end if
    if key = "options"
        m.top.audioCycleRequested = true
        return true
    end if
    return false
end function
