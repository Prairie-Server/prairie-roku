<?xml version="1.0" encoding="utf-8" ?>
<component name="ConnectScreen" extends="Group">
    <interface>
        <field id="initialServerUrl" type="string" value="" />
        <field id="busy" type="bool" value="false" />
        <field id="errorText" type="string" value="" />
        <field id="submitRequest" type="assocarray" />
        <field id="quickConnectStartRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="quickConnectUserCode" type="string" value="" />
        <field id="quickConnectMatchCode" type="string" value="" />
        <field id="quickConnectVerificationUri" type="string" value="" />
        <field id="quickConnectStatus" type="string" value="" />
        <field id="openServers" type="boolean" value="false" alwaysNotify="true" />
        <field id="scanRequested" type="boolean" value="false" alwaysNotify="true" />
        <function name="focusDefault" />
    </interface>
    <script type="text/brightscript" uri="ConnectScreen.bs" />
    <children>
        <Rectangle
            id="backdrop"
            width="1920"
            height="1080"
            color="0x141820FF"
        />
        <Label
            id="eyebrow"
            text="ROKU"
            translation="[120, 160]"
            width="800"
            font="font:SmallBoldSystemFont"
            color="0xE0A84AFF"
        />
        <Label
            id="brand"
            text="Prairie"
            translation="[120, 200]"
            width="1200"
            height="140"
            font="font:LargeBoldSystemFont"
            color="0xF3EFE6FF"
        />
        <Label
            id="lede"
            text="Connect with a password, or scan Quick Connect from another signed-in device."
            translation="[120, 360]"
            width="700"
            height="80"
            wrap="true"
            font="font:MediumSystemFont"
            color="0x9AA3B2FF"
        />

        <Label text="Server URL" translation="[120, 470]" color="0x9AA3B2FF" font="font:SmallSystemFont" />
        <TextEditBox
            id="serverUrl"
            translation="[120, 510]"
            width="700"
            hintText="https://prairie.example.com"
            maxTextLength="200"
            showKeyboardOnFocus="true"
        />

        <Label text="Username" translation="[120, 600]" color="0x9AA3B2FF" font="font:SmallSystemFont" />
        <TextEditBox
            id="username"
            translation="[120, 640]"
            width="700"
            hintText="Username"
            maxTextLength="120"
            showKeyboardOnFocus="true"
        />

        <Label text="Password" translation="[120, 730]" color="0x9AA3B2FF" font="font:SmallSystemFont" />
        <TextEditBox
            id="password"
            translation="[120, 770]"
            width="700"
            hintText="Password"
            maxTextLength="120"
            secureMode="true"
            showKeyboardOnFocus="true"
        />

        <Label
            id="errorLabel"
            text=""
            translation="[120, 860]"
            width="700"
            height="60"
            wrap="true"
            font="font:SmallSystemFont"
            color="0xE07070FF"
        />

        <Rectangle
            id="quickConnectPanel"
            translation="[920, 340]"
            width="860"
            height="560"
            color="0x1C2430FF"
        >
            <Label
                id="quickConnectEyebrow"
                text="QUICK CONNECT"
                translation="[40, 28]"
                width="780"
                font="font:SmallBoldSystemFont"
                color="0xE0A84AFF"
            />
            <Label
                id="quickConnectTitle"
                text="Use your phone instead"
                translation="[40, 68]"
                width="780"
                height="50"
                wrap="true"
                font="font:MediumBoldSystemFont"
                color="0xF3EFE6FF"
            />
            <Label
                id="quickConnectHint"
                text="Scan the QR code to approve this Roku, or enter the text code in Settings → Quick Connect."
                translation="[40, 124]"
                width="780"
                height="70"
                wrap="true"
                font="font:SmallSystemFont"
                color="0x9AA3B2FF"
            />
            <Rectangle
                id="quickConnectQrFrame"
                translation="[40, 210]"
                width="236"
                height="236"
                color="0xFFFFFFFF"
            >
                <PrairieQrCode
                    id="quickConnectQr"
                    translation="[8, 8]"
                    width="220"
                    height="220"
                    loadDisplayMode="scaleToFit"
                    pixel="5"
                    border="3"
                    ecl="MEDIUM"
                    lightColor="0xFFFFFFFF"
                    darkColor="0x141820FF"
                />
            </Rectangle>
            <Label
                id="quickConnectMatchLabel"
                text="MATCH"
                translation="[310, 220]"
                width="500"
                font="font:SmallBoldSystemFont"
                color="0x9AA3B2FF"
            />
            <Label
                id="quickConnectMatch"
                text=""
                translation="[310, 256]"
                width="500"
                height="50"
                font="font:MediumBoldSystemFont"
                color="0xF3EFE6FF"
            />
            <Label
                id="quickConnectCodeLabel"
                text="CODE"
                translation="[310, 330]"
                width="500"
                font="font:SmallBoldSystemFont"
                color="0x9AA3B2FF"
            />
            <Label
                id="quickConnectCode"
                text=""
                translation="[310, 366]"
                width="500"
                height="70"
                font="font:LargeBoldSystemFont"
                color="0xE0A84AFF"
            />
            <Label
                id="quickConnectStatusLabel"
                text=""
                translation="[40, 470]"
                width="780"
                height="50"
                wrap="true"
                font="font:SmallSystemFont"
                color="0x9AA3B2FF"
            />
        </Rectangle>

        <Rectangle
            id="connectFocus"
            translation="[114, 934]"
            width="292"
            height="76"
            color="0xF0C574FF"
            visible="false"
            opacity="0.9"
        />
        <Rectangle
            id="connectBg"
            translation="[120, 940]"
            width="280"
            height="64"
            color="0xE0A84AFF"
            focusable="true"
        >
            <Label
                id="connectLabel"
                text="Connect"
                width="280"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumBoldSystemFont"
                color="0x141820FF"
            />
        </Rectangle>
        <Rectangle
            id="serversBg"
            translation="[420, 940]"
            width="280"
            height="64"
            color="0x222B38FF"
            focusable="true"
        >
            <Label
                id="serversLabel"
                text="Servers"
                width="280"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
        <Rectangle
            id="scanBg"
            translation="[720, 940]"
            width="280"
            height="64"
            color="0x222B38FF"
            focusable="true"
        >
            <Label
                id="scanLabel"
                text="Scan LAN"
                width="280"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
        <Rectangle
            id="quickConnectBg"
            translation="[1020, 940]"
            width="320"
            height="64"
            color="0x222B38FF"
            focusable="true"
        >
            <Label
                id="quickConnectLabel"
                text="Refresh code"
                width="320"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
    </children>
</component>
