<?xml version="1.0" encoding="utf-8" ?>
<component name="ConnectScreen" extends="Group">
    <interface>
        <field id="initialServerUrl" type="string" value="" />
        <field id="busy" type="bool" value="false" />
        <field id="errorText" type="string" value="" />
        <field id="submitRequest" type="assocarray" />
        <field id="quickConnectStartRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="quickConnectState" type="string" value="" alwaysNotify="true" />
        <field id="quickConnectActivate" type="string" value="" />
        <field id="quickConnectUserCode" type="string" value="" />
        <field id="quickConnectMatchCode" type="string" value="" />
        <field id="quickConnectVerificationUri" type="string" value="" />
        <field id="quickConnectStatus" type="string" value="" alwaysNotify="true" />
        <field id="openServers" type="boolean" value="false" alwaysNotify="true" />
        <field id="scanRequested" type="boolean" value="false" alwaysNotify="true" />
        <function name="focusDefault" />
        <function name="serverCandidates" />
    </interface>
    <script type="text/brightscript" uri="ConnectScreen.bs" />
    <children>
        <Rectangle
            id="backdrop"
            width="1920"
            height="1080"
            color="0x141820FF"
        />
        <Label
            id="eyebrow"
            text="ROKU"
            translation="[120, 110]"
            width="800"
            font="font:SmallBoldSystemFont"
            color="0xE0A84AFF"
        />
        <Label
            id="brand"
            text="Prairie"
            translation="[120, 145]"
            width="1200"
            height="110"
            font="font:LargeBoldSystemFont"
            color="0xF3EFE6FF"
        />
        <Label
            id="lede"
            text="Sign in with a password, or approve this Roku from your phone."
            translation="[120, 265]"
            width="700"
            height="80"
            wrap="true"
            font="font:MediumSystemFont"
            color="0x9AA3B2FF"
        />

        <Label id="serverUrlLabel" text="Server address" translation="[120, 360]" color="0x9AA3B2FF" font="font:SmallSystemFont" />
        <TextEditBox
            id="serverUrl"
            translation="[120, 400]"
            width="700"
            hintText="prairie.example.com or 192.168.1.10"
            maxTextLength="200"
            showKeyboardOnFocus="true"
        />

        <Rectangle
            id="advancedBg"
            translation="[120, 478]"
            width="300"
            height="56"
            color="0x222B38FF"
            focusable="true"
        >
            <Label
                id="advancedLabel"
                text="Advanced options"
                width="300"
                height="56"
                horizAlign="center"
                vertAlign="center"
                font="font:SmallSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
        <Rectangle
            id="protocolBg"
            translation="[440, 478]"
            width="200"
            height="56"
            color="0x222B38FF"
            focusable="true"
            visible="false"
        >
            <Label
                id="protocolLabel"
                text="Protocol: Auto"
                width="200"
                height="56"
                horizAlign="center"
                vertAlign="center"
                font="font:SmallSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
        <TextEditBox
            id="port"
            translation="[660, 476]"
            width="160"
            hintText="Port: auto"
            maxTextLength="5"
            showKeyboardOnFocus="true"
            visible="false"
        />

        <Label id="usernameLabel" text="Username" translation="[120, 560]" color="0x9AA3B2FF" font="font:SmallSystemFont" />
        <TextEditBox
            id="username"
            translation="[120, 600]"
            width="700"
            hintText="Username"
            maxTextLength="120"
            showKeyboardOnFocus="true"
        />

        <Label id="passwordLabel" text="Password" translation="[120, 680]" color="0x9AA3B2FF" font="font:SmallSystemFont" />
        <TextEditBox
            id="password"
            translation="[120, 720]"
            width="700"
            hintText="Password"
            maxTextLength="120"
            secureMode="true"
            showKeyboardOnFocus="true"
        />

        <Label
            id="errorLabel"
            text=""
            translation="[120, 800]"
            width="700"
            height="120"
            wrap="true"
            font="font:SmallSystemFont"
            color="0xE07070FF"
        />

        <Rectangle
            id="quickConnectPanel"
            translation="[920, 300]"
            width="860"
            height="600"
            color="0x1C2430FF"
        >
            <Label
                id="quickConnectEyebrow"
                text="QUICK CONNECT"
                translation="[40, 28]"
                width="780"
                font="font:SmallBoldSystemFont"
                color="0xE0A84AFF"
            />
            <Label
                id="quickConnectTitle"
                text="Use your phone instead"
                translation="[40, 68]"
                width="780"
                height="50"
                wrap="true"
                font="font:MediumBoldSystemFont"
                color="0xF3EFE6FF"
            />
            <Label
                id="quickConnectHint"
                text=""
                translation="[40, 124]"
                width="780"
                height="100"
                wrap="true"
                font="font:SmallSystemFont"
                color="0x9AA3B2FF"
            />
            <Rectangle
                id="quickConnectQrFrame"
                translation="[40, 240]"
                width="236"
                height="236"
                color="0xFFFFFFFF"
            >
                <PrairieQrCode
                    id="quickConnectQr"
                    translation="[8, 8]"
                    width="220"
                    height="220"
                    loadDisplayMode="scaleToFit"
                    pixel="5"
                    border="3"
                    ecl="MEDIUM"
                    lightColor="0xFFFFFFFF"
                    darkColor="0x141820FF"
                />
            </Rectangle>
            <Label
                id="quickConnectCodeLabel"
                text="SIGN-IN CODE"
                translation="[310, 250]"
                width="510"
                font="font:SmallBoldSystemFont"
                color="0x9AA3B2FF"
            />
            <Group id="quickConnectCodeRow" translation="[310, 286]" />
            <Label
                id="quickConnectMatchLabel"
                text="MATCH"
                translation="[310, 380]"
                width="510"
                font="font:SmallBoldSystemFont"
                color="0x9AA3B2FF"
            />
            <Label
                id="quickConnectMatch"
                text=""
                translation="[310, 416]"
                width="510"
                height="50"
                font="font:MediumBoldSystemFont"
                color="0xF3EFE6FF"
            />
            <Label
                id="quickConnectStatusLabel"
                text=""
                translation="[40, 500]"
                width="780"
                height="80"
                wrap="true"
                font="font:SmallBoldSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>

        <Rectangle
            id="connectFocus"
            translation="[114, 934]"
            width="292"
            height="76"
            color="0xF0C574FF"
            visible="false"
            opacity="0.9"
        />
        <Rectangle
            id="connectBg"
            translation="[120, 940]"
            width="280"
            height="64"
            color="0xE0A84AFF"
            focusable="true"
        >
            <Label
                id="connectLabel"
                text="▶ Sign in"
                width="280"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumBoldSystemFont"
                color="0x141820FF"
            />
        </Rectangle>
        <Rectangle
            id="serversBg"
            translation="[420, 940]"
            width="280"
            height="64"
            color="0x222B38FF"
            focusable="true"
        >
            <Label
                id="serversLabel"
                text="Change server"
                width="280"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
        <Rectangle
            id="scanBg"
            translation="[720, 940]"
            width="280"
            height="64"
            color="0x222B38FF"
            focusable="true"
        >
            <Label
                id="scanLabel"
                text="📡 Scan LAN"
                width="280"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
        <Rectangle
            id="quickConnectBg"
            translation="[1020, 940]"
            width="320"
            height="64"
            color="0x222B38FF"
            focusable="true"
        >
            <Label
                id="quickConnectLabel"
                text="Show a new code"
                width="320"
                height="64"
                horizAlign="center"
                vertAlign="center"
                font="font:MediumSystemFont"
                color="0xF3EFE6FF"
            />
        </Rectangle>
    </children>
</component>
