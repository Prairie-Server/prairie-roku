import "pkg:/source/lib/Theme.bs"
import "pkg:/source/lib/ArtworkUrl.bs"
import "pkg:/source/lib/Home.bs"
import "pkg:/source/lib/WatchedState.bs"

sub init()
    colors = Prairie.Theme.colors()
    m.top.findNode("backdrop").color = colors.bg
    m.brand = m.top.findNode("brand")
    m.topNav = m.top.findNode("topNav")
    m.profileLabel = m.top.findNode("profileLabel")
    m.errorLabel = m.top.findNode("errorLabel")
    m.rails = m.top.findNode("rails")
    m.hint = m.top.findNode("hint")

    m.brand.text = Prairie.Theme.brandName()
    m.brand.color = colors.amber
    m.profileLabel.color = colors.muted
    m.errorLabel.color = colors.danger
    m.hint.color = colors.muted
    m.topNav.selectedId = "home"

    m.top.observeField("sections", "onSections")
    m.top.observeField("navEntries", "onNavEntries")
    m.top.observeField("profileName", "onProfileName")
    m.top.observeField("errorText", "onErrorText")
    m.rails.observeField("rowItemSelected", "onItemSelected")
    m.topNav.observeField("activatedId", "onNavActivated")
    onNavEntries()
end sub

sub onProfileName()
    name = m.top.profileName
    if name.len() > 0
        m.profileLabel.text = "Watching as " + name
    else
        m.profileLabel.text = ""
    end if
    onNavEntries()
end sub

' The screen's entries plus the trailing profile entry (the profile menu).
sub onNavEntries()
    entries = []
    if m.top.navEntries <> invalid
        for each entry in m.top.navEntries
            entries.push(entry)
        end for
    end if
    profileLabel = "Profile"
    if m.top.profileName.len() > 0
        profileLabel = m.top.profileName
    end if
    entries.push({ id: "profile", label: profileLabel })
    m.topNav.entries = entries
end sub

sub onNavActivated()
    entryId = m.topNav.activatedId
    if entryId = "home"
        m.rails.setFocus(true)
        return
    end if
    m.top.navRequested = entryId
end sub

sub onErrorText()
    m.errorLabel.text = m.top.errorText
end sub

sub onSections()
    sections = m.top.sections
    content = CreateObject("roSGNode", "ContentNode")
    if sections <> invalid
        for each section in sections
            row = content.createChild("ContentNode")
            title = "Section"
            if section.title <> invalid and (section.title as string).len() > 0
                title = section.title as string
            end if
            row.title = title
            items = []
            if section.items <> invalid
                items = section.items
            end if
            for each entry in items
                node = row.createChild("ContentNode")
                itemTitle = "Title"
                if entry.title <> invalid
                    itemTitle = entry.title as string
                end if
                node.title = itemTitle
                if entry.poster_url <> invalid
                    node.hdPosterUrl = Prairie.Artwork.preferred(entry.poster_url as string, 200)
                end if
                contentId = ""
                if entry.content_id <> invalid
                    contentId = entry.content_id as string
                end if
                node.id = contentId
                node.addFields({ contentId: contentId, isExploreAll: false, watched: Prairie.WatchedState.isWatched(entry) })
            end for
            if Prairie.Home.offersExploreAll(section)
                explore = row.createChild("ContentNode")
                explore.title = "Explore all"
                explore.addFields({ contentId: "", isExploreAll: true, sectionId: section.id as string, sectionTitle: title })
            end if
        end for
    end if
    m.rails.content = content
    restore = m.top.restoreRowItem
    if restore <> invalid and restore.count() = 2 and restore[0] < content.getChildCount()
        row = content.getChild(restore[0])
        if row <> invalid and restore[1] < row.getChildCount()
            m.rails.jumpToRowItem = restore
        end if
    end if
end sub

sub focusDefault()
    if m.rails.content = invalid or m.rails.content.getChildCount() = 0
        m.topNav.callFunc("focusSelected")
        return
    end if
    m.rails.setFocus(true)
end sub

sub onItemSelected()
    selection = m.rails.rowItemSelected
    if selection = invalid or selection.count() < 2
        return
    end if
    row = m.rails.content.getChild(selection[0])
    if row = invalid
        return
    end if
    item = row.getChild(selection[1])
    if item = invalid
        return
    end if
    if item.isExploreAll = true
        m.top.lastRowItem = [selection[0], selection[1]]
        m.top.exploreSection = { id: item.sectionId, title: item.sectionTitle }
        return
    end if
    if item.contentId = invalid or (item.contentId as string).len() = 0
        return
    end if
    m.top.lastRowItem = [selection[0], selection[1]]
    m.top.selectedContentId = item.contentId
end sub

' The focused poster card's Options (*) request: { contentId, title, watched,
' node }, or false when no real card has focus.
function requestCardOptions(list as object) as boolean
    if not list.isInFocusChain() or list.content = invalid
        return false
    end if
    focus = list.rowItemFocused
    if focus = invalid or focus.count() < 2
        return false
    end if
    row = list.content.getChild(focus[0])
    if row = invalid
        return false
    end if
    item = row.getChild(focus[1])
    if item = invalid or item.contentId = invalid or (item.contentId as string).len() = 0
        return false
    end if
    m.top.cardOptionsRequested = {
        contentId: item.contentId,
        title: item.title,
        watched: item.watched = true,
        node: item
    }
    return true
end function

function onKeyEvent(key as string, press as boolean) as boolean
    if not press
        return false
    end if
    if key = "up" and m.rails.isInFocusChain()
        m.topNav.callFunc("focusSelected")
        return true
    else if key = "down" and m.topNav.isInFocusChain()
        if m.rails.content <> invalid and m.rails.content.getChildCount() > 0
            m.rails.setFocus(true)
        end if
        return true
    else if key = "options"
        ' On a card: its actions (watched, Libraries); elsewhere: Libraries.
        if not requestCardOptions(m.rails)
            m.top.openLibraries = true
        end if
        return true
    else if key = "replay"
        m.top.openSearch = true
        return true
    else if key = "info"
        m.top.openLiveTv = true
        return true
    else if key = "back"
        if m.topNav.isInFocusChain() and m.rails.content <> invalid and m.rails.content.getChildCount() > 0
            m.rails.setFocus(true)
            return true
        end if
        m.top.signOutRequested = true
        return true
    end if
    return false
end function
