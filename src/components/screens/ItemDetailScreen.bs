import "pkg:/source/lib/Theme.bs"
import "pkg:/source/lib/ArtworkUrl.bs"
import "pkg:/source/lib/ApiClient.bs"
import "pkg:/source/lib/Catalog.bs"
import "pkg:/source/lib/WatchedState.bs"
import "pkg:/source/lib/BoxSets.bs"

sub init()
    colors = Prairie.Theme.colors()
    m.top.findNode("backdrop").color = colors.bg
    m.heroArt = m.top.findNode("heroArt")
    m.heroCanonical = ""
    m.heroArt.observeField("loadStatus", "onHeroLoadStatus")
    m.eyebrow = m.top.findNode("eyebrow")
    m.title = m.top.findNode("title")
    m.meta = m.top.findNode("meta")
    m.overview = m.top.findNode("overview")
    m.errorLabel = m.top.findNode("errorLabel")
    m.playBg = m.top.findNode("playBg")
    m.playLabel = m.top.findNode("playLabel")
    m.rateBg = m.top.findNode("rateBg")
    m.rateLabel = m.top.findNode("rateLabel")
    m.watchedBg = m.top.findNode("watchedBg")
    m.watchedLabel = m.top.findNode("watchedLabel")
    m.seasonsTitle = m.top.findNode("seasonsTitle")
    m.seasonList = m.top.findNode("seasonList")
    m.episodeList = m.top.findNode("episodeList")
    m.similarTitle = m.top.findNode("similarTitle")
    m.similarList = m.top.findNode("similarList")
    m.page = m.top.findNode("page")
    m.boxSetBg = m.top.findNode("boxSetBg")
    m.boxSetLabel = m.top.findNode("boxSetLabel")
    m.trailersTitle = m.top.findNode("trailersTitle")
    m.trailerList = m.top.findNode("trailerList")
    m.trailerScroll = 0

    m.eyebrow.color = colors.amber
    m.title.color = colors.ink
    m.meta.color = colors.muted
    m.overview.color = colors.ink
    m.errorLabel.color = colors.danger
    m.playBg.color = colors.amber
    m.playLabel.color = colors.bg
    m.seasonsTitle.color = colors.amber
    m.similarTitle.color = colors.amber
    m.trailersTitle.color = colors.amber
    m.rateLabel.color = colors.ink
    m.colors = colors
    m.rateBg.color = colors.bgElevated
    m.rateBg.observeField("focusedChild", "onRateFocus")
    m.watchedBg.observeField("focusedChild", "onWatchedFocus")
    m.boxSetBg.observeField("focusedChild", "onBoxSetFocus")
    onWatchedFocus()
    onBoxSetFocus()
    m.top.observeField("watched", "onWatched")

    m.top.observeField("detail", "onDetail")
    m.top.observeField("seasons", "onSeasons")
    m.top.observeField("episodes", "onEpisodes")
    m.top.observeField("similar", "onSimilar")
    m.top.observeField("errorText", "onErrorText")
    m.top.observeField("busy", "onBusy")
    m.top.observeField("userRating", "onUserRating")
    m.seasonList.observeField("rowItemSelected", "onSeasonSelected")
    m.episodeList.observeField("rowItemSelected", "onEpisodeSelected")
    m.similarList.observeField("rowItemSelected", "onSimilarSelected")
    m.trailerList.observeField("rowItemSelected", "onTrailerSelected")
    m.top.observeField("trailers", "onTrailers")
    m.top.observeField("boxSet", "onBoxSet")
end sub

sub onErrorText()
    m.errorLabel.text = m.top.errorText
end sub

sub onBusy()
    if m.top.busy
        m.playLabel.text = "▶ Starting…"
    else
        m.playLabel.text = "▶ Play"
    end if
end sub

sub onRateFocus()
    if m.rateBg.hasFocus()
        m.rateBg.color = m.colors.ring
        m.rateLabel.color = m.colors.bg
    else
        m.rateBg.color = m.colors.bgElevated
        m.rateLabel.color = m.colors.ink
    end if
end sub

sub onWatchedFocus()
    if m.watchedBg.hasFocus()
        m.watchedBg.color = m.colors.ring
        m.watchedLabel.color = m.colors.bg
    else
        m.watchedBg.color = m.colors.bgElevated
        m.watchedLabel.color = m.colors.ink
    end if
end sub

sub onBoxSetFocus()
    if m.boxSetBg.hasFocus()
        m.boxSetBg.color = m.colors.ring
        m.boxSetLabel.color = m.colors.bg
    else
        m.boxSetBg.color = m.colors.bgElevated
        m.boxSetLabel.color = m.colors.ink
    end if
end sub

' A movie in a box set offers its page from the action row.
sub onBoxSet()
    boxSet = m.top.boxSet
    shown = boxSet <> invalid and boxSet.title <> invalid and not m.seasonList.visible
    m.boxSetBg.visible = shown
    if shown
        m.boxSetLabel.text = "▤ " + (boxSet.title as string)
    end if
end sub

' Trailers & Extras: local extras, then YouTube videos, each with a still.
sub onTrailers()
    entries = m.top.trailers
    content = CreateObject("roSGNode", "ContentNode")
    row = content.createChild("ContentNode")
    if entries <> invalid
        index = 0
        for each entry in entries
            node = row.createChild("ContentNode")
            title = entry.title
            if entry.caption <> invalid and (entry.caption as string).len() > 0
                title = title + " · " + entry.caption
            end if
            node.title = title
            node.hdPosterUrl = entry.thumbnailUrl
            node.addFields({ entryIndex: index, isExploreAll: false })
            index = index + 1
        end for
    end if
    m.trailerList.content = content
    shown = row.getChildCount() > 0
    m.trailersTitle.visible = shown
    m.trailerList.visible = shown
    layoutTrailers()
end sub

' The rail sits under the last rail shown; focusing it scrolls the page up
' so it stays on screen.
sub layoutTrailers()
    top = 730
    if m.seasonList.visible
        top = 1060
    else if m.similarList.visible
        top = 1090
    end if
    m.trailersTitle.translation = [80, top]
    m.trailerList.translation = [80, top + 50]
    m.trailerScroll = top + 50 + 260 - 1040
    if m.trailerScroll < 0
        m.trailerScroll = 0
    end if
end sub

sub focusTrailers()
    m.page.translation = [0, -m.trailerScroll]
    m.trailerList.setFocus(true)
end sub

sub leaveTrailers(target as object)
    m.page.translation = [0, 0]
    target.setFocus(true)
end sub

sub onTrailerSelected()
    selection = m.trailerList.rowItemSelected
    entries = m.top.trailers
    if selection = invalid or selection.count() < 2 or entries = invalid
        return
    end if
    if selection[1] >= 0 and selection[1] < entries.count()
        m.top.trailerSelected = entries[selection[1]]
    end if
end sub

' The action button focus returns to from a rail below.
function actionAnchor() as object
    if m.playBg.visible
        return m.playBg
    end if
    return m.rateBg
end function

function actionHasFocus() as boolean
    return m.playBg.hasFocus() or m.rateBg.hasFocus() or m.watchedBg.hasFocus() or m.boxSetBg.hasFocus()
end function

sub onWatched()
    m.watchedLabel.text = "✓ " + Prairie.WatchedState.actionLabel(m.top.watched)
end sub

sub onUserRating()
    m.rateLabel.text = Prairie.Catalog.formatUserRating(m.top.userRating)
end sub

function isSeriesType(itemType as string) as boolean
    lower = LCase(itemType)
    return lower = "series" or lower = "show" or lower = "tv"
end function

' WebP → PNG fallback when preferred WebP fails to decode on the Poster.
sub onHeroLoadStatus()
    status = LCase(m.heroArt.loadStatus)
    if status <> "failed" and status <> "error"
        return
    end if
    current = m.heroArt.uri
    if current = invalid or (current as string).len() = 0
        return
    end if
    png = Prairie.Artwork.pngSibling(current as string)
    if png.len() = 0 and m.heroCanonical.len() > 0
        png = Prairie.Artwork.pngSibling(m.heroCanonical)
    end if
    if png.len() > 0 and png <> current
        m.heroArt.uri = png
    end if
end sub

sub onDetail()
    detail = m.top.detail
    if detail = invalid
        return
    end if
    itemType = ""
    if detail.type <> invalid
        itemType = detail.type as string
    end if
    m.eyebrow.text = UCase(itemType)
    title = "Title"
    if detail.title <> invalid
        title = detail.title as string
    end if
    m.title.text = title
    metaParts = []
    if detail.year <> invalid
        metaParts.push((detail.year as integer).toStr())
    end if
    if itemType.len() > 0
        metaParts.push(itemType)
    end if
    communityRating = Prairie.Catalog.formatCommunityRating(detail.community_rating)
    if communityRating.len() > 0
        metaParts.push(communityRating)
    end if
    m.meta.text = metaParts.join(" · ")
    overview = ""
    if detail.overview <> invalid
        overview = detail.overview as string
    end if
    m.overview.text = overview
    art = ""
    if detail.backdrop_url <> invalid and (detail.backdrop_url as string).len() > 0
        art = detail.backdrop_url as string
    else if detail.poster_url <> invalid
        art = detail.poster_url as string
    end if
    m.top.userRating = Prairie.Catalog.normalizeUserRating(detail.user_rating)
    m.top.watched = Prairie.WatchedState.isWatched(detail)
    onWatched()
    m.heroCanonical = art
    m.heroArt.uri = Prairie.Artwork.preferred(art)

    series = isSeriesType(itemType)
    m.playBg.visible = not series
    m.seasonsTitle.visible = series
    m.seasonList.visible = series
    m.episodeList.visible = series
    if series
        m.similarTitle.visible = false
        m.similarList.visible = false
        m.boxSetBg.visible = false
    end if
    if series
        m.rateBg.translation = [80, 620]
        m.watchedBg.translation = [380, 620]
    else
        m.rateBg.translation = [380, 620]
        m.watchedBg.translation = [680, 620]
    end if
end sub

sub onSeasons()
    seasons = m.top.seasons
    content = CreateObject("roSGNode", "ContentNode")
    row = content.createChild("ContentNode")
    if seasons <> invalid
        for each season in seasons
            node = row.createChild("ContentNode")
            number = 0
            if season.season_number <> invalid
                number = season.season_number as integer
            end if
            node.title = "Season " + number.toStr()
            node.addFields({ seasonNumber: number })
        end for
    end if
    m.seasonList.content = content
end sub

sub onEpisodes()
    episodes = m.top.episodes
    content = CreateObject("roSGNode", "ContentNode")
    row = content.createChild("ContentNode")
    if episodes <> invalid
        for each episode in episodes
            node = row.createChild("ContentNode")
            fallbackSeason = invalid
            if m.top.episodeSeason >= 0
                fallbackSeason = m.top.episodeSeason
            end if
            title = Prairie.Catalog.episodeCardTitle(episode, fallbackSeason)
            node.title = title
            node.description = Prairie.Catalog.episodeCardMeta(episode)
            contentId = ""
            if episode.content_id <> invalid
                contentId = episode.content_id as string
            end if
            node.addFields({ contentId: contentId, titleText: title })
        end for
    end if
    m.episodeList.content = content
end sub

' More Like This: shown under the actions on titles without a season list.
sub onSimilar()
    items = m.top.similar
    content = CreateObject("roSGNode", "ContentNode")
    row = content.createChild("ContentNode")
    if items <> invalid
        for each entry in items
            contentId = ""
            if entry.content_id <> invalid
                contentId = entry.content_id as string
            end if
            if contentId.len() > 0
                node = row.createChild("ContentNode")
                title = "Title"
                if entry.title <> invalid
                    title = entry.title as string
                end if
                node.title = title
                if entry.poster_url <> invalid
                    node.hdPosterUrl = Prairie.Artwork.preferred(entry.poster_url as string, 200)
                end if
                node.addFields({ contentId: contentId, isExploreAll: false })
            end if
        end for
    end if
    m.similarList.content = content
    shown = row.getChildCount() > 0 and not m.seasonList.visible
    m.similarTitle.visible = shown
    m.similarList.visible = shown
    layoutTrailers()
end sub

sub onSimilarSelected()
    selection = m.similarList.rowItemSelected
    if selection = invalid or selection.count() < 2
        return
    end if
    row = m.similarList.content.getChild(selection[0])
    if row = invalid
        return
    end if
    item = row.getChild(selection[1])
    if item = invalid or item.contentId = invalid
        return
    end if
    m.top.similarSelected = item.contentId
end sub

sub focusDefault()
    if m.playBg.visible
        m.playBg.setFocus(true)
    else if m.seasonList.visible
        m.seasonList.setFocus(true)
    else
        m.rateBg.setFocus(true)
    end if
end sub

sub requestPlay(contentId as string, title as string)
    if m.top.busy or contentId.len() = 0
        return
    end if
    m.top.playRequested = {
        contentId: contentId,
        title: title
    }
end sub

sub onSeasonSelected()
    selection = m.seasonList.rowItemSelected
    if selection = invalid or selection.count() < 2
        return
    end if
    row = m.seasonList.content.getChild(selection[0])
    if row = invalid
        return
    end if
    item = row.getChild(selection[1])
    if item = invalid
        return
    end if
    m.top.seasonSelected = item.seasonNumber
    m.episodeList.setFocus(true)
end sub

sub onEpisodeSelected()
    selection = m.episodeList.rowItemSelected
    if selection = invalid or selection.count() < 2
        return
    end if
    row = m.episodeList.content.getChild(selection[0])
    if row = invalid
        return
    end if
    item = row.getChild(selection[1])
    if item = invalid or item.contentId = invalid
        return
    end if
    requestPlay(item.contentId as string, item.titleText as string)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press
        return false
    end if
    if key = "back"
        m.top.backRequested = true
        return true
    end if
    if key = "OK" and m.rateBg.hasFocus()
        m.top.rateRequested = true
        return true
    end if
    if key = "OK" and m.watchedBg.hasFocus()
        m.top.watchedRequested = true
        return true
    end if
    if key = "OK" and m.boxSetBg.visible and m.boxSetBg.hasFocus()
        m.top.boxSetRequested = true
        return true
    end if
    if key = "right" and m.boxSetBg.visible and m.watchedBg.hasFocus()
        m.boxSetBg.setFocus(true)
        return true
    end if
    if key = "left" and m.boxSetBg.hasFocus()
        m.watchedBg.setFocus(true)
        return true
    end if
    if key = "up" and m.trailerList.hasFocus()
        if m.similarList.visible
            leaveTrailers(m.similarList)
        else if m.episodeList.visible
            leaveTrailers(m.episodeList)
        else
            leaveTrailers(actionAnchor())
        end if
        return true
    end if
    if key = "down" and m.trailerList.visible
        fromRail = m.similarList.hasFocus() or m.episodeList.hasFocus()
        fromActions = actionHasFocus() and not m.seasonList.visible and not m.similarList.visible
        if fromRail or fromActions
            focusTrailers()
            return true
        end if
    end if
    if key = "right" and m.rateBg.hasFocus()
        m.watchedBg.setFocus(true)
        return true
    end if
    if key = "left" and m.watchedBg.hasFocus()
        m.rateBg.setFocus(true)
        return true
    end if
    if key = "right" and m.playBg.visible and m.playBg.hasFocus()
        m.rateBg.setFocus(true)
        return true
    end if
    if key = "left" and m.playBg.visible and m.rateBg.hasFocus()
        m.playBg.setFocus(true)
        return true
    end if
    if key = "down" and m.seasonList.visible and actionHasFocus()
        m.seasonList.setFocus(true)
        return true
    end if
    if key = "down" and m.seasonList.hasFocus() and m.episodeList.visible
        m.episodeList.setFocus(true)
        return true
    end if
    if key = "up" and m.episodeList.hasFocus()
        m.seasonList.setFocus(true)
        return true
    end if
    if key = "up" and m.seasonList.visible and m.seasonList.hasFocus()
        m.rateBg.setFocus(true)
        return true
    end if
    if key = "down" and m.similarList.visible and actionHasFocus()
        m.similarList.setFocus(true)
        return true
    end if
    if key = "up" and m.similarList.visible and m.similarList.hasFocus()
        if m.playBg.visible
            m.playBg.setFocus(true)
        else
            m.rateBg.setFocus(true)
        end if
        return true
    end if
    if (key = "OK" or key = "play") and m.playBg.visible and m.playBg.isInFocusChain()
        detail = m.top.detail
        contentId = ""
        title = "Title"
        if detail <> invalid
            if detail.content_id <> invalid
                contentId = detail.content_id as string
            end if
            if detail.title <> invalid
                title = detail.title as string
            end if
        end if
        requestPlay(contentId, title)
        return true
    end if
    return false
end function
