<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="forceDirectPlay" type="bool" value="false" />
        <field id="forceTranscode" type="bool" value="false" />
        <field id="preferredSubtitleLanguage" type="string" value="" />
        <field id="appVersion" type="string" value="" />
        <field id="updateLabel" type="string" value="Checking…" />
        <field id="latestVersionLabel" type="string" value="" />
        <field id="changelogUrl" type="string" value="" />
        <field id="saveRequested" type="assocarray" />
        <field id="switchServerRequested" type="boolean" value="false" alwaysNotify="true" />
        <field id="backRequested" type="boolean" value="false" alwaysNotify="true" />
        <function name="focusDefault" />
    </interface>
    <script type="text/brightscript" uri="SettingsScreen.bs" />
    <children>
        <Rectangle id="backdrop" width="1920" height="1080" color="0x141820FF" />
        <Label
            id="eyebrow"
            text="PREFERENCES"
            translation="[80, 40]"
            color="0xE0A84AFF"
            font="font:SmallBoldSystemFont"
        />
        <Label
            id="title"
            text="Playback settings"
            translation="[80, 80]"
            color="0xF3EFE6FF"
            font="font:LargeBoldSystemFont"
        />
        <Label
            id="lede"
            text="Stored in the Roku registry across channel updates."
            translation="[80, 150]"
            width="1200"
            color="0x9AA3B2FF"
            font="font:MediumSystemFont"
        />

        <Label id="methodLabel" text="Play method" translation="[80, 230]" color="0xE0A84AFF" font="font:SmallBoldSystemFont" />
        <Rectangle id="autoBg" translation="[80, 270]" width="220" height="64" color="0x222B38FF" focusable="true">
            <Label id="autoLabel" text="Auto" width="220" height="64" horizAlign="center" vertAlign="center" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        </Rectangle>
        <Rectangle id="directBg" translation="[320, 270]" width="280" height="64" color="0x222B38FF" focusable="true">
            <Label id="directLabel" text="Force direct" width="280" height="64" horizAlign="center" vertAlign="center" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        </Rectangle>
        <Rectangle id="transcodeBg" translation="[620, 270]" width="320" height="64" color="0x222B38FF" focusable="true">
            <Label id="transcodeLabel" text="Force transcode" width="320" height="64" horizAlign="center" vertAlign="center" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        </Rectangle>

        <Label id="subLabel" text="Preferred subtitle language (ISO code, blank = off)" translation="[80, 370]" color="0xE0A84AFF" font="font:SmallBoldSystemFont" />
        <TextEditBox
            id="subtitleInput"
            translation="[80, 410]"
            width="400"
            hintText="eng"
            maxTextLength="12"
            showKeyboardOnFocus="true"
        />

        <Rectangle id="saveBg" translation="[80, 500]" width="220" height="64" color="0xE0A84AFF" focusable="true">
            <Label id="saveLabel" text="Save" width="220" height="64" horizAlign="center" vertAlign="center" color="0x141820FF" font="font:MediumBoldSystemFont" />
        </Rectangle>
        <Rectangle id="serversBg" translation="[320, 500]" width="280" height="64" color="0x222B38FF" focusable="true">
            <Label id="serversLabel" text="Servers" width="280" height="64" horizAlign="center" vertAlign="center" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        </Rectangle>
        <Label id="savedLabel" text="" translation="[620, 515]" color="0x9AA3B2FF" font="font:SmallSystemFont" />

        <Label id="aboutLabel" text="About" translation="[80, 610]" color="0xE0A84AFF" font="font:SmallBoldSystemFont" />
        <Label id="versionKey" text="Version" translation="[80, 660]" color="0x9AA3B2FF" font="font:MediumSystemFont" />
        <Label id="versionValue" text="" translation="[360, 660]" width="900" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        <Label id="updateKey" text="Update status" translation="[80, 710]" color="0x9AA3B2FF" font="font:MediumSystemFont" />
        <Label id="updateValue" text="Checking…" translation="[360, 710]" width="900" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        <Label id="latestKey" text="Latest version" translation="[80, 760]" color="0x9AA3B2FF" font="font:MediumSystemFont" />
        <Label id="latestValue" text="—" translation="[360, 760]" width="900" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        <Rectangle id="changelogBg" translation="[80, 820]" width="280" height="64" color="0x222B38FF" focusable="true">
            <Label id="changelogLabel" text="Changelog" width="280" height="64" horizAlign="center" vertAlign="center" color="0xF3EFE6FF" font="font:MediumSystemFont" />
        </Rectangle>
        <Label id="changelogHint" text="" translation="[380, 835]" width="1400" color="0x9AA3B2FF" font="font:SmallSystemFont" />
    </children>
</component>
