import "pkg:/source/lib/Theme.bs"

sub init()
    m.colors = Prairie.Theme.colors()
    m.row = m.top.findNode("row")
    m.pills = []
    m.index = 0
    m.top.focusable = true
    m.top.observeField("focusedChild", "onPaint")
end sub

sub onEntries()
    while m.row.getChildCount() > 0
        m.row.removeChildIndex(0)
    end while
    m.pills = []
    entries = m.top.entries
    if entries = invalid
        return
    end if
    for each entry in entries
        pill = m.row.createChild("Group")
        bg = pill.createChild("Rectangle")
        bg.height = 56
        label = pill.createChild("Label")
        label.font = "font:MediumSystemFont"
        label.text = entry.label
        label.height = 56
        label.vertAlign = "center"
        label.horizAlign = "center"
        labelWidth = label.boundingRect().width + 48
        label.width = labelWidth
        bg.width = labelWidth
        m.pills.push({ id: entry.id, bg: bg, label: label })
    end for
    if m.index >= m.pills.count()
        m.index = 0
    end if
    onPaint()
end sub

function indexOfId(entryId as string) as integer
    for i = 0 to m.pills.count() - 1
        if m.pills[i].id = entryId
            return i
        end if
    end for
    return -1
end function

sub focusSelected()
    selected = indexOfId(m.top.selectedId)
    if selected >= 0
        m.index = selected
    end if
    m.top.setFocus(true)
    onPaint()
end sub

sub onPaint()
    focused = m.top.hasFocus()
    for i = 0 to m.pills.count() - 1
        item = m.pills[i]
        if focused and i = m.index
            item.bg.color = m.colors.ink
            item.bg.opacity = 1
            item.label.color = m.colors.bg
        else
            item.bg.color = m.colors.bgSoft
            item.bg.opacity = 0
            if item.id = m.top.selectedId
                item.label.color = m.colors.amber
            else
                item.label.color = m.colors.muted
            end if
        end if
    end for
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.pills.count() = 0
        return false
    end if
    if key = "left"
        if m.index > 0
            m.index = m.index - 1
            onPaint()
        end if
        return true
    else if key = "right"
        if m.index < m.pills.count() - 1
            m.index = m.index + 1
            onPaint()
        end if
        return true
    else if key = "OK"
        m.top.activatedId = m.pills[m.index].id
        return true
    end if
    return false
end function
